<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>PerformanceMonitor.Common</RootNamespace>
    <AssemblyName>PerformanceMonitor.Common</AssemblyName>
    <Company>Darling Data, LLC</Company>
    <Copyright>Copyright © 2026 Darling Data, LLC</Copyright>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- NU1701: CredentialManagement package has no .NET 10 build (matches Dashboard/Lite suppression). -->
    <NoWarn>CA1849;CA2007;CA1508;CA1822;CA1805;CA1510;CA1816;CA1861;CA1845;CA2201;CA1848;CA1852;CA1305;CA1860;CA1707;CA1507;CA1806;CA2254;NU1701</NoWarn>
    <WarningsAsErrors>CS4014</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- MCP SDK: required by Mcp/McpSchemaCompat.cs (Gemini-compatible tool registration, issue #1074).
         Brings ModelContextProtocol.Core + Microsoft.Extensions.AI.Abstractions transitively. -->
    <PackageReference Include="ModelContextProtocol" />
    <!-- Windows Credential Manager (DPAPI) for the shared CredentialStore; version matches Dashboard/Lite. -->
    <PackageReference Include="CredentialManagement" />
    <!-- ILogger abstraction used by CredentialStore; version matches the apps' logging stack. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PerformanceMonitor.PlanAnalysis" />
    <InternalsVisibleTo Include="PerformanceMonitorLite" />
    <InternalsVisibleTo Include="PerformanceMonitorDashboard" />
    <!-- AN3: the ported PgDrillDownCollector renders plan warnings through McpHelpers.Truncate,
         exactly like both apps' drill-down collectors. -->
    <InternalsVisibleTo Include="PerformanceMonitor.Darling.Analysis" />
    <!-- AN4: the Darling service's analysis MCP tools use McpHelpers (Status envelope,
         ValidateHoursBack, JsonOptions, FormatError) exactly like both apps' tools. -->
    <InternalsVisibleTo Include="PerformanceMonitor.Darling.Service" />
    <InternalsVisibleTo Include="Lite.Tests" />
    <InternalsVisibleTo Include="Dashboard.Tests" />
    <!-- #2417: Darling.Tests serializes the MCP alert payload through McpHelpers.JsonOptions rather
         than a look-alike, so a naming policy added there can never leave the round-trip invariant
         asserting keys no client ever receives. The two sibling test projects were already here. -->
    <InternalsVisibleTo Include="Darling.Tests" />
  </ItemGroup>
</Project>
