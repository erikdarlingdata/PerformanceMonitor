<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PerformanceMonitor.PlanAnalysis</RootNamespace>
    <AssemblyName>PerformanceMonitor.PlanAnalysis</AssemblyName>
    <Company>Darling Data, LLC</Company>
    <Copyright>Copyright © 2026 Darling Data, LLC</Copyright>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PerformanceMonitor.Common\PerformanceMonitor.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ActualPlanExecutor RE-EXECUTES a query against the target to capture its ACTUAL plan (SET STATISTICS
         XML), so it needs the SqlClient runtime connection surface. Its version is the central one in
         Directory.Packages.props, shared with Lite/Dashboard/the Darling service, so there is no transitive version skew. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- #5802: lifts the transitive System.Security.Cryptography.Pkcs off SqlClient's vulnerable 9.0.18; see Directory.Packages.props. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PerformanceMonitorLite" />
    <InternalsVisibleTo Include="PerformanceMonitorDashboard" />
    <InternalsVisibleTo Include="Lite.Tests" />
    <InternalsVisibleTo Include="Dashboard.Tests" />
    <!-- The Darling service/viewer call the SHARED ActualPlanExecutor + QueryModificationDetector; Darling.Tests
         also pins the executor's internal plan-capture seam (IActualPlanResultReader) with a scripted reader. -->
    <InternalsVisibleTo Include="Darling.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Curated wait-type descriptions read by WaitStatsConfig at runtime (BenefitScorer's
         "Wait: type" findings). Ships with the assembly so Darling, Lite, and the viewer all
         read the same copy through their shared ProjectReference, so there is no per-app copy. -->
    <EmbeddedResource Include="Resources\WaitStats.json" />
  </ItemGroup>
</Project>
