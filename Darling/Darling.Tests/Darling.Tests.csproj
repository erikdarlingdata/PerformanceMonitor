<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net10.0-windows + UseWPF so the tests can reference the WPF Viewer project (the Lite.Tests pattern). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- #2347: xunit.v3 under Microsoft.Testing.Platform builds the suite as its own executable. -->
    <OutputType>Exe</OutputType>
    <!-- xUnit1051 (use TestContext.Current.CancellationToken): a per-call-site style nag across
         hundreds of short-lived test calls; suppressed like CS4014 rather than threading the
         ambient token through every call. -->
    <!-- NU1701: CredentialManagement and SkiaSharp.Views.WPF (reached through the app projects) have no .NET 10 build. -->
    <NoWarn>$(NoWarn);CS4014;NU1701;xUnit1051</NoWarn>
    <!-- #7065: a warning fails this project's build, so a new one cannot sit unnoticed. The suppressions above are the
         only rules held back. The NuGet audit codes (NU1901 to NU1904) stay warnings: an advisory published against a
         package we already use would otherwise turn every build red on a day nothing in the repo changed. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- #5596: WPF builds one WeakEventTable per STA thread that touches a WeakEventManager, and each table
         registers a ProcessExit handler. At exit that handler runs on the main thread, and when the table's
         own thread is gone it asks the dead dispatcher to purge the table with a 300 ms timeout nobody ever
         answers: about 0.3 seconds per STA test thread, spent after the run has returned. About fifty test files
         start their own STA thread, so the exit stage grew past the 11 seconds xUnit v3 gives a process after the
         run returns, and the runner printed "Foreground threads were left running" with exit code 1 and 0 failed
         tests. This WPF switch (WindowsBase, BaseAppContextSwitches) makes the handler purge the table directly.
         WpfExitSwitchTests pins that the switch is set, and that the runtime still knows its name. -->
    <RuntimeHostConfigurationOption Include="Switch.MS.Internal.DoNotInvokeInWeakEventTableShutdownListener" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- #5943: Thread.Sleep is banned in test code (RS0030, an error in .editorconfig). A test that waits for something
         uses TestWait.WaitUntil (Darling.Tests/TestTimeHelpers.cs); the file holds the one-line reason and the way out. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
    <!-- #4128: a live HTTP proof of the web host's gates (Host-allowlist, network-mode token/CIDR) through
         a real Kestrel TestServer pipeline, rather than the source-order pins above. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PerformanceMonitor.Darling.Analysis\PerformanceMonitor.Darling.Analysis.csproj" />
    <ProjectReference Include="..\PerformanceMonitor.Darling.Service\PerformanceMonitor.Darling.Service.csproj" />
    <!-- #5632 step 6: the server write code; only the tests reference it (the service does not). -->
    <ProjectReference Include="..\PerformanceMonitor.Darling.Remediation\PerformanceMonitor.Darling.Remediation.csproj" />
    <ProjectReference Include="..\PerformanceMonitor.Darling.Storage\PerformanceMonitor.Darling.Storage.csproj" />
    <ProjectReference Include="..\PerformanceMonitor.Darling.Viewer\PerformanceMonitor.Darling.Viewer.csproj" />
    <!-- SystemHealthParser (the code under test) lives in Common; reference it explicitly rather than
         leaning on the transitive Viewer/Service edge. -->
    <ProjectReference Include="..\..\PerformanceMonitor.Common\PerformanceMonitor.Common.csproj" />
    <!-- #3938: the shared analysis engine, referenced explicitly by the same convention as Common above.
         Dozens of classes here test PerformanceMonitor.Analysis types directly; the edge used to arrive
         only transitively through Darling.Analysis, so dropping that reference would have broken them
         for a reason nothing in this file named. -->
    <ProjectReference Include="..\..\PerformanceMonitor.Analysis\PerformanceMonitor.Analysis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- #3938: the cross-SKU source-scan pins of the get_collection_health parity families, compiled here
         from Lite.Tests rather than copied. Every fact in that file reads both SKUs source text and needs
         nothing from WPF, but Lite.Tests cannot build or run on a Mac, so while they lived only there a
         Darling-side change that broke one went red for the first time in CI. One file, one authority,
         no parity pin needed - the mirror image of the CSharpSourceWalker link in Lite.Tests.csproj. It
         brings its Lite.Tests namespace with it and uses only the BCL, xunit and PerformanceMonitor.Alerting,
         which both projects carry. -->
    <Compile Include="..\..\Lite.Tests\CrossSkuSurfaceSourceTests.cs" Link="Linked\CrossSkuSurfaceSourceTests.cs" />
    <!-- #5644 W6: the default trace EventSequence watermark. The collector is one shared definition, so its
         behaviour model (a simulated trace driven through the real BuildQuery and ReadAsync) is compiled here
         from Lite.Tests rather than copied; it uses only the BCL, System.Data, xunit and PerformanceMonitor.Collectors. -->
    <Compile Include="..\..\Lite.Tests\DefaultTraceEventSequenceWatermarkTests.cs" Link="Linked\DefaultTraceEventSequenceWatermarkTests.cs" />
    <!-- #5641: the severity legend of both Settings windows, pinned to AlertSeverity.ForMetric. -->
    <Compile Include="..\..\Lite.Tests\AlertLegendParityTests.cs" Link="Linked\AlertLegendParityTests.cs" />
    <!-- #5750: the scoped-route parity fixture (one fleet, one expected-result table). Lite.Tests asserts it against DuckDB and
         NotificationRouteScopeParityLiveTests against PostgreSQL; neither project can open both stores, so they share the table.
         BCL only. -->
    <Compile Include="..\..\Lite.Tests\NotificationRouteParityFixture.cs" Link="Linked\NotificationRouteParityFixture.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- system_health event samples for SystemHealthParser (one per feeder event; shapes per sp_HealthParser xpath). -->
    <None Include="Fixtures\FinOpsIndexAnalysis\golden.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The shared time range grammar cases (#5562); the web harness reads the same file. -->
    <None Include="Fixtures\time-range-cases.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\SystemHealth\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- real, scrubbed system_health event captures for SystemHealthParserRealEventTests -->
    <None Include="Fixtures\SystemHealth\real\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Deadlock graph parser/layout golden samples (real sql2025 captures + synthetic edge cases). -->
    <None Include="Fixtures\Deadlocks\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Statement-filter XML walk fixtures (#4348): plan XML carrying canary values. -->
    <None Include="Fixtures\StatementScrub\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\FinOpsInventory\golden.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\FinOpsRecommendations\golden.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\FinOpsApplicationConnections\golden.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\FinOpsOptimization\golden.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\FinOpsStorageGrowth\golden.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\column-value-filter-cases.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- #4534: PerformanceStudio's own .sqlplan fixtures for the warning-origin decider, copied from its
         public repo (table_variable_plan, convert_implicit_plan, udf_plan). Real captures rather than a
         synthetic plan, so the "every operator warning knows its operator" pin runs against the same
         shapes PerformanceStudio's own test relies on. -->
    <None Include="Fixtures\OriginPlans\*.sqlplan" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\FinOpsDatabaseResources\golden.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- #2538: a REAL auto_explain block, captured from a PostgreSQL container with auto_explain
         loaded. Real rather than hand-written because the parser's whole job is the log's exact
         shape - the tab-indented continuation, the %Q query id in the prefix, the JSON body - and a
         fixture I typed would agree with whatever I believed that shape was. 
         Named .txt rather than .log because *.log is gitignored - correctly, and a fixture is not a log. -->
    <None Include="Fixtures\FinOpsUtilization\golden.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\auto_explain_real_block.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The SHIPPED bring-your-own-Postgres provisioning script, copied beside the test binary so
         ProvisionRolesAclDriftTests can parse the REAL file (never a stale second copy) from
         AppContext.BaseDirectory, with no repo-root path walking. Same Link+copy delivery the Service
         project uses for tools\install-darling.ps1. -->
    <None Include="..\tools\provision-roles.sql" Link="Fixtures\provision-roles.sql" CopyToOutputDirectory="PreserveNewest" />
    <!-- The two Darling Kestrel hosts' sources, copied beside the test binary (same Link+copy delivery as the
         provisioning script above — the files live outside this project directory, so the default Compile glob
         never sees them). HostHeaderGuardTests parses them to pin that the #1648 DNS-rebinding middleware is
         installed FIRST and in BOTH bind modes: the defect was a WIRING omission, not a logic bug, so the pure
         decision test alone would have passed on the broken build. -->
    <!-- #1706: the store-upgrade orchestration is parsed as SOURCE to pin two WIRING invariants that no
         behavioral test can reach — the post-commit catch must stay ahead of the general one, and the port
         preflight must actually be called. Both defects are invisible to logic tests and to the happy-path
         E2E, exactly like the #1648 middleware-ordering case these fixtures already exist for. -->
    <None Include="..\PerformanceMonitor.Darling.Service\DarlingStoreUpgrade.cs" Link="Fixtures\DarlingStoreUpgrade.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PerformanceMonitor.Darling.Service\Mcp\DarlingMcpHostService.cs" Link="Fixtures\DarlingMcpHostService.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PerformanceMonitor.Darling.Service\Mcp\DarlingWebHostService.cs" Link="Fixtures\DarlingWebHostService.cs" CopyToOutputDirectory="PreserveNewest" />
    <!-- The runtime fetch script, copied beside the test binary so DarlingPgRuntimeVersionPinTests reads
         the REAL pins (#1706) rather than a second copy that could itself go stale — the exact failure
         mode the test exists to catch. Same Link+copy delivery as the provisioning script above. -->
    <None Include="..\tools\fetch-pg-runtime.ps1" Link="Fixtures\fetch-pg-runtime.ps1" CopyToOutputDirectory="PreserveNewest" />
    <!-- #1888: the two workflows that stand up the gated-live throwaway cluster, copied beside the test
         binary so CiClusterWorkerSizingTests parses the REAL files. The cluster's worker sizing has to be
         hard-coded in YAML (a workflow cannot call into the product), and hard-coded numbers derived from
         the collector catalog go stale the moment a collector is added — which already happened once to a
         "40" pin in DarlingManagedPostgresTests. Parsing the workflow against the live formula is the only
         thing that keeps CI's cluster shaped like the product's as the catalog grows. -->
    <None Include="..\..\.github\workflows\build.yml" Link="Fixtures\build.yml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\.github\workflows\nightly.yml" Link="Fixtures\nightly.yml" CopyToOutputDirectory="PreserveNewest" />
    <!-- #5701: the UI-smoke workflow stands up a third copy of the same cluster (the same worker numbers), so it is
         copied beside the test binary and parsed by the same formula check. -->
    <None Include="..\..\.github\workflows\darling-ui-smoke.yml" Link="Fixtures\darling-ui-smoke.yml" CopyToOutputDirectory="PreserveNewest" />
    <!-- #5745: the WPF smoke workflow starts the same cluster for the viewer walk, so it is parsed too. -->
    <None Include="..\..\.github\workflows\wpf-smoke.yml" Link="Fixtures\wpf-smoke.yml" CopyToOutputDirectory="PreserveNewest" />
    <!-- #5616: the shard scripts both workflows call. The cut, the chunking and the per-chunk runs moved out of the
         workflow steps into them, so the pins that read those steps (CiShardCommandLineBudgetTests,
         CiShardHangReportTests) read these copies. -->
    <None Include="..\..\.github\scripts\run-darling-pg-shard.ps1" Link="Fixtures\run-darling-pg-shard.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\.github\scripts\run-lite-shard.ps1" Link="Fixtures\run-lite-shard.ps1" CopyToOutputDirectory="PreserveNewest" />
    <!-- #4322: the Linux compose file, copied beside the test binary so CiComposeWorkerSizingTests parses
         the REAL file rather than a copy that can go stale. Its worker-sizing flags are a restatement of
         TimescaleSupport.HypertableCount via the same formula BuildWorkerSizingConfAppend writes for the
         managed Windows store, and compose's command: line cannot call into the product. -->
    <None Include="..\compose\docker-compose.yml" Link="Fixtures\docker-compose.yml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\compose\darling.sample.json" Link="Fixtures\compose.darling.sample.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- #6140: the one-step compose setup script, run by ComposeSetupScriptTests in a temp folder. -->
    <None Include="..\compose\setup.sh" Link="Fixtures\compose.setup.sh" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
