<Project Sdk="Microsoft.NET.Sdk">
  <!-- #5632, steps 6 and 7: the write code for agent actions on a monitored SQL Server, in its own assembly. The service
       references this project (step 7) for ONE class, DarlingMcpPlanForceTools, which calls it for force_query_store_plan and
       unforce_query_store_plan. PlanForceNoWritePathTests pins that no other service type touches it and that the service
       assembly holds none of the write statements, which stay here. Darling.Tests references it too. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>PerformanceMonitor.Darling.Remediation</RootNamespace>
    <AssemblyName>PerformanceMonitor.Darling.Remediation</AssemblyName>
    <Company>Darling Data, LLC</Company>
    <Copyright>Copyright © 2026 Darling Data, LLC</Copyright>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <WarningsAsErrors>CS4014</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- #5632: the PostgreSQL kill (pg_terminate_backend) signs in to a monitored PostgreSQL server with the remediation login. -->
    <PackageReference Include="Npgsql" />
    <!-- #5802: lifts the transitive System.Security.Cryptography.Pkcs off SqlClient's vulnerable 9.0.18; see Directory.Packages.props. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <!-- Storage: ServerActionPermit, the one value the server-action gate hands out when every check passes. -->
    <ProjectReference Include="..\PerformanceMonitor.Darling.Storage\PerformanceMonitor.Darling.Storage.csproj" />
    <ProjectReference Include="..\..\PerformanceMonitor.Common\PerformanceMonitor.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Darling.Tests" />
  </ItemGroup>
</Project>
