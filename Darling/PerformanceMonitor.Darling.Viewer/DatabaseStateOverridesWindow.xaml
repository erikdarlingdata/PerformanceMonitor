<Window x:Class="PerformanceMonitor.Darling.Viewer.DatabaseStateOverridesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Database State Overrides"
        Height="560" Width="720"
        WindowStartupLocation="CenterOwner"
        Icon="/EDD.ico"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontWeight="Bold" FontSize="14"
                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,8"
                   Text="Database State Alert — Expected State per Database"/>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,12"
                   Text="Each database's expected state is captured automatically the first time it is seen. The alert fires when the current state differs from the expected state. Change a database's expected state to stop false alarms (e.g. a log-shipping secondary is expected to be RESTORING), or set it to (ignore) to never alert on it."/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Server:" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource ForegroundBrush}"/>
            <ComboBox x:Name="ServerCombo" Width="320" VerticalAlignment="Center"
                      DisplayMemberPath="DisplayName" SelectionChanged="ServerCombo_SelectionChanged"/>
            <Button x:Name="RefreshButton" Content="Refresh" Margin="10,0,0,0" Padding="10,3" Click="RefreshButton_Click"/>
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <DataGrid x:Name="StatesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="Transparent" BorderThickness="0"
                      Foreground="{DynamicResource ForegroundBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" IsReadOnly="True" Width="2*"/>
                    <DataGridTextColumn Header="Current State" Binding="{Binding CurrentState}" IsReadOnly="True" Width="1.4*"/>
                    <DataGridComboBoxColumn x:Name="ExpectedColumn" Header="Expected State"
                                            SelectedItemBinding="{Binding ExpectedState}" Width="1.6*"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding SourceLabel}" IsReadOnly="True" Width="1*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="4" x:Name="StatusText" FontSize="10" FontStyle="Italic" TextWrapping="Wrap"
                   Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Reset Selected to Current" Height="28" Padding="10,0" Margin="0,0,8,0"
                    Click="ResetSelected_Click"/>
            <Button Content="Save" Width="80" Height="28" Margin="0,0,8,0" Click="Save_Click" Style="{StaticResource AccentButton}"/>
            <Button Content="Close" Width="80" Height="28" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
