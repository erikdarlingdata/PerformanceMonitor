<UserControl x:Class="PerformanceMonitor.Darling.Viewer.IdentityCapacityTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="900">
    <!-- #6875: one server's identity columns and how long until each runs out, the Viewer twin of the web's Identity Capacity panels.
         The read, the band and the words are shared with get_identity_capacity through ViewerDataService.ReadIdentityCapacityAsync,
         DarlingIdentityCapacityReader, IdentityCapacityMath and ViewerIdentityCapacityText, so both surfaces say the same figures. Read only. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="10,8" MinHeight="36">
            <TextBlock Text="Identity Capacity" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" FontSize="14"
                       Foreground="{DynamicResource ForegroundBrush}"/>
            <TextBlock Text="Server:" VerticalAlignment="Center" Margin="12,0,4,0"
                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
            <ComboBox x:Name="ServerComboBox" Width="200" VerticalAlignment="Center"
                      SelectionChanged="ServerComboBox_SelectionChanged"/>
            <Button Content="Refresh" Click="RefreshButton_Click" Margin="12,0,0,0" Padding="10,4" MinWidth="70"/>
            <TextBlock x:Name="LastRefreshedIndicator" Text="" Margin="12,0,0,0" VerticalAlignment="Center"
                       FontSize="11" Foreground="{DynamicResource ForegroundMutedBrush}"/>
        </WrapPanel>

        <TextBlock Grid.Row="1" x:Name="StatusLine" Margin="10,0,10,6" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{DynamicResource ForegroundBrush}"/>

        <Grid Grid.Row="2" Margin="10,0,10,6">
            <DataGrid x:Name="ColumnsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" ColumnHeaderHeight="30" SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="130"/>
                    <DataGridTextColumn Header="Table" Binding="{Binding Table}" Width="200"/>
                    <DataGridTextColumn Header="Column" Binding="{Binding Column}" Width="150"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
                    <DataGridTextColumn Header="Percent used" Binding="{Binding PercentUsed}" Width="90"/>
                    <DataGridTextColumn Header="Values remaining" Binding="{Binding ValuesRemaining}" Width="200"/>
                    <DataGridTextColumn Header="Rate per day" Binding="{Binding RatePerDay}" Width="100"/>
                    <DataGridTextColumn Header="Days to exhaustion" Binding="{Binding DaysToExhaustion}" Width="120"/>
                    <DataGridTextColumn Header="Band" Binding="{Binding Band}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="ColumnsEmptyMessage" Visibility="Collapsed" TextWrapping="Wrap" Margin="4,36,4,6"
                       VerticalAlignment="Top" Foreground="{DynamicResource ForegroundMutedBrush}"/>
        </Grid>

        <Grid Grid.Row="3" Margin="10,0,10,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Scan State" Margin="0,4,0,2" FontWeight="Bold"
                       Foreground="{DynamicResource ForegroundBrush}"/>
            <DataGrid Grid.Row="1" x:Name="ScanDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" ColumnHeaderHeight="30" MaxHeight="180">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="200"/>
                    <DataGridTextColumn Header="Scan state" Binding="{Binding State}" Width="280"/>
                    <DataGridTextColumn Header="Last scanned" Binding="{Binding LastScanned}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="1" x:Name="ScanEmptyMessage" Visibility="Collapsed" TextWrapping="Wrap" Margin="4,36,4,6"
                       VerticalAlignment="Top" Foreground="{DynamicResource ForegroundMutedBrush}"/>
        </Grid>
    </Grid>
</UserControl>
