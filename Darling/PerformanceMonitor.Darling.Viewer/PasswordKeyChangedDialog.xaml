<Window x:Class="PerformanceMonitor.Darling.Viewer.PasswordKeyChangedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password key changed"
        SizeToContent="Height" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundDarkBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{DynamicResource ForegroundBrush}"
                   Text="This store's password key is not the one this viewer saved for it. Passwords cannot be saved until you trust the new key."/>

        <TextBlock x:Name="SavedLabel" Grid.Row="1" Margin="0,0,0,6" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}"/>
        <TextBlock x:Name="NewLabel" Grid.Row="2" Margin="0,0,0,10" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}"/>

        <CheckBox x:Name="CheckedBox" Grid.Row="3" Margin="0,0,0,0"
                  Foreground="{DynamicResource ForegroundBrush}"
                  Checked="CheckedBox_Changed" Unchecked="CheckedBox_Changed">
            <TextBlock TextWrapping="Wrap"
                       Text="I checked that the new key matches the 'Password key' line in the service log"/>
        </CheckBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="TrustButton" Content="_Trust the new key" Width="130" Margin="0,0,8,0"
                    IsEnabled="False" Click="Trust_Click"/>
            <Button Content="_Cancel" Width="76" IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
