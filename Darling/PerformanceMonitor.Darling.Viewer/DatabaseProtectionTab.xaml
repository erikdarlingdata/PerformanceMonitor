<UserControl x:Class="PerformanceMonitor.Darling.Viewer.DatabaseProtectionTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="900">
    <!-- #6873: one server's last full backup, log backup and CHECKDB per database, the Viewer twin of the web's Health Checks panels.
         The read, the banding and the words are shared with get_database_protection through ViewerDataService.ReadDatabaseProtectionAsync
         and ViewerDatabaseProtectionText, so both surfaces show the same sentences. Read only. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="10,8" MinHeight="36">
            <TextBlock Text="Database Protection" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" FontSize="14"
                       Foreground="{DynamicResource ForegroundBrush}"/>
            <TextBlock Text="Server:" VerticalAlignment="Center" Margin="12,0,4,0"
                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
            <ComboBox x:Name="ServerComboBox" Width="200" VerticalAlignment="Center"
                      SelectionChanged="ServerComboBox_SelectionChanged"/>
            <Button Content="Refresh" Click="RefreshButton_Click" Margin="12,0,0,0" Padding="10,4" MinWidth="70"/>
            <TextBlock x:Name="LastRefreshedIndicator" Text="" Margin="12,0,0,0" VerticalAlignment="Center"
                       FontSize="11" Foreground="{DynamicResource ForegroundMutedBrush}"/>
        </WrapPanel>

        <TextBlock Grid.Row="1" x:Name="StatusLine" Margin="10,0,10,6" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{DynamicResource ForegroundBrush}"/>

        <Grid Grid.Row="2" Margin="10,0,10,6">
            <DataGrid x:Name="DatabasesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="200"/>
                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90"/>
                    <DataGridTextColumn Header="Last full backup" Binding="{Binding FullBackup}" Width="190"/>
                    <DataGridTextColumn Header="Last log backup" Binding="{Binding LogBackup}" Width="190"/>
                    <DataGridTextColumn Header="Last good CHECKDB" Binding="{Binding CheckDb}" Width="190"/>
                    <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="110"/>
                    <DataGridTextColumn Header="Not judged because" Binding="{Binding NotJudgedBecause}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyMessage" Visibility="Collapsed" TextWrapping="Wrap" Margin="4,6"
                       VerticalAlignment="Top" Foreground="{DynamicResource ForegroundMutedBrush}"/>
        </Grid>
    </Grid>
</UserControl>
