<Window x:Class="PerformanceMonitor.Darling.Viewer.AddMultipleServersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Multiple Servers"
        Height="720" Width="640" MinHeight="540" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="EDD.ico"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Add Multiple Servers" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"
                   Foreground="{DynamicResource ForegroundBrush}"/>

        <!-- Format hint -->
        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"
                   Foreground="{DynamicResource ForegroundMutedBrush}"
                   Text="Paste one server per line as: server[, display name][, database]. A non-default port rides the server name SQL Server style — sql01,2433 — and is told apart from a display name by being a pure number. Fields separate on a comma, or on a tab for spreadsheet pastes (a display name with a comma, or one that is only digits, needs the tab form). Blank lines and lines starting with # are ignored. All servers share the authentication and encryption below — the Darling service connects with Windows or SQL authentication (a SQL credential is entered once and stamped, encrypted, onto every server). Duplicates of servers you already monitor are skipped."/>

        <!-- Paste box -->
        <TextBlock Grid.Row="2" Text="Servers" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4"/>
        <TextBox Grid.Row="3" x:Name="PasteBox" Height="130" Margin="0,0,0,10"
                 AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap"
                 FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextChanged="PasteBox_TextChanged"/>

        <!-- Shared settings block -->
        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="Shared authentication (applied to every server)" FontWeight="Bold"
                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4"/>

            <!-- Credential source: inline (shared) vs a shared credential profile -->
            <RadioButton x:Name="ConfigureCredsRadio" Content="Configure c_redentials for all servers"
                         Foreground="{DynamicResource ForegroundBrush}" IsChecked="True"
                         Checked="CredentialSource_Changed" Margin="0,0,0,4"/>
            <RadioButton x:Name="UseProfileRadio" Content="_Use a credential profile"
                         Foreground="{DynamicResource ForegroundBrush}"
                         Checked="CredentialSource_Changed" Margin="0,0,0,4"
                         ToolTip="Use a named, shared credential (set up under Manage Servers → Credential Profiles). The profile is resolved to a concrete SQL credential and stamped onto every server."/>

            <!-- Profile picker (shown when 'Use a credential profile' is selected) -->
            <StackPanel x:Name="ProfilePickerPanel" Visibility="Collapsed" Margin="0,4,0,0">
                <TextBlock Text="Credential Profile" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="ProfileComboBox" DisplayMemberPath="PickerDisplay"/>
                <TextBlock x:Name="NoProfilesNote" TextWrapping="Wrap" FontSize="11" Visibility="Collapsed"
                           Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,4,0,0"
                           Text="No credential profiles exist yet. Create one under Manage Servers → Credential Profiles."/>
            </StackPanel>

            <!-- Inline shared auth radios. The four modes the Darling service honors (#3484): Windows, SQL, and
                 the two non-interactive Entra modes — service principal and managed identity — entered ONCE and
                 stamped on every row. The interactive Entra modes have no headless connect path, so bulk (like
                 single-add) does not write them. -->
            <StackPanel x:Name="InlineAuthRadios" Margin="0,4,0,0">
                <RadioButton x:Name="WindowsAuthRadio" Content="_Windows Authentication" Foreground="{DynamicResource ForegroundBrush}"
                             IsChecked="True" Checked="AuthMode_Changed" Margin="0,0,0,4"/>
                <RadioButton x:Name="SqlAuthRadio" Content="S_QL Server Authentication" Foreground="{DynamicResource ForegroundBrush}"
                             Checked="AuthMode_Changed" Margin="0,0,0,4"/>
                <RadioButton x:Name="ServicePrincipalAuthRadio" Content="Azure — Service _Principal" Foreground="{DynamicResource ForegroundBrush}"
                             Checked="AuthMode_Changed" Margin="0,0,0,4"/>
                <RadioButton x:Name="ManagedIdentityAuthRadio" Content="Azure — _Managed Identity" Foreground="{DynamicResource ForegroundBrush}"
                             Checked="AuthMode_Changed"/>
            </StackPanel>

            <!-- SQL Auth Credentials (entered ONCE — encrypted to a single DPAPI blob stamped on every row) -->
            <StackPanel x:Name="SqlCredentialsPanel" Visibility="Collapsed" Margin="0,8,0,0">
                <TextBlock Text="Username" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="UsernameBox" Margin="0,0,0,8"/>
                <TextBlock Text="Password" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox"/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,6,0,0"
                           Text="The password is encrypted with the service host's machine key (DPAPI-LocalMachine), so it can be decrypted only on the machine running the Darling service — the supported single-box deploy."/>
            </StackPanel>

            <!-- Service Principal Credentials (one client id + secret stamped on every row — a single Entra app
                 monitoring the whole pasted fleet) -->
            <StackPanel x:Name="ServicePrincipalPanel" Visibility="Collapsed" Margin="0,8,0,0">
                <TextBlock Text="Client (Application) ID" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="AzureClientIdBox" Margin="0,0,0,8"
                         ToolTip="The Application (client) ID of the Entra app registration / service principal."/>
                <TextBlock Text="Client Secret" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="AzureClientSecretBox"/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,6,0,0"
                           Text="The client secret is encrypted with the service host's machine key (DPAPI-LocalMachine), so it can be decrypted only on the machine running the Darling service. The tenant is resolved automatically from each target."/>
            </StackPanel>

            <!-- Managed Identity (one shared identity — no secret) -->
            <StackPanel x:Name="ManagedIdentityPanel" Visibility="Collapsed" Margin="0,8,0,0">
                <TextBlock Text="User-Assigned Identity Client ID (optional)" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="ManagedIdentityClientIdBox" Margin="0,0,0,8"
                         ToolTip="Leave blank to use the system-assigned managed identity. Set to a client id to use a specific user-assigned identity."/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ForegroundMutedBrush}" FontSize="11"
                           Text="Managed Identity only works when the Darling service runs on an Azure VM / resource that has a managed identity assigned. Use Service Principal for non-interactive auth from a workstation."/>
            </StackPanel>

            <!-- Encryption -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Encryption:" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" Width="80"/>
                <ComboBox x:Name="EncryptModeComboBox" Width="150" SelectedIndex="1">
                    <ComboBoxItem Content="Optional"/>
                    <ComboBoxItem Content="Mandatory"/>
                    <ComboBoxItem Content="Strict"/>
                </ComboBox>
            </StackPanel>
            <CheckBox x:Name="TrustCertCheckBox" Content="Trust ser_ver certificate (skip certificate validation)"
                      Foreground="{DynamicResource ForegroundBrush}" IsChecked="False" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Preview / results grid (plain read-only DataGrid — no DataGridFilterManager) -->
        <DataGrid Grid.Row="5" x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" Margin="0,0,0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" Width="50"/>
                <DataGridTextColumn Header="Server" Binding="{Binding Server}" Width="*"/>
                <DataGridTextColumn Header="Display" Binding="{Binding Display}" Width="*"/>
                <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status -->
        <TextBlock Grid.Row="6" x:Name="StatusText" Foreground="{DynamicResource ForegroundMutedBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="TestAllButton" Content="_Test All" Height="30" MinWidth="90" Click="TestAllButton_Click" Margin="0,0,8,0"
                    ToolTip="Ask the Darling service to probe each server with the shared credentials, one at a time. Informational only — no server is added."/>
            <Button x:Name="CancelTestButton" Content="Cancel Te_st" Height="30" MinWidth="90" Click="CancelTestButton_Click"
                    Visibility="Collapsed" Margin="0,0,8,0"/>
            <!-- No IsDefault: this is a multi-field entry form (server list, credential source, auth
                 mode, username/password, encryption), and Enter-to-submit from a half-filled form is a
                 surprise rather than an affordance — #1828's call for Add Server, applied here so the
                 dialog answers Enter the same way its Lite twin does (#1859). -->
            <Button x:Name="AddButton" Content="_Add" Width="90" Height="30" Click="AddButton_Click" Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
            <Button Content="_Cancel" Width="80" Height="30" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
