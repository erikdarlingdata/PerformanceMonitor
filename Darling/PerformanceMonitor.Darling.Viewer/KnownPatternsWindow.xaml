<Window x:Class="PerformanceMonitor.Darling.Viewer.KnownPatternsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Known Patterns"
        Height="500" Width="900"
        WindowStartupLocation="CenterOwner"
        Icon="EDD.ico"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundLightBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <!-- The known-pattern manager (#6334), MuteRulesWindow's shape: a grid and Add/Edit/Delete, straight to Postgres through
         ViewerDataService. Entries are written by operators only; the MCP server has no write tool for them. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ViewerDarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Known Patterns" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1"
                   Text="A known pattern is something you know about: a nightly job, a planned batch. An alert that matches one carries its note in the alert history and in the investigation brief. It is not muted. Changes are written to the shared store."
                   Foreground="{DynamicResource ForegroundMutedBrush}" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,0,0,12"/>

        <Grid Grid.Row="2">
            <DataGrid x:Name="PatternsGrid"
                      Style="{StaticResource DarkGrid}"
                      CanUserDeleteRows="False"
                      MouseDoubleClick="PatternsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Server" Binding="{Binding ServerDisplay}" Width="120"/>
                    <DataGridTextColumn Header="Metric" Binding="{Binding MetricDisplay}" Width="130"/>
                    <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="60"/>
                    <DataGridTextColumn Header="Zone" Binding="{Binding ZoneDisplay}" Width="120"/>
                    <DataGridTextColumn Header="Window" Binding="{Binding WindowMinutes}" Width="65"/>
                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                    <DataGridTextColumn Header="Created by" Binding="{Binding CreatedBy}" Width="110"/>
                    <DataGridTextColumn Header="Expires" Binding="{Binding ExpiresDisplay}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="NoPatternsMessage"
                       Text="No known patterns yet. Add one for something you already know about."
                       Foreground="{DynamicResource ForegroundMutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                       Visibility="Collapsed"/>
        </Grid>

        <StackPanel x:Name="ActionButtonsPanel" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Content="_Add..." Width="100" Height="28" Margin="0,0,8,0" Click="Add_Click"/>
            <Button Content="_Edit" Width="80" Height="28" Margin="0,0,8,0" Click="Edit_Click"/>
            <Button Content="_Delete" Width="80" Height="28" Click="Delete_Click"/>
        </StackPanel>
        <TextBlock x:Name="StatusBanner" Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Center"
                   Margin="0,12,0,0" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" MaxWidth="640" Visibility="Collapsed"/>
        <Button Grid.Row="3" Content="_Close" Width="80" Height="28" Margin="0,12,0,0"
                HorizontalAlignment="Right" Click="Close_Click" IsCancel="True"/>
    </Grid>
</Window>
