<Window x:Class="PerformanceMonitor.Darling.Viewer.WebAccessGroupsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Web Access Groups" Width="880" Height="690" MinWidth="720" MinHeight="550"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource BackgroundDarkBrush}">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Read-only web access for teams. Select tag subtrees or explicitly grant All servers. Tokens use the existing dashboard sign-in form."
   TextWrapping="Wrap" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,12"/>
  <Grid Grid.Row="1" x:Name="EditorPanel">
   <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel>
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
     <Button x:Name="NewButton" Content="_New group" Click="New_Click" Padding="8,4" Margin="0,0,6,0"/>
     <Button x:Name="RefreshButton" Content="_Refresh" Click="Refresh_Click" Padding="8,4"/>
    </WrapPanel>
    <ListBox x:Name="GroupList" SelectionChanged="GroupList_SelectionChanged" DisplayMemberPath="Name"
     AutomationProperties.Name="Web access groups" Background="{DynamicResource BackgroundBrush}"/>
   </DockPanel>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="DetailsPanel">
     <TextBlock Text="Group name" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4"/>
     <TextBox x:Name="NameBox" AutomationProperties.Name="Group name" MaxLength="64" Margin="0,0,0,8"/>
     <TextBlock Text="Use letters, digits, dots, underscores, colons or hyphens. Names are fixed at creation; delete and recreate to rename."
      TextWrapping="Wrap" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,8"/>
     <CheckBox x:Name="EnabledBox" Content="_Enabled" IsChecked="True" Margin="0,0,0,12"/>
     <RadioButton x:Name="TagsRadio" Content="Selected _tags and their descendants" GroupName="Scope" IsChecked="True"
      Checked="Scope_Changed" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6"/>
     <RadioButton x:Name="AllRadio" Content="_All servers, including untagged and newly added servers" GroupName="Scope"
      Checked="Scope_Changed" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,8"/>
     <ListBox x:Name="TagList" MaxHeight="190" SelectionMode="Multiple" AutomationProperties.Name="Allowed tag subtrees"
      Background="{DynamicResource BackgroundBrush}" SelectionChanged="TagList_SelectionChanged">
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Path}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock x:Name="ScopeNote" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,6,0,10"/>
     <TextBlock x:Name="ActivationText" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10"/>
     <WrapPanel>
      <Button x:Name="SaveButton" Content="_Save scope" Click="Save_Click" Padding="10,5" Margin="0,0,6,6"/>
      <Button x:Name="RotateButton" Content="Rotate _token..." Click="Rotate_Click" Padding="10,5" Margin="0,0,6,6"/>
      <Button x:Name="DeleteButton" Content="_Delete group..." Click="Delete_Click" Padding="10,5" Margin="0,0,6,6"/>
     </WrapPanel>
     <StackPanel x:Name="TokenPanel" Visibility="Collapsed" Margin="0,12,0,0">
      <TextBlock Text="New token" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
      <TextBox x:Name="TokenBox" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap"
       AutomationProperties.Name="New web token" Margin="0,6,0,6"/>
      <TextBlock Text="Copy the token now. It is shown once and is not stored in a readable form; rotate the token if it is lost."
       TextWrapping="Wrap" Foreground="{DynamicResource ForegroundMutedBrush}"/>
      <Button Content="Clear token from this window" Click="ClearToken_Click" HorizontalAlignment="Left" Margin="0,6,0,8"/>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,12,0,0">
   <Button DockPanel.Dock="Right" Content="_Close" Click="Close_Click" Padding="16,5"/>
   <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
  </DockPanel>
 </Grid>
</Window>
