<Window x:Class="PerformanceMonitor.Darling.Viewer.KnownPatternEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Known Pattern"
        SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner"
        Icon="EDD.ico"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundLightBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <!-- The known-pattern entry form (#6334), built like MuteRuleEditDialog: dark-styled via the shared ViewerDarkTheme dictionary,
         a Save that checks the form and shows the refusal text instead of closing. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ViewerDarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" Text="Add Known Pattern" FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Left" Margin="0,0,0,5"/>
        <TextBlock Grid.Row="1"
                   Text="An alert that matches carries this note, so whoever investigates it knows the pattern is expected. Leave a field blank to match any value."
                   Foreground="{DynamicResource ForegroundMutedBrush}" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,0,0,12"/>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Server" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                <ComboBox x:Name="ServerCombo" DisplayMemberPath="Display"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Metric" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                <ComboBox x:Name="MetricCombo" IsEditable="True"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Time of day (HH:mm)" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                <TextBox x:Name="TimeOfDayBox" ToolTip="24-hour time the pattern happens at, such as 02:10. Leave empty to match any time of day."/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Time zone (IANA id)" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                <TextBox x:Name="TimeZoneBox" ToolTip="The zone the time of day is in, such as America/New_York. Empty means UTC."/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Window (minutes)" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                <TextBox x:Name="WindowBox" ToolTip="How many minutes either side of the time of day still count as this pattern."/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="4" Text="Note (required, 500 characters at most)" FontWeight="Bold" HorizontalAlignment="Left" Margin="0,4,0,4"/>
        <TextBox Grid.Row="5" x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="6" Text="Expires (UTC, yyyy-MM-dd or yyyy-MM-dd HH:mm; empty for never)" HorizontalAlignment="Left" Margin="0,0,0,4"/>
        <TextBox Grid.Row="7" x:Name="ExpiresBox" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <!-- No IsDefault: a multi-line note makes Enter-to-submit a surprise, as in the mute rule dialog (#1828/#1859). -->
            <Button Content="_Save" Width="80" Height="30" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="_Cancel" Width="80" Height="30" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
