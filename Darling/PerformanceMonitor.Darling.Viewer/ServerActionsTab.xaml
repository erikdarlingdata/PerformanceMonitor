<UserControl x:Class="PerformanceMonitor.Darling.Viewer.ServerActionsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- #6269: each server's agent action switches. All are off until a person turns one on. A switch lets agents change that
         server (force or unforce plans, evict plans, kill sessions); only the actions the server's engine can run are listed, plus a switch that is on but that the engine cannot run (shown with a note; it can only be turned off). -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,8"
                   Text="Each server's agent action switches. Every switch is off until a person turns it on. A switch that is on lets agents change that server, and it also needs the remediation login and its grants (see the Darling README). Every agent change is journaled and can be undone where that is possible. Turning a switch on or off is recorded with your name."/>
        <DataGrid Grid.Row="1" x:Name="ServersGrid" Style="{DynamicResource DarkGrid}" IsReadOnly="True" SelectionMode="Single" AutomationProperties.Name="Server action switches">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="160"/>
                <DataGridTextColumn Header="Engine" Binding="{Binding EngineDisplay}" Width="100"/>
                <DataGridTextColumn Header="Action" Binding="{Binding ActionDisplay}" Width="*"/>
                <DataGridTextColumn Header="Switch" Binding="{Binding StateDisplay}" Width="70"/>
                <DataGridTextColumn Header="Changed by" Binding="{Binding ChangedBy}" Width="170"/>
                <DataGridTextColumn Header="Changed" Binding="{Binding ChangedDisplay}" Width="130" SortMemberPath="ChangedAtUtc"/>
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="260">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel x:Name="SwitchPanel" Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Turn _On..." Height="26" Padding="10,0" Margin="0,0,8,0" Click="TurnOn_Click" AutomationProperties.Name="Turn the selected switch on"/>
            <Button Content="Turn O_ff" Height="26" Padding="10,0" Click="TurnOff_Click" AutomationProperties.Name="Turn the selected switch off"/>
        </StackPanel>
    </Grid>
</UserControl>
