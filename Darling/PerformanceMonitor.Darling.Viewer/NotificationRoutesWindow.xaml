<Window x:Class="PerformanceMonitor.Darling.Viewer.NotificationRoutesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification Routes"
        Height="520" Width="900"
        WindowStartupLocation="CenterOwner"
        Icon="EDD.ico"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundLightBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <!-- #3598: the sparse routes layered over the Settings window's Notifications channels. Mirrors
         MuteRulesWindow's shape (grid + Add/Edit/Toggle/Delete, straight to Postgres via ViewerDataService;
         the V131 trigger bumps config_version so the running service re-reads the routes on its next sweep). -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ViewerDarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Notification Routes" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1"
                   Text="Send alert families to different channels. A route names a family (self-monitor, reports, agent-jobs, performance) or one exact metric name, and a destination per channel. An empty channel on a route inherits the Notifications section's channel; a filled one replaces it for that family only, or enables a channel the parent does not have. Exact-metric routes win over family routes; with no routes every alert goes to every configured channel. Routing changes where a post lands, never whether it is sent."
                   Foreground="{DynamicResource ForegroundMutedBrush}" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,0,0,12"/>

        <Grid Grid.Row="2">
            <DataGrid x:Name="RoutesGrid"
                      Style="{StaticResource DarkGrid}"
                      CanUserDeleteRows="False"
                      MouseDoubleClick="RoutesGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Enabled" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding RoutesAreEditable, RelativeSource={RelativeSource AncestorType=Window}}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Click="EnabledCheckBox_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="#" Binding="{Binding RouteId}" Width="44"/>
                    <DataGridTextColumn Header="Matches" Binding="{Binding MetricMatch}" Width="200"/>
                    <DataGridTextColumn Header="Kind" Binding="{Binding MatchKindDisplay}" Width="100"/>
                    <DataGridTextColumn Header="Channels set" Binding="{Binding ChannelsDisplay}" Width="*"/>
                    <DataGridTextColumn Header="Email to" Binding="{Binding SmtpRecipients}" Width="180"/>
                    <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedDisplay}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="NoRoutesMessage"
                       Text="No routes yet — every alert goes to every channel configured in Notifications. Add a route to send a family somewhere else."
                       Foreground="{DynamicResource ForegroundMutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"
                       Visibility="Collapsed"/>
        </Grid>

        <StackPanel x:Name="ActionButtonsPanel" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Content="_Add Route..." Width="110" Height="28" Margin="0,0,8,0" Click="AddRoute_Click"/>
            <Button Content="_Edit" Width="80" Height="28" Margin="0,0,8,0" Click="EditRoute_Click"/>
            <Button Content="_Toggle" Width="80" Height="28" Margin="0,0,8,0" Click="ToggleRoute_Click"/>
            <Button Content="_Delete" Width="80" Height="28" Margin="0,0,8,0" Click="DeleteRoute_Click"/>
        </StackPanel>
        <TextBlock x:Name="ReadOnlyBanner" Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Center"
                   Margin="0,12,0,0" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" MaxWidth="600" Visibility="Collapsed"
                   Text="Read-only connection (postgres.connectAs = &quot;viewer&quot;): routes can be viewed but not changed here, and their destination URLs are not shown. Set connectAs to &quot;admin&quot; and restart the viewer to edit them."/>
        <Button Grid.Row="3" Content="_Close" Width="80" Height="28" Margin="0,12,0,0"
                HorizontalAlignment="Right" Click="Close_Click" IsCancel="True"/>
    </Grid>
</Window>
