<Window x:Class="PerformanceMonitor.Darling.Viewer.AlertDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alert Details"
        Width="480" Height="600" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Icon="EDD.ico"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundLightBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <!-- Copied from Lite's AlertDetailWindow (Lite/Windows/AlertDetailWindow.xaml) for the W2a Alert
         History parity: the modal alert detail the grid opens on double-click / View Details, replacing
         the shell's inline detail pane (Lite has no inline pane, only this window). Dark-styled via the
         shared ViewerDarkTheme dictionary (closer than the app theme) with the same inline dark palette
         MainWindow uses; the DynamicResource theme keys Lite used are inlined because the viewer's dark
         dictionary keys them differently. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ViewerDarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Alert Details" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,16"/>

        <!-- Detail fields -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Time:" FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,4"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TimeText"
                     Style="{StaticResource SelectableValueText}" Margin="0,4"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Server:" FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,4"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ServerText"
                     Style="{StaticResource SelectableValueText}" Margin="0,4"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Metric:" FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,4"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="MetricText"
                     Style="{StaticResource SelectableValueText}" Margin="0,4"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Current Value:" FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,4"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="CurrentValueText"
                     Style="{StaticResource SelectableValueText}" Margin="0,4"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Threshold:" FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,4"/>
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="ThresholdText"
                     Style="{StaticResource SelectableValueText}" Margin="0,4"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Notification:" FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,4"/>
            <TextBox Grid.Row="5" Grid.Column="1" x:Name="NotificationText"
                     Style="{StaticResource SelectableValueText}" Margin="0,4"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Status:" FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,4"/>
            <TextBox Grid.Row="6" Grid.Column="1" x:Name="StatusValueText"
                     Style="{StaticResource SelectableValueText}" Margin="0,4"/>

            <!-- #7124: why the alert went where it did (held for the daily digest, or paged), from the persisted routing
                 decision; collapsed on a row that carries none. -->
            <TextBlock Grid.Row="7" Grid.Column="0" x:Name="RoutingReasonLabel" Text="Routing reason:" FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,4" Visibility="Collapsed"/>
            <TextBox Grid.Row="7" Grid.Column="1" x:Name="RoutingReasonText"
                     Style="{StaticResource SelectableValueText}" Margin="0,4" Visibility="Collapsed"/>

            <!-- #5642: how old the newest sample was when the alert fired, from the persisted context; shown only when
                 the alert persisted it. A header row, as in Lite (#5847), so an alert with an age and no detail items
                 does not open a tall empty Details panel just to hold this line at its bottom. -->
            <TextBlock Grid.Row="8" Grid.Column="0" x:Name="SampleAgeLabel" Text="Newest sample:" FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,4" Visibility="Collapsed"/>
            <TextBox Grid.Row="8" Grid.Column="1" x:Name="SampleAgeText"
                     Style="{StaticResource SelectableValueText}" Margin="0,4" Visibility="Collapsed"/>

            <!-- #5825: a resolution row's send, below #5642's sample-age row; the three rows are collapsed on every
                 other row. Selectable values, as every header value is since #5847. -->
            <TextBlock Grid.Row="9" Grid.Column="0" x:Name="ResolutionSentAtLabel" Text="Resolution sent:" FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,4"/>
            <TextBox Grid.Row="9" Grid.Column="1" x:Name="ResolutionSentAtText"
                     Style="{StaticResource SelectableValueText}" Margin="0,4"/>
            <TextBlock Grid.Row="10" Grid.Column="0" x:Name="ResolutionChannelsLabel" Text="Resolution channels:" FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,4"/>
            <TextBox Grid.Row="10" Grid.Column="1" x:Name="ResolutionChannelsText"
                     Style="{StaticResource SelectableValueText}" Margin="0,4"/>
            <TextBlock Grid.Row="11" Grid.Column="0" x:Name="ResolutionOutcomeLabel" Text="Resolution outcome:" FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,4"/>
            <TextBox Grid.Row="11" Grid.Column="1" x:Name="ResolutionOutcomeText"
                     Style="{StaticResource SelectableValueText}" Margin="0,4"/>

            <!-- #7084 part 4: the analysis findings held back from paging because this engine alert was open, read when the
                 window opens; collapsed when there are none or the metric is not one findings attach to. -->
            <TextBlock Grid.Row="12" Grid.Column="0" x:Name="AttachedFindingsLabel" Text="Attached findings:" FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,4" Visibility="Collapsed"/>
            <TextBox Grid.Row="12" Grid.Column="1" x:Name="AttachedFindingsText"
                     Style="{StaticResource SelectableValueText}" Margin="0,4" Visibility="Collapsed"/>
        </Grid>

        <!-- Muted indicator -->
        <Border Grid.Row="2" x:Name="MutedBanner" Visibility="Collapsed"
                Background="#33FFD54F"
                CornerRadius="4" Padding="8" Margin="0,12,0,0">
            <TextBlock Text="&#x1F507; This alert was muted by a mute rule"
                       Foreground="{DynamicResource ForegroundBrush}" FontStyle="Italic"/>
        </Border>

        <!-- Context-specific details -->
        <Border Grid.Row="3" x:Name="DetailPanel" Visibility="Collapsed"
                Background="{DynamicResource BackgroundDarkBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,12,0,0">
            <!-- #5847: a Grid, not a StackPanel, so the items area fills the window as it grows. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Details" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6"/>

                <!-- Structured detail items (advice prose, remediation T-SQL, drill-down).
                     Shown when the persisted context_json deserializes. -->
                <ScrollViewer Grid.Row="1" x:Name="DetailItemsScroll" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DetailItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4"/>

                                    <!-- Remediation T-SQL: monospace, read-only, with Copy. -->
                                    <StackPanel Visibility="{Binding IsCodeBlock, Converter={StaticResource BoolToVis}}">
                                        <Button Content="Copy" HorizontalAlignment="Right"
                                                Padding="8,2" Margin="0,0,0,4"
                                                Click="CopyTsqlButton_Click"/>
                                        <TextBox Text="{Binding Body, Mode=OneWay}" IsReadOnly="True"
                                                 FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                                                 MaxHeight="240"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource ForegroundBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                    </StackPanel>

                                    <!-- Advice prose. -->
                                    <TextBox Text="{Binding Body, Mode=OneWay}"
                                             Style="{StaticResource SelectableValueText}"
                                             Visibility="{Binding IsProse, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Label/value field rows. -->
                                    <ItemsControl ItemsSource="{Binding Fields}"
                                                  Visibility="{Binding HasFields, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                               Foreground="{DynamicResource ForegroundBrush}"
                                                               TextWrapping="Wrap"/>
                                                    <TextBox Grid.Column="1" x:Name="FieldValue" Text="{Binding Value, Mode=OneWay}"
                                                             Style="{StaticResource SelectableValueText}"
                                                             FontFamily="Consolas" FontSize="12"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Legacy / no-context fallback: flat persisted detail_text. -->
                <TextBox Grid.Row="1" x:Name="DetailTextBox" IsReadOnly="True" TextWrapping="Wrap"
                         Visibility="Collapsed"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource ForegroundBrush}" FontFamily="Consolas"
                         FontSize="12"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <!-- Footer. This window had no close button of any kind, which made it the one dialog in
             either app a keyboard user could not dismiss (its only other button is the per-section
             Copy inside the ItemsControl template, and hanging IsCancel on that would make Esc copy
             something). A real Close matches every sibling dialog and gives Esc something correct to
             press. -->
        <!-- #5847: Copy all details puts the whole alert on the clipboard as plain text; the link opens the server's
             Blocking or Deadlocks view at the incident's time (shown only for those alerts, and only when the
             window's opener can navigate there); the status line says when the clipboard was busy. -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock x:Name="FullChainLinkText" Visibility="Collapsed" TextWrapping="Wrap">
                    <Hyperlink x:Name="FullChainLink" Click="FullChainLink_Click"
                               Foreground="{DynamicResource AccentBrush}">
                        <Run x:Name="FullChainLinkRun"/>
                    </Hyperlink>
                </TextBlock>
                <TextBlock x:Name="CopyStatusText" Visibility="Collapsed" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundBrush}" FontStyle="Italic"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="CopyAllButton" Content="Copy _all details" Padding="10,0" Height="28"
                    Margin="0,0,8,0" Click="CopyAll_Click"/>
            <Button Grid.Column="2" Content="_Close" Width="80" Height="28" IsCancel="True" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
