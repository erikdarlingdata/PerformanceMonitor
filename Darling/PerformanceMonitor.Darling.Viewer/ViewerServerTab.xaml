                                            <DataTemplate>
                                                <TextBlock Text="{Binding QueryText}" TextWrapping="Wrap" MaxHeight="90" Margin="5,2"
                                                           ToolTip="{Binding QueryText}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Query Plan download column (mirrors Lite's Top Queries "Download" button), gated on
                                         HasQueryPlan so it's only actionable when the collector stored a plan for this row.
                                         The button saves the stored query_plan_xml to a .sqlplan file; "View Plan" (context
                                         menu) opens it in the Plan Viewer tab instead. -->
                                    <DataGridTemplateColumn Header="Query Plan" Width="Auto" MinWidth="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Download" Click="DownloadQueryStatsPlan_Click"
