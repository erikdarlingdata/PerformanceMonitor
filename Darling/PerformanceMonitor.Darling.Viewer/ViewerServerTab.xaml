        <!-- Latches & Spinlocks Tab — the Dashboard-parity port of ResourceMetricsContent's Latch Stats /
             Spinlock Stats. CONSOLIDATED from two sub-tabs into ONE tab (Erik's "consolidation, not
             removal"): the latch wait-time trend and the spinlock collisions trend stack vertically
             (full-width so the time axis reads), each with its per-class latest-snapshot grid tucked into a
             collapsed Expander directly beneath it — decluttered by default, the per-class detail one click
             away. Every grid column / binding is preserved verbatim from the former sub-tabs. Grouped into
             the diagnostics tail (after System Events, before Collection Health). Loads on parent-tab
             activation (mirrors the Memory tab), so no SelectionChanged handler is needed. -->
        <TabItem Header="Latches &amp; Spinlocks">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Latch wait-time trend (top 5 classes by delta wait) + per-class latest-snapshot grid. -->
                <scottplot:WpfPlot Grid.Row="0" x:Name="LatchStatsChart"/>
                <Expander Grid.Row="1" Header="Latch classes (latest snapshot)" IsExpanded="False" Margin="0,4,0,0">
                    <DataGrid x:Name="LatchStatsGrid" Style="{StaticResource DarkGrid}" MaxHeight="220" Margin="0,4,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Latch Class" Binding="{Binding LatchClass}" Width="*"/>
                            <DataGridTextColumn Header="Δ Wait (ms)" Binding="{Binding DeltaWaitTimeMs, StringFormat=N0}" ElementStyle="{StaticResource NumericCell}" Width="110"/>
                            <DataGridTextColumn Header="Δ Waiting Reqs" Binding="{Binding DeltaWaitingRequestsCount, StringFormat=N0}" ElementStyle="{StaticResource NumericCell}" Width="120"/>
                            <DataGridTextColumn Header="Wait Time (ms)" Binding="{Binding WaitTimeMs, StringFormat=N0}" ElementStyle="{StaticResource NumericCell}" Width="120"/>
                            <DataGridTextColumn Header="Max Wait (ms)" Binding="{Binding MaxWaitTimeMs, StringFormat=N0}" ElementStyle="{StaticResource NumericCell}" Width="110"/>
                            <DataGridTextColumn Header="Waiting Reqs (total)" Binding="{Binding WaitingRequestsCount, StringFormat=N0}" ElementStyle="{StaticResource NumericCell}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>

                <!-- Spinlock collisions trend (top 5 spinlocks by delta collisions) + per-spinlock snapshot grid. -->
                <scottplot:WpfPlot Grid.Row="2" x:Name="SpinlockStatsChart" Margin="0,8,0,0"/>
                <Expander Grid.Row="3" Header="Spinlocks (latest snapshot)" IsExpanded="False" Margin="0,4,0,0">
                    <DataGrid x:Name="SpinlockStatsGrid" Style="{StaticResource DarkGrid}" MaxHeight="220" Margin="0,4,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Spinlock" Binding="{Binding SpinlockName}" Width="*"/>
                            <DataGridTextColumn Header="Δ Collisions" Binding="{Binding DeltaCollisions, StringFormat=N0}" ElementStyle="{StaticResource NumericCell}" Width="110"/>
                            <DataGridTextColumn Header="Δ Spins" Binding="{Binding DeltaSpins, StringFormat=N0}" ElementStyle="{StaticResource NumericCell}" Width="120"/>
                            <DataGridTextColumn Header="Spins/Collision" Binding="{Binding SpinsPerCollision, StringFormat=N2}" ElementStyle="{StaticResource NumericCell}" Width="120"/>
                            <DataGridTextColumn Header="Collisions (total)" Binding="{Binding Collisions, StringFormat=N0}" ElementStyle="{StaticResource NumericCell}" Width="130"/>
                            <DataGridTextColumn Header="Spins (total)" Binding="{Binding Spins, StringFormat=N0}" ElementStyle="{StaticResource NumericCell}" Width="120"/>
                            <DataGridTextColumn Header="Sleep Time" Binding="{Binding SleepTime, StringFormat=N0}" ElementStyle="{StaticResource NumericCell}" Width="100"/>
                            <DataGridTextColumn Header="Backoffs" Binding="{Binding Backoffs, StringFormat=N0}" ElementStyle="{StaticResource NumericCell}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>
            </Grid>
        </TabItem>

        <!-- Collection Health Tab — upgraded from the shell's single latest-run grid to Lite's rich
             3-sub-tab shape (copied from Lite's ServerTab.xaml Collection Health tab). Reads rewired to
             Postgres; grids keep the viewer's DarkGrid chrome + Lite's ColumnFilterButtonStyle headers.
             Health Summary = the 7-day per-collector aggregate with the HealthStatus band (double-click
             opens the per-collector CollectionLogWindow drill). Collection Log = the recent run log.
             Duration Trends = the per-collector success-duration scatter. Two deviations from Lite: the
             HealthStatus cell is plain text (Lite doesn't color it — the shell's StatusToBrush stays on
             the Findings grid only), and Lite's "Open Log File" button is dropped (it opens Lite's local
             log file, which the viewer has no equivalent of). -->
        <TabItem x:Name="CollectionHealthTab" Header="Collection Health">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Fleet-wide "Purge Now": runs the daily retention purge on demand via the purge_now
                     control command. Placed on Collection Health (the store-health tab) rather than a
                     per-server toolbar because the purge is fleet-wide over the shared store tables. A
                     read-only viewer seat can't enqueue commands, so the handler shows an explanation. -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="PurgeNowButton" Content="Purge Now..." Click="PurgeNow_Click"
                            Padding="12,4" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PurgeNowIndicator" Text="" FontSize="12"
                               Foreground="DarkGoldenrod" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" ItemContainerStyle="{DynamicResource SubTabItemStyle}">
                    <TabItem Header="Health Summary">
                        <DataGrid x:Name="CollectionHealthGrid" Style="{StaticResource DarkGrid}"
                                  MouseDoubleClick="CollectionHealthGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding CollectorName}" Width="180">
                                    <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="CollectorName" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Collector" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding HealthStatus}" Width="90">
                                    <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="HealthStatus" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Status" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding TotalRuns, StringFormat=N0}" ElementStyle="{StaticResource NumericCell}" Width="80">
                                    <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="TotalRuns" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Runs" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding SuccessCount, StringFormat=N0}" ElementStyle="{StaticResource NumericCell}" Width="80">
                                    <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="SuccessCount" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Success" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding ErrorCount, StringFormat=N0}" ElementStyle="{StaticResource NumericCell}" Width="80">
                                    <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="ErrorCount" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Errors" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding YieldCount, StringFormat=N0}" ElementStyle="{StaticResource NumericCell}" Width="80">
                                    <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="YieldCount" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Yields" FontWeight="Bold" VerticalAlignment="Center" ToolTip="Deliberate 1-second lock-timeout yields: the snapshot collector stepped aside instead of joining a blocking chain. A signal about lock contention on the monitored server, not a collection failure."/></StackPanel></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding FailureRatePercent, StringFormat=N1}" ElementStyle="{StaticResource NumericCell}" Width="85">
                                    <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="FailureRatePercent" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Fail %" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding AvgDurationFormatted}" Width="120" SortMemberPath="AvgDurationMs">
                                    <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="AvgDurationFormatted" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Avg Duration" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding LastSuccessFormatted}" Width="140">
                                    <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="LastSuccessFormatted" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Last Success" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding LastRunFormatted}" Width="140">
                                    <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="LastRunFormatted" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Last Run" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding LastErrorFormatted}" Width="140">
                                    <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="LastErrorFormatted" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Last Error At" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding LastError}" Width="*">
                                    <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="LastError" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Last Error" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!-- #1837: what a NON-failing run reported. Blank for a plainly healthy collector; "(all N runs)" is the persistently-empty case. Informational only - the Status column's band is unchanged. -->
                                <DataGridTextColumn Binding="{Binding NoteFormatted}" Width="*">
                                    <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="NoteFormatted" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Note" FontWeight="Bold" VerticalAlignment="Center" ToolTip="What a non-failing run reported: an enumeration that came back with 0 items, or items whose enumeration probe failed. Not an error - an empty target is legitimately empty."/></StackPanel></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Collection Log">
                        <!-- Lite's "Open Log File" button dropped (it opens Lite's local log file; the
                             viewer has no equivalent), so the grid fills the whole sub-tab. -->
                        <DataGrid x:Name="CollectionLogGrid" Style="{StaticResource DarkGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding CollectionTimeFormatted}" Width="130">
                                    <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="CollectionTimeFormatted" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Time" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding CollectorName}" Width="180">
                                    <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="CollectorName" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Collector" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Status}" Width="80">
                                    <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="Status" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Status" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding DurationFormatted}" Width="90" SortMemberPath="DurationMs">
                                    <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="DurationFormatted" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Duration" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding SqlDurationFormatted}" Width="90" SortMemberPath="SqlDurationMs">
                                    <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="SqlDurationFormatted" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="SQL (ms)" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!-- Store phase: the store column is duckdb_duration_ms, but on the Darling
                                     side it records the Postgres write time — labelled "Store (ms)". -->
                                <DataGridTextColumn Binding="{Binding DuckDbDurationFormatted}" Width="120" SortMemberPath="DuckDbDurationMs">
                                    <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="DuckDbDurationFormatted" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Store (ms)" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding RowsCollected, StringFormat=N0}" ElementStyle="{StaticResource NumericCell}" Width="80">
                                    <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="RowsCollected" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Rows" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding ErrorMessage}" Width="*">
                                    <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="ErrorMessage" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Error" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Duration Trends">
                        <scottplot:WpfPlot x:Name="CollectorDurationChart" Margin="4"/>
                    </TabItem>
                </TabControl>
            </Grid>
        </TabItem>

        <!-- Long Queries Tab (#1496) — completed long-running queries + attentions (cancels/timeouts) from
             the opt-in PerformanceMonitor_LongQueryCompletions XE session. Default OFF; the banner points to
             where the switch lives when the collector is disabled. MUST remain the last inner tab (index 18). -->
        <TabItem Header="Long Queries">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Long-Running Query Completions (RPC / batch completions over the duration threshold, plus attentions / cancels)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" x:Name="LongQueriesDisabledWarning" Visibility="Collapsed"
                           Foreground="{DynamicResource WarningTextBrush}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                           Text="The long-query completion trace is OFF for this server. It is opt-in because a completion trace adds overhead on busy servers. Turn it on in Settings &#x2192; Collection Schedule &#x2192; Edit Collector Schedules&#x2026;, then tick the 'long_query_completions' Enabled box. Enabling it creates the Extended Events session on this server; disabling it drops the session."/>
                <DataGrid Grid.Row="2" x:Name="LongQueryCompletionsGrid"
                          Style="{StaticResource DarkGrid}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          CanUserSortColumns="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource DarkGridRow}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAborted}" Value="True">
                                    <Setter Property="Background" Value="#33FF6B6B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAttention}" Value="True">
                                    <Setter Property="Background" Value="#33FFB86B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding EventTimeLocal}" Width="150" SortMemberPath="EventTime">
                            <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="EventTimeLocal" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Event Time" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Statement" Width="360">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatementText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatementText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Binding="{Binding EventType}" Width="140">
                            <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="EventType" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Event Type" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding DurationFormatted}" Width="100" SortMemberPath="DurationMicroseconds">
                            <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="DurationFormatted" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Duration" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding CpuFormatted}" Width="100" SortMemberPath="CpuTimeMicroseconds">
                            <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="CpuFormatted" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="CPU" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding LogicalReads}" ElementStyle="{StaticResource NumericCell}" Width="110">
                            <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="LogicalReads" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Logical Reads" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding PhysicalReads}" ElementStyle="{StaticResource NumericCell}" Width="110">
                            <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="PhysicalReads" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Physical Reads" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Writes}" ElementStyle="{StaticResource NumericCell}" Width="90">
                            <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="Writes" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Writes" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding RowCountValue}" ElementStyle="{StaticResource NumericCell}" Width="90">
                            <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="RowCountValue" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Rows" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Result}" Width="80">
                            <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="Result" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Result" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding DatabaseName}" Width="140">
                            <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="DatabaseName" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Database" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding ObjectName}" Width="180">
                            <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="ObjectName" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Object" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding SessionId}" ElementStyle="{StaticResource NumericCell}" Width="80">
                            <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="SessionId" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Session" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding ClientAppName}" Width="180">
                            <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="ClientAppName" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Application" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding ServerPrincipalName}" Width="150">
                            <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="ServerPrincipalName" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Login" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding QueryHash}" Width="150">
                            <DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><Button Style="{DynamicResource ColumnFilterButtonStyle}" Tag="QueryHash" Click="FilterButton_Click" Margin="0,0,4,0"/><TextBlock Text="Query Hash" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <!-- ══════════════════════════════════════════════════════════════════════════════════════════
             POSTGRESQL INNER TABS (#2530) — indices 19-24, the counterpart of the web dashboard's
             POSTGRES_TABS registry. Declared here rather than in a second TabControl so both engines'
             tabs keep FIXED indices: for a PostgreSQL server every TabItem above is collapsed and these
             six are shown, and every SQL Server index constant (which drill-down navigation keys on) is
             untouched. Registry, headers and panel-to-collector mapping: ViewerPostgresTabs.cs, which
             ViewerPostgresTabsTests holds to CollectorCatalog in both directions.

             Every panel carries its own note TextBlock ABOVE its grid. That is the point of the tab set,
             not decoration: the defect this closes is twelve blank SQL Server tabs that say nothing about
             why they are blank, and a PostgreSQL panel with no rows has to say which of the three reasons
             it is — nothing to report, nothing collected yet, or a collector this engine will never run
             (the shared CollectorEngineCapability sentence, the same one the MCP surface and the web
             dashboard print).
             ══════════════════════════════════════════════════════════════════════════════════════════ -->

        <TabItem x:Name="PgOverviewTab" Header="Overview" Visibility="Collapsed">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="PgEngineBanner" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" x:Name="PgOverviewNote" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                <DataGrid Grid.Row="2" x:Name="PgCollectorHealthGrid" Style="{StaticResource DarkGrid}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserSortColumns="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource DarkGridRow}">
                            <!-- LEAST severe first, same rule. These two happen to be mutually exclusive
                                 (BuildPostgresCollectorHealth only sets IsFault when there is no engine
                                 gap), so the order is not load-bearing today — it is written this way so it
                                 stays correct if that ever stops being true, and so one rule covers every
                                 row style on these tabs rather than one rule and one exception. -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPermanentGap}" Value="True">
                                    <Setter Property="Background" Value="#22FFFFFF"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFault}" Value="True">
                                    <Setter Property="Background" Value="#33FF6B6B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Collector" Binding="{Binding Collector}" Width="180"/>
                        <DataGridTextColumn Header="Store Table" Binding="{Binding StoreTable}" Width="200"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="180"/>
                        <DataGridTextColumn Header="Last Run" Binding="{Binding LastRun}" Width="140"/>
                        <DataGridTextColumn Header="Runs" Binding="{Binding Runs}" ElementStyle="{StaticResource NumericCell}" Width="70"/>
                        <DataGridTextColumn Header="Failed" Binding="{Binding FailedRuns}" ElementStyle="{StaticResource NumericCell}" Width="70"/>
                        <DataGridTextColumn Header="Rows" Binding="{Binding RowsCollected}" ElementStyle="{StaticResource NumericCell}" Width="90"/>
                        <DataGridTemplateColumn Header="Why" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Explanation}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Explanation}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- #2545 the extension axis. Sits under the collector grid because it answers the question
                     that grid raises and cannot: a collector missing for want of an extension is a SETUP
                     step rather than a wall, and this is where the step is named. -->
                <TextBlock Grid.Row="3" x:Name="PgExtensionsNote" FontSize="12" Margin="0,10,0,6" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                <DataGrid Grid.Row="4" x:Name="PgExtensionsGrid" Style="{StaticResource DarkGrid}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Extension" Binding="{Binding ExtensionName}" Width="200"/>
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="130"/>
                        <DataGridTextColumn Header="Installed (this database)" Binding="{Binding InstalledVersion}" Width="170"/>
                        <DataGridTextColumn Header="Server Offers" Binding="{Binding DefaultVersion}" Width="130"/>
                        <DataGridTemplateColumn Header="What It Would Give Us" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Comment}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Comment}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem x:Name="PgActivityTab" Header="Activity" Visibility="Collapsed">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="PgActivityNote" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                <TabControl Grid.Row="1" x:Name="PgActivitySubTabs" Background="Transparent" BorderThickness="0"
                            ItemContainerStyle="{DynamicResource SubTabItemStyle}">
                    <TabItem Header="Blocking">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="PgBlockingNote" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
                            <DataGrid Grid.Row="1" x:Name="PgBlockingChainsGrid" Style="{StaticResource DarkGrid}"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserSortColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Captured" Binding="{Binding CapturedAt}" Width="140"/>
                                    <DataGridTextColumn Header="Root PID" Binding="{Binding RootPid}" ElementStyle="{StaticResource NumericCell}" Width="90"/>
                                    <DataGridTextColumn Header="Backend ID" Binding="{Binding RootBackendId}" ElementStyle="{StaticResource NumericCell}" Width="110"/>
                                    <DataGridTextColumn Header="Databases" Binding="{Binding Databases}" Width="150"/>
                                    <DataGridTextColumn Header="Victims" Binding="{Binding TotalVictims}" ElementStyle="{StaticResource NumericCell}" Width="80"/>
                                    <DataGridTextColumn Header="Direct" Binding="{Binding DirectVictims}" ElementStyle="{StaticResource NumericCell}" Width="70"/>
                                    <DataGridTextColumn Header="Depth" Binding="{Binding Depth}" Width="80"/>
                                    <DataGridTextColumn Header="Worst Wait" Binding="{Binding WorstVictimWait}" Width="110"/>
                                    <DataGridTextColumn Header="Root State" Binding="{Binding RootState}" Width="150"/>
                                    <DataGridTextColumn Header="In Xact For" Binding="{Binding RootXactDuration}" Width="110"/>
                                    <DataGridTextColumn Header="User" Binding="{Binding RootUsername}" Width="120"/>
                                    <DataGridTextColumn Header="Application" Binding="{Binding RootApplicationName}" Width="160"/>
                                    <DataGridTextColumn Header="Seen As Root" Binding="{Binding SamplesAsRoot}" Width="110"/>
                                    <DataGridTemplateColumn Header="Root Query" Width="320">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding RootQuery}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RootQuery}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Worst Victim Query" Width="320">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding WorstVictimQuery}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorstVictimQuery}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Caveats" Binding="{Binding Caveats}" Width="200"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Expander Grid.Row="2" x:Name="PgBlockingCyclesExpander" Header="Lock cycles (no root — every participant is blocked, so these appear on no chain)"
                                      IsExpanded="False" Margin="0,8,0,0" Foreground="{DynamicResource ForegroundBrush}">
                                <DataGrid x:Name="PgBlockingCyclesGrid" Style="{StaticResource DarkGrid}" MaxHeight="220"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserSortColumns="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Captured" Binding="{Binding CapturedAt}" Width="140"/>
                                        <DataGridTextColumn Header="Participants" Binding="{Binding ParticipantCount}" ElementStyle="{StaticResource NumericCell}" Width="110"/>
                                        <DataGridTextColumn Header="PIDs" Binding="{Binding Pids}" Width="220"/>
                                        <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="150"/>
                                        <DataGridTextColumn Header="Application" Binding="{Binding ApplicationName}" Width="160"/>
                                        <DataGridTextColumn Header="Queued Behind" Binding="{Binding BlockedBehindCount}" ElementStyle="{StaticResource NumericCell}" Width="120"/>
                                        <DataGridTextColumn Header="Queued PIDs" Binding="{Binding BlockedBehindPids}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Expander>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Query Shapes">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- The statement grid is the primary panel and gets twice the height: the
                                     per-database counters below it are the follow-up question (did this
                                     spill?), not a second list of equal standing. -->
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="PgStatementsNote" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
                            <DataGrid Grid.Row="1" x:Name="PgTopQueriesGrid" Style="{StaticResource DarkGrid}"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserSortColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Query ID" Binding="{Binding QueryId}" Width="170"/>
                                    <DataGridTextColumn Header="DB OID" Binding="{Binding DatabaseId}" ElementStyle="{StaticResource NumericCell}" Width="90"/>
                                    <DataGridTextColumn Header="Calls" Binding="{Binding Calls}" ElementStyle="{StaticResource NumericCell}" Width="90"/>
                                    <DataGridTextColumn Header="Total (ms)" Binding="{Binding TotalExecTimeMs}" ElementStyle="{StaticResource NumericCell}" Width="110"/>
                                    <DataGridTextColumn Header="Avg (ms)" Binding="{Binding AvgExecTimeMs}" ElementStyle="{StaticResource NumericCell}" Width="100"/>
                                    <DataGridTextColumn Header="Max (ms)" Binding="{Binding MaxExecTimeMs}" ElementStyle="{StaticResource NumericCell}" Width="100"/>
                                    <DataGridTextColumn Header="Rows" Binding="{Binding RowsReturned}" ElementStyle="{StaticResource NumericCell}" Width="100"/>
                                    <DataGridTextColumn Header="Cache Hit %" Binding="{Binding CacheHitPct}" ElementStyle="{StaticResource NumericCell}" Width="110"/>
                                    <DataGridTextColumn Header="Temp Read" Binding="{Binding TempRead}" Width="120"/>
                                    <DataGridTextColumn Header="Temp Written" Binding="{Binding TempWritten}" Width="120"/>
                                    <DataGridTextColumn Header="Peak Memory" Binding="{Binding PeakMemory}" Width="120"/>
                                    <DataGridTextColumn Header="WAL" Binding="{Binding WalWritten}" Width="110"/>
                                    <DataGridTemplateColumn Header="Statement" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding QueryText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding QueryText}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="2" Text="Per-database counters — where the spills, the deadlocks and the rollbacks are" FontWeight="SemiBold" Margin="0,10,0,2"/>
                            <TextBlock Grid.Row="3" x:Name="PgDatabasesNote" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
                            <DataGrid Grid.Row="4" x:Name="PgDatabaseStatsGrid" Style="{StaticResource DarkGrid}"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserSortColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="180"/>
                                    <DataGridTextColumn Header="Temp Files" Binding="{Binding TempFiles}" ElementStyle="{StaticResource NumericCell}" Width="100"/>
                                    <DataGridTextColumn Header="Temp Bytes" Binding="{Binding TempBytes}" Width="120"/>
                                    <DataGridTextColumn Header="Deadlocks" Binding="{Binding Deadlocks}" ElementStyle="{StaticResource NumericCell}" Width="100"/>
                                    <DataGridTextColumn Header="Cache Hit %" Binding="{Binding CacheHitPct}" ElementStyle="{StaticResource NumericCell}" Width="110"/>
                                    <DataGridTextColumn Header="Commits" Binding="{Binding XactCommit}" ElementStyle="{StaticResource NumericCell}" Width="110"/>
                                    <DataGridTextColumn Header="Rollbacks" Binding="{Binding XactRollback}" ElementStyle="{StaticResource NumericCell}" Width="110"/>
                                    <DataGridTextColumn Header="Rollback %" Binding="{Binding RollbackPct}" ElementStyle="{StaticResource NumericCell}" Width="110"/>
                                    <DataGridTextColumn Header="Samples" Binding="{Binding SampleCount}" ElementStyle="{StaticResource NumericCell}" Width="90"/>
                                    <DataGridTextColumn Header="Stats Reset" Binding="{Binding StatsReset}" Width="140"/>
                                    <DataGridTextColumn Header="Caveats" Binding="{Binding Caveats}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </TabItem>

        <!-- Vacuum (#2530, #2540). FOUR panels now, still one causal chain, still read top to bottom: a
             session holds a transaction open, the transaction holds the xmin horizon, the horizon starves
             vacuum, and vacuum falling behind ends in wraparound.

             Session states is placed FIRST because it is the link UPSTREAM of what used to be panel 1. The
             horizon grid names the CLASS of holder; only this grid names the session, and the fix is always
             in whatever opened that transaction. It is also the only panel that can say a long
             idle-in-transaction session pins NOTHING, which is the correction the rest of the tab cannot
             make and the reason it has to be met before the vacuum backlog below it. -->
        <TabItem x:Name="PgVacuumTab" Header="Vacuum" Visibility="Collapsed">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="PgVacuumNote" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundMutedBrush}"/>

                <TextBlock Grid.Row="1" Text="1. Which session is holding a transaction open — and whether it pins anything at all" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock Grid.Row="2" x:Name="PgSessionStatesNote" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                <DataGrid Grid.Row="3" x:Name="PgSessionStatesGrid" Style="{StaticResource DarkGrid}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserSortColumns="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource DarkGridRow}">
                            <!-- LEAST severe first, so the LAST match wins. The three are not exclusive and
                                 they are not degrees of one thing: amber is a session idle in transaction
                                 that pins NOTHING (a held connection and its locks, costing vacuum zero),
                                 red is a sustained xmin holder (the thing that actually starves vacuum),
                                 and grey outranks both because a redacted row carries no trustworthy state
                                 at all — painting it by a severity would assert exactly what the redaction
                                 denies. -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLongIdleTransaction}" Value="True">
                                    <Setter Property="Background" Value="#33FFB86B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSustainedHorizonHolder}" Value="True">
                                    <Setter Property="Background" Value="#33FF6B6B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StateUnknown}" Value="True">
                                    <Setter Property="Background" Value="#22808080"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" ElementStyle="{StaticResource NumericCell}" Width="80"/>
                        <DataGridTextColumn Header="Backend" Binding="{Binding BackendId}" Width="120"/>
                        <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="130"/>
                        <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="110"/>
                        <DataGridTextColumn Header="Application" Binding="{Binding ApplicationName}" Width="160"/>
                        <DataGridTextColumn Header="Client" Binding="{Binding ClientAddr}" Width="120"/>
                        <DataGridTextColumn Header="Backend Type" Binding="{Binding BackendType}" Width="120"/>
                        <DataGridTextColumn Header="State" Binding="{Binding LastState}" Width="130"/>
                        <!-- Immediately after the state, because it is the column that decides whether the
                             state above it means anything: "pins nothing" here and the long idle duration
                             two columns along is a forgotten commit, not a vacuum problem. -->
                        <DataGridTextColumn Header="Pinned Horizon (peak)" Binding="{Binding PeakHorizonAge}" Width="160"/>
                        <DataGridTextColumn Header="Held Horizon In" Binding="{Binding HorizonHoldShare}" Width="140"/>
                        <DataGridTextColumn Header="Idle In Xact" Binding="{Binding IdleInTransactionShare}" Width="140"/>
                        <DataGridTextColumn Header="Peak Xact" Binding="{Binding PeakXactDuration}" Width="110"/>
                        <DataGridTextColumn Header="Peak State" Binding="{Binding PeakStateDuration}" Width="110"/>
                        <DataGridTextColumn Header="Peak Query" Binding="{Binding PeakQueryDuration}" Width="110"/>
                        <DataGridTextColumn Header="Backend Age" Binding="{Binding BackendAge}" Width="110"/>
                        <DataGridTextColumn Header="Peak xmin Age" Binding="{Binding PeakXminAge}" ElementStyle="{StaticResource NumericCell}" Width="120"/>
                        <DataGridTextColumn Header="Peak XID Age" Binding="{Binding PeakXidAge}" ElementStyle="{StaticResource NumericCell}" Width="120"/>
                        <DataGridTextColumn Header="Last Wait" Binding="{Binding LastWait}" Width="150"/>
                        <DataGridTextColumn Header="Command" Binding="{Binding LastCommandTag}" Width="110"/>
                        <DataGridTextColumn Header="Query ID" Binding="{Binding LastQueryId}" Width="140"/>
                        <DataGridTextColumn Header="Samples" Binding="{Binding SampleCount}" ElementStyle="{StaticResource NumericCell}" Width="90"/>
                        <DataGridTextColumn Header="First Seen" Binding="{Binding FirstSeenAt}" Width="140"/>
                        <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeenAt}" Width="140"/>
                        <DataGridTextColumn Header="On The Instance" Binding="{Binding InstanceContext}" Width="220"/>
                        <DataGridTemplateColumn Header="Caveats" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Caveats}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Caveats}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="4" Text="2. What holds the xmin horizon — vacuum cannot reclaim anything newer than this" FontWeight="SemiBold" Margin="0,10,0,2"/>
                <TextBlock Grid.Row="5" x:Name="PgXminNote" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                <DataGrid Grid.Row="6" x:Name="PgXminHorizonGrid" Style="{StaticResource DarkGrid}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cause" Binding="{Binding Source}" Width="200"/>
                        <DataGridTextColumn Header="Holding Now" Binding="{Binding IsWinnerText}" Width="110"/>
                        <DataGridTextColumn Header="xmin Age" Binding="{Binding XminAge}" ElementStyle="{StaticResource NumericCell}" Width="120"/>
                        <DataGridTextColumn Header="Peak In Window" Binding="{Binding PeakXminAge}" ElementStyle="{StaticResource NumericCell}" Width="130"/>
                        <DataGridTextColumn Header="Held In" Binding="{Binding WinnerShare}" Width="130"/>
                        <DataGridTextColumn Header="Measured" Binding="{Binding MeasuredAt}" Width="140"/>
                        <DataGridTextColumn Header="Holder" Binding="{Binding Holder}" Width="200"/>
                        <DataGridTemplateColumn Header="Detail" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="7" Text="3. Autovacuum backlog — ranked by how far past each table's OWN threshold it is, not by raw dead tuples" FontWeight="SemiBold" Margin="0,10,0,2"/>
                <TextBlock Grid.Row="8" x:Name="PgAutovacuumNote" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                <DataGrid Grid.Row="9" x:Name="PgAutovacuumGrid" Style="{StaticResource DarkGrid}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserSortColumns="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource DarkGridRow}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AutovacuumDisabled}" Value="True">
                                    <Setter Property="Background" Value="#33FF6B6B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="140"/>
                        <DataGridTextColumn Header="Schema" Binding="{Binding SchemaName}" Width="120"/>
                        <DataGridTextColumn Header="Table" Binding="{Binding TableName}" Width="200"/>
                        <DataGridTextColumn Header="Autovacuum" Binding="{Binding AutovacuumState}" Width="110"/>
                        <DataGridTextColumn Header="Dead Tuples" Binding="{Binding DeadTuples}" ElementStyle="{StaticResource NumericCell}" Width="110"/>
                        <DataGridTextColumn Header="Live Tuples" Binding="{Binding LiveTuples}" ElementStyle="{StaticResource NumericCell}" Width="110"/>
                        <DataGridTextColumn Header="Dead %" Binding="{Binding DeadTuplePct}" ElementStyle="{StaticResource NumericCell}" Width="90"/>
                        <DataGridTextColumn Header="Vacuum Threshold" Binding="{Binding VacuumThreshold}" ElementStyle="{StaticResource NumericCell}" Width="140"/>
                        <DataGridTextColumn Header="Past Threshold" Binding="{Binding ThresholdRatio}" Width="120"/>
                        <DataGridTextColumn Header="Dead Trend" Binding="{Binding DeadTupleTrend}" Width="130"/>
                        <DataGridTextColumn Header="Inserts Since Vacuum" Binding="{Binding InsertsSinceVacuum}" ElementStyle="{StaticResource NumericCell}" Width="150"/>
                        <DataGridTextColumn Header="Insert Threshold" Binding="{Binding InsertVacuumThreshold}" Width="130"/>
                        <DataGridTextColumn Header="Mods Since Analyze" Binding="{Binding ModsSinceAnalyze}" ElementStyle="{StaticResource NumericCell}" Width="150"/>
                        <DataGridTextColumn Header="Analyze Threshold" Binding="{Binding AnalyzeThreshold}" ElementStyle="{StaticResource NumericCell}" Width="140"/>
                        <DataGridTextColumn Header="Autovacuum Runs" Binding="{Binding AutovacuumCount}" ElementStyle="{StaticResource NumericCell}" Width="140"/>
                        <DataGridTextColumn Header="Last Autovacuum" Binding="{Binding LastAutovacuum}" Width="140"/>
                        <DataGridTextColumn Header="Last Vacuum" Binding="{Binding LastVacuum}" Width="140"/>
                        <DataGridTextColumn Header="Last Autoanalyze" Binding="{Binding LastAutoanalyze}" Width="140"/>
                        <DataGridTextColumn Header="Last Analyze" Binding="{Binding LastAnalyze}" Width="140"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding TotalSize}" Width="110"/>
                        <DataGridTextColumn Header="Measured" Binding="{Binding MeasuredAt}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="10" Text="4. Freeze headroom — how much transaction-ID space is left before the emergency vacuum, and before a shutdown" FontWeight="SemiBold" Margin="0,10,0,2"/>
                <TextBlock Grid.Row="11" x:Name="PgWraparoundNote" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                <DataGrid Grid.Row="12" x:Name="PgWraparoundGrid" Style="{StaticResource DarkGrid}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="180"/>
                        <DataGridTextColumn Header="Frozen XID Age" Binding="{Binding FrozenXidAge}" ElementStyle="{StaticResource NumericCell}" Width="130"/>
                        <DataGridTextColumn Header="% To Emergency" Binding="{Binding PctTowardEmergencyVacuum}" ElementStyle="{StaticResource NumericCell}" Width="130"/>
                        <DataGridTextColumn Header="% To Wraparound" Binding="{Binding PctTowardWraparound}" ElementStyle="{StaticResource NumericCell}" Width="130"/>
                        <DataGridTextColumn Header="XIDs Left" Binding="{Binding XidsRemaining}" ElementStyle="{StaticResource NumericCell}" Width="130"/>
                        <DataGridTextColumn Header="Freeze Max Age" Binding="{Binding FreezeMaxAge}" ElementStyle="{StaticResource NumericCell}" Width="130"/>
                        <DataGridTextColumn Header="MultiXID Age" Binding="{Binding MinMultiXidAge}" ElementStyle="{StaticResource NumericCell}" Width="130"/>
                        <DataGridTextColumn Header="% To MultiXID Emergency" Binding="{Binding PctTowardMultixactEmergency}" ElementStyle="{StaticResource NumericCell}" Width="170"/>
                        <DataGridTextColumn Header="% To MultiXID Wraparound" Binding="{Binding PctTowardMultixactWraparound}" ElementStyle="{StaticResource NumericCell}" Width="180"/>
                        <DataGridTextColumn Header="MultiXIDs Left" Binding="{Binding MultiXidsRemaining}" ElementStyle="{StaticResource NumericCell}" Width="130"/>
                        <DataGridTextColumn Header="MultiXID Freeze Max Age" Binding="{Binding MultixactFreezeMaxAge}" ElementStyle="{StaticResource NumericCell}" Width="170"/>
                        <DataGridTextColumn Header="Peak XID Age" Binding="{Binding WindowPeakFrozenXidAge}" ElementStyle="{StaticResource NumericCell}" Width="130"/>
                        <DataGridTextColumn Header="Peak MultiXID Age" Binding="{Binding WindowPeakMinMultiXidAge}" ElementStyle="{StaticResource NumericCell}" Width="150"/>
                        <DataGridTextColumn Header="Connections" Binding="{Binding ConnectionsAllowed}" Width="120"/>
                        <DataGridTextColumn Header="Measured" Binding="{Binding MeasuredAt}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            
                <TextBlock Grid.Row="13" Text="5. Can this server capture execution plans at all — and if not, which step is missing" FontWeight="SemiBold" Margin="0,10,0,2"/>
                <TextBlock Grid.Row="14" x:Name="PgPlanCaptureNote" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                <DataGrid Grid.Row="15" x:Name="PgPlanCaptureGrid" Style="{StaticResource DarkGrid}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserSortColumns="True"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Facet" Binding="{Binding Facet}" Width="170"/>
                        <DataGridTextColumn Header="Satisfied" Binding="{Binding Satisfied}" Width="80"/>
                        <DataGridTextColumn Header="Observed" Binding="{Binding Observed}" Width="240"/>
                        <DataGridTextColumn Header="What it means / what to do" Binding="{Binding Detail}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem x:Name="PgWaitsTab" Header="Waits" Visibility="Collapsed">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="PgWaitsNote" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                <DataGrid Grid.Row="1" x:Name="PgWaitStatsGrid" Style="{StaticResource DarkGrid}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Wait Type" Binding="{Binding WaitType}" Width="200"/>
                        <DataGridTextColumn Header="Wait Event" Binding="{Binding WaitEvent}" Width="260"/>
                        <DataGridTextColumn Header="Waits" Binding="{Binding TotalWaits}" ElementStyle="{StaticResource NumericCell}" Width="120"/>
                        <DataGridTextColumn Header="Total Wait (ms)" Binding="{Binding TotalWaitTimeMs}" ElementStyle="{StaticResource NumericCell}" Width="140"/>
                        <DataGridTextColumn Header="Avg Wait (ms)" Binding="{Binding AvgWaitTimeMs}" ElementStyle="{StaticResource NumericCell}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem x:Name="PgIoTab" Header="I/O" Visibility="Collapsed">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="PgIoNote" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                <DataGrid Grid.Row="1" x:Name="PgIoStatsGrid" Style="{StaticResource DarkGrid}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Backend" Binding="{Binding BackendType}" Width="160"/>
                        <DataGridTextColumn Header="Object" Binding="{Binding ObjectType}" Width="140"/>
                        <!-- The context's MEANING rides as the cell tooltip. It is the dimension with no SQL
                             Server counterpart and the one that changes the remedy, but it is a paragraph;
                             one copy, from the shared reader that produces the value. -->
                        <DataGridTemplateColumn Header="Context" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Context}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ContextMeaning}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Reads" Binding="{Binding Reads}" ElementStyle="{StaticResource NumericCell}" Width="110"/>
                        <DataGridTextColumn Header="Read Time (ms)" Binding="{Binding ReadTimeMs}" ElementStyle="{StaticResource NumericCell}" Width="130"/>
                        <DataGridTextColumn Header="Avg Read (ms)" Binding="{Binding AvgReadMs}" ElementStyle="{StaticResource NumericCell}" Width="120"/>
                        <DataGridTextColumn Header="% Read Time" Binding="{Binding PctOfTotalReadTime}" ElementStyle="{StaticResource NumericCell}" Width="110"/>
                        <DataGridTextColumn Header="Hits" Binding="{Binding Hits}" ElementStyle="{StaticResource NumericCell}" Width="110"/>
                        <DataGridTextColumn Header="Hit %" Binding="{Binding HitPct}" ElementStyle="{StaticResource NumericCell}" Width="90"/>
                        <DataGridTextColumn Header="Extends" Binding="{Binding Extends}" ElementStyle="{StaticResource NumericCell}" Width="100"/>
                        <DataGridTextColumn Header="Extend Time (ms)" Binding="{Binding ExtendTimeMs}" ElementStyle="{StaticResource NumericCell}" Width="140"/>
                        <DataGridTextColumn Header="Evictions" Binding="{Binding Evictions}" ElementStyle="{StaticResource NumericCell}" Width="110"/>
                        <DataGridTextColumn Header="Reuses" Binding="{Binding Reuses}" ElementStyle="{StaticResource NumericCell}" Width="100"/>
                        <DataGridTextColumn Header="Writes" Binding="{Binding Writes}" Width="120"/>
                        <DataGridTextColumn Header="Write Time (ms)" Binding="{Binding WriteTimeMs}" Width="130"/>
                        <DataGridTextColumn Header="Op Size" Binding="{Binding OpSize}" Width="100"/>
                        <DataGridTextColumn Header="Stats Reset" Binding="{Binding StatsReset}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- #2544 write side. A metric PER ROW rather than one very wide row: the three source
                     views are cluster-wide singletons, so a snapshot is a single row of 26 counters, and a
                     26-column grid one row deep is unreadable and unsortable. Per-row also gives each
                     metric somewhere to carry its own note, which matters here because several are NULL for
                     a version reason rather than an absence-of-activity reason. -->
                <TextBlock Grid.Row="2" x:Name="PgWriteStatsNote" FontSize="12" Margin="0,10,0,6" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                <DataGrid Grid.Row="3" x:Name="PgWriteStatsGrid" Style="{StaticResource DarkGrid}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="130"/>
                        <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="230"/>
                        <DataGridTextColumn Header="Change Over Window" Binding="{Binding Value}" ElementStyle="{StaticResource NumericCell}" Width="180"/>
                        <DataGridTextColumn Header="What It Means" Binding="{Binding Note}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem x:Name="PgReplicationTab" Header="Replication" Visibility="Collapsed">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="PgReplicationNote" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                <DataGrid Grid.Row="1" x:Name="PgReplicationSlotsGrid" Style="{StaticResource DarkGrid}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserSortColumns="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource DarkGridRow}">
                            <!-- LEAST severe first. Both triggers set Background and WPF applies the LAST
                                 match, and these two are not exclusive: an invalidated slot is usually also
                                 inactive, because its subscriber has already gone. Declaring inactive last
                                 would paint the informational amber over the red on exactly the rows that
                                 need the red. -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInactive}" Value="True">
                                    <Setter Property="Background" Value="#33FFB86B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsInvalidated}" Value="True">
                                    <Setter Property="Background" Value="#33FF6B6B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Slot" Binding="{Binding SlotName}" Width="200"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding SlotType}" Width="110"/>
                        <DataGridTextColumn Header="Active" Binding="{Binding ActiveText}" Width="90"/>
                        <DataGridTextColumn Header="WAL Status" Binding="{Binding WalStatus}" Width="120"/>
                        <DataGridTextColumn Header="Conflicting" Binding="{Binding Conflicting}" Width="110"/>
                        <DataGridTextColumn Header="Retained WAL" Binding="{Binding RetainedWal}" Width="130"/>
                        <DataGridTextColumn Header="Retained Trend" Binding="{Binding RetainedWalTrend}" Width="140"/>
                        <DataGridTextColumn Header="Safe WAL Left" Binding="{Binding SafeWalSize}" Width="130"/>
                        <DataGridTextColumn Header="xmin Age" Binding="{Binding XminAge}" ElementStyle="{StaticResource NumericCell}" Width="110"/>
                        <DataGridTextColumn Header="Catalog xmin Age" Binding="{Binding CatalogXminAge}" ElementStyle="{StaticResource NumericCell}" Width="140"/>
                        <DataGridTextColumn Header="Inactive Since" Binding="{Binding InactiveSince}" Width="140"/>
                        <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="140"/>
                        <DataGridTextColumn Header="Plugin" Binding="{Binding Plugin}" Width="140"/>
                        <DataGridTextColumn Header="Invalidation" Binding="{Binding InvalidationReason}" Width="220"/>
                        <DataGridTextColumn Header="Measured" Binding="{Binding MeasuredAt}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <!-- Storage (#2541, #2542). Two grids, bloat above index usage: the bloat number is an ESTIMATE
             and the more dangerous of the two to act on, so it is read first and its note says so before
             any percentage is visible. -->
        <TabItem x:Name="PgStorageTab" Header="Storage" Visibility="Collapsed">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="PgStorageNote" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                <TextBlock Grid.Row="1" x:Name="PgTableBloatNote" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                <DataGrid Grid.Row="2" x:Name="PgTableBloatGrid" Style="{StaticResource DarkGrid}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserSortColumns="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource DarkGridRow}">
                            <!-- A SUPPRESSED estimate is painted last and therefore wins, because it is not
                                 a severity at all: the row has no trustworthy percentage, and colouring it
                                 by one would be the exact mistake this whole surface exists to avoid. -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHighBloat}" Value="True">
                                    <Setter Property="Background" Value="#33FF6B6B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EstimateSuppressed}" Value="True">
                                    <Setter Property="Background" Value="#22808080"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="130"/>
                        <DataGridTextColumn Header="Schema" Binding="{Binding SchemaName}" Width="110"/>
                        <DataGridTextColumn Header="Table" Binding="{Binding TableName}" Width="180"/>
                        <DataGridTextColumn Header="Heap" Binding="{Binding HeapSize}" Width="100"/>
                        <DataGridTextColumn Header="Bloat (est.)" Binding="{Binding BloatEstimate}" Width="120"/>
                        <DataGridTextColumn Header="Bloat % (est.)" Binding="{Binding BloatPctEstimate}" Width="120"/>
                        <DataGridTextColumn Header="Dead Tuples" Binding="{Binding DeadTuplePct}" Width="120"/>
                        <DataGridTextColumn Header="TOAST" Binding="{Binding ToastSize}" Width="100"/>
                        <DataGridTextColumn Header="Indexes" Binding="{Binding IndexSize}" Width="100"/>
                        <DataGridTextColumn Header="Heap Growth" Binding="{Binding HeapGrowth}" Width="120"/>
                        <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="3" x:Name="PgIndexUsageNote" FontSize="12" Margin="0,10,0,6" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                <DataGrid Grid.Row="4" x:Name="PgIndexUsageGrid" Style="{StaticResource DarkGrid}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserSortColumns="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource DarkGridRow}">
                            <!-- LEAST severe first, so the LAST match wins. An index can be both unscanned
                                 and invalid; invalid is the stronger statement and must not be painted over
                                 by the softer amber. -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnscanned}" Value="True">
                                    <Setter Property="Background" Value="#33FFB86B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                    <Setter Property="Background" Value="#33FF6B6B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="130"/>
                        <DataGridTextColumn Header="Table" Binding="{Binding TableName}" Width="160"/>
                        <DataGridTextColumn Header="Index" Binding="{Binding IndexName}" Width="200"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding IndexSize}" Width="100"/>
                        <DataGridTextColumn Header="Scans in Window" Binding="{Binding ScansInWindow}" ElementStyle="{StaticResource NumericCell}" Width="130"/>
                        <DataGridTextColumn Header="Lifetime Scans" Binding="{Binding TotalScans}" ElementStyle="{StaticResource NumericCell}" Width="130"/>
                        <DataGridTextColumn Header="Last Scan" Binding="{Binding LastScan}" Width="140"/>
                        <DataGridTextColumn Header="Blocks" Binding="{Binding BlockAccesses}" ElementStyle="{StaticResource NumericCell}" Width="110"/>
                        <DataGridTextColumn Header="Samples" Binding="{Binding SampleCount}" ElementStyle="{StaticResource NumericCell}" Width="90"/>
                        <DataGridTextColumn Header="Can It Go?" Binding="{Binding Droppability}" Width="220"/>
                        <DataGridTextColumn Header="Definition" Binding="{Binding IndexDefinition}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
    </TabControl>
    </Grid>
</UserControl>
