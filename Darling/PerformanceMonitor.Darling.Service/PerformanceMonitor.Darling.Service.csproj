<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>PerformanceMonitor.Darling.Service</RootNamespace>
    <AssemblyName>PerformanceMonitor.Darling.Service</AssemblyName>
    <Company>Darling Data, LLC</Company>
    <Copyright>Copyright © 2026 Darling Data, LLC</Copyright>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- #5796: true when this build targets Windows, which gates the three PowerShell scripts below. -->
    <DarlingShipsWindowsScripts>false</DarlingShipsWindowsScripts>
    <DarlingShipsWindowsScripts Condition="$(RuntimeIdentifier.StartsWith('win'))">true</DarlingShipsWindowsScripts>
    <DarlingShipsWindowsScripts Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">true</DarlingShipsWindowsScripts>
    <WarningsAsErrors>CS4014</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- #6365: SqlClient follows a mirroring partner the SERVER names, and that name gets no tcp: prefix (named pipe over SMB
         with the process's Windows credentials). This writes the switch into runtimeconfig.json so it is set before any code
         runs; ServerHostSetting also sets it in a static constructor as a backup. -->
    <RuntimeHostConfigurationOption Include="Switch.Microsoft.Data.SqlClient.IgnoreServerProvidedFailoverPartner" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.PI" />
    <PackageReference Include="AWSSDK.RDS" />
    <PackageReference Include="AWSSDK.SecurityToken" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- #5802: lifts the transitive System.Security.Cryptography.Pkcs off SqlClient's vulnerable 9.0.18; see Directory.Packages.props. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <!-- #3838: the Entra (Active Directory) authentication providers were split OUT of the core
         Microsoft.Data.SqlClient package in 7.x, so a project that sets
         SqlAuthenticationMethod.ActiveDirectory* on a connection string and does NOT carry this
         package opens with "Cannot find an authentication provider for '...'" - which is exactly
         what a service-principal target reported. The core driver finds the provider by the
         assembly's PRESENCE in the dependency closure: measured against 7.0.3, GetProvider returns
         null for every AAD method without it and ActiveDirectoryAuthenticationProvider with it, so
         there is no registration call to make and nothing to wire at startup. The version is already
         pinned centrally (Lite has carried this reference since the 7.0 bump), which is why this line
         is the whole fix. THIS project is where the reference has to be: every SQL Server connection
         the collector opens is here, and so is the test_connect command the Viewer's Test Connection
         button enqueues rather than opening itself. -->
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <!-- Restrictive ACLs on the DPAPI credential files (the data dir parent, the *.dpapi files, the
         transient init pwfile). Windows-only, like every credential surface here; the extension
         methods (GetAccessControl/SetAccessControl/SetOwner) live in this package on a net10.0
         (non-windows) TFM, which the service keeps so bring-your-own mode still runs cross-platform. -->
    <PackageReference Include="System.IO.FileSystem.AccessControl" />
    <!-- AN4: the analysis MCP tools over Streamable HTTP — Lite's exact MCP stack/version.
         The AspNetCore package brings the Microsoft.AspNetCore.App framework reference
         (Kestrel/WebApplication) transitively, same as it does for Lite. -->
    <PackageReference Include="BlackwellSystems.Gcf" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PerformanceMonitor.Alerting\PerformanceMonitor.Alerting.csproj" />
    <ProjectReference Include="..\..\PerformanceMonitor.Common\PerformanceMonitor.Common.csproj" />
    <ProjectReference Include="..\..\PerformanceMonitor.Collectors\PerformanceMonitor.Collectors.csproj" />
    <!-- AN3: the analysis pipeline (DarlingAnalysisService/PgPlanFetcher). Dependency points
         service → analysis only; the analysis library never references the service. -->
    <ProjectReference Include="..\PerformanceMonitor.Darling.Analysis\PerformanceMonitor.Darling.Analysis.csproj" />
    <!-- The plan-analysis MCP tools run the SHARED ShowPlanParser/PlanAnalyzer and serialize via
         McpPlanAnalysisFormatter (the same projection both apps' McpPlanTools call). Referenced
         directly (it also flows transitively through Darling.Analysis) since it is a direct dependency. -->
    <ProjectReference Include="..\..\PerformanceMonitor.PlanAnalysis\PerformanceMonitor.PlanAnalysis.csproj" />
    <ProjectReference Include="..\PerformanceMonitor.Darling.Storage\PerformanceMonitor.Darling.Storage.csproj" />
    <!-- #5632 step 7: the write code for force_query_store_plan and unforce_query_store_plan. Only DarlingMcpPlanForceTools may use it
         (PlanForceNoWritePathTests pins that, and that this assembly still holds none of the three write statements). -->
    <ProjectReference Include="..\PerformanceMonitor.Darling.Remediation\PerformanceMonitor.Darling.Remediation.csproj" />
    <!-- #3833: the triage page reads the AlertFamily census to decide whether a metric is a fleet-level
         store alert, so the taxonomy every new alert must be registered in is what selects its sections.
         Flows transitively through Alerting/Analysis already; named directly because it is now a direct
         dependency of this project's own code. -->
    <ProjectReference Include="..\..\PerformanceMonitor.Notifications\PerformanceMonitor.Notifications.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="darling.sample.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- #1562: the web dashboard's static assets (Builder 3 owns wwwroot/). Copied beside the binary so the
         web host's content/web root (pinned to AppContext.BaseDirectory) finds them under a Windows service. -->
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The install/uninstall/upgrade scripts ride the publish output to the ZIP ROOT (beside the exe), so
         both the release and nightly zips carry them with no packaging-workflow changes - same delivery
         mechanism as darling.sample.json.
         upgrade-darling.ps1 has to be here for a second reason (#2525): the service's install-directory
         report tells operators to prune rollback backups with `upgrade-darling.ps1 -PruneOnly`, and advice
         naming a file that is not on the box is worse than no advice. DarlingDeployRollbackRetentionTests
         pins this line for exactly that.
         #5796: they ship to Windows only. They are Authenticode-signed in the Windows zip, and the Linux
         publish (the tarball and the container image) has no use for them, so a Windows RID, or no RID on a
         Windows build machine (the release and nightly zips publish without one), is the condition. The
         Linux release job asserts its tarball holds no .ps1. -->
    <None Include="..\tools\install-darling.ps1" Link="install-darling.ps1" CopyToOutputDirectory="PreserveNewest" Condition="$(DarlingShipsWindowsScripts)" />
    <None Include="..\tools\uninstall-darling.ps1" Link="uninstall-darling.ps1" CopyToOutputDirectory="PreserveNewest" Condition="$(DarlingShipsWindowsScripts)" />
    <None Include="..\tools\upgrade-darling.ps1" Link="upgrade-darling.ps1" CopyToOutputDirectory="PreserveNewest" Condition="$(DarlingShipsWindowsScripts)" />
    <!-- #6469: the double-click launcher for install-darling.ps1. A .cmd is not Authenticode-signed with the scripts; it only
         starts PowerShell elevated with the execution policy bypassed for that one process. -->
    <None Include="..\tools\Install-Darling.cmd" Link="Install-Darling.cmd" CopyToOutputDirectory="PreserveNewest" Condition="$(DarlingShipsWindowsScripts)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Darling.Tests" />
  </ItemGroup>
</Project>
