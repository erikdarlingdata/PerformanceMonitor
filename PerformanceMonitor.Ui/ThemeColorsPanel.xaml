<UserControl x:Class="PerformanceMonitor.Ui.ThemeColorsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      #3577 (arm B): the "Colors" section of both apps' Settings windows — one row per adjustable palette
      color of the CURRENT theme, with a swatch, the hex, a picker button and the measured contrast ratio
      against the surface the color renders on. Hosted by Lite's SettingsWindow and the Darling viewer's,
      one line each, so the two apps share one copy of the control and cannot drift.

      The rows are built in code from ThemeColorOverrides.Slots rather than written out here: twelve rows
      of five controls, whose labels, groups and contrast partners are already declared once on the slot
      list, would be a second copy of that list for the XAML to fall out of step with.

      The three buttons carry NO Alt mnemonics on purpose. This control shares its host window's
      access-key scope, and both Settings windows have already spent every natural letter — A (_Auto),
      C (_Close), R (_Restore Defaults), S (_Save), O (Aut_o, Darling), D, F, E, T, L, P, Y — so the only
      keys left for "Apply", "Reset", "Open" would sit on letters nobody would guess. A mnemonic on the
      wrong letter is a worse affordance than none (the same reasoning as "Pause Co_llection"'s comment
      in Lite's SettingsWindow.xaml), and a duplicate would turn Alt+letter into "move focus".
    -->
    <StackPanel>
        <!-- "Dark theme — stock palette" / "Dark theme — 3 overrides in effect"; the host's Expander
             header says "Colors", so this line names the theme rather than repeating the word. -->
        <TextBlock x:Name="ThemeNameText" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource ForegroundBrush}"/>
        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,8"
                   Foreground="{DynamicResource ForegroundMutedBrush}"
                   Text="The twelve palette colors this theme is built from; every surface in the app follows them. Each row measures the color against the surface it renders on: 4.50:1 or better reads as text (green), 3.00–4.49 as a marker only (amber), below 3.00 is hard to see (red). The readout warns; Apply always works."/>

        <!-- Swatch | label | hex | picker | contrast readout. Rows added in code. -->
        <Grid x:Name="RowsGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
        </Grid>

        <TextBlock x:Name="ContrastNote" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                   Foreground="{DynamicResource WarningTextBrush}" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="ApplyButton" Content="Apply colors" Click="ApplyButton_Click"
                    ToolTip="Write these colors to theme-overrides.json and apply them now, without a restart."/>
            <Button x:Name="ResetButton" Content="Reset to default" Margin="8,0,0,0" Click="ResetButton_Click"
                    ToolTip="Remove this theme's overrides from theme-overrides.json and return it to the stock palette. Other themes' overrides are untouched."/>
            <Button x:Name="OpenFileButton" Content="Open file" Margin="8,0,0,0" Click="OpenFileButton_Click"
                    ToolTip="Open theme-overrides.json in your default editor. Saved edits apply live."/>
            <TextBlock x:Name="StatusText" FontSize="11" FontStyle="Italic" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
        </StackPanel>
        <TextBlock x:Name="PathText" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"
                   Foreground="{DynamicResource ForegroundMutedBrush}"/>

        <!-- The picker: three sliders over HsvColor and a live swatch. Opened beside the row's button;
             every slider move writes the hex straight into that row's text box, so the row, its swatch
             and its contrast readout follow the slider and nothing is applied until Apply. -->
        <Popup x:Name="PickerPopup" StaysOpen="False" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource BackgroundLightBrush}" BorderBrush="{DynamicResource BorderLightBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,2,6,6">
                <StackPanel Width="230">
                    <Border x:Name="PickerPreview" Height="26" CornerRadius="3" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderLightBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Hue" FontSize="11" Foreground="{DynamicResource ForegroundDimBrush}"/>
                    <Slider x:Name="HueSlider" Minimum="0" Maximum="359" ValueChanged="PickerSlider_ValueChanged" Margin="0,2,0,6"/>
                    <TextBlock Text="Saturation" FontSize="11" Foreground="{DynamicResource ForegroundDimBrush}"/>
                    <Slider x:Name="SaturationSlider" Minimum="0" Maximum="100" ValueChanged="PickerSlider_ValueChanged" Margin="0,2,0,6"/>
                    <TextBlock Text="Brightness" FontSize="11" Foreground="{DynamicResource ForegroundDimBrush}"/>
                    <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" ValueChanged="PickerSlider_ValueChanged" Margin="0,2,0,6"/>
                    <TextBlock x:Name="PickerHexText" FontSize="11" FontFamily="Consolas"
                               Foreground="{DynamicResource ForegroundBrush}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
