<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>PerformanceMonitor.Collectors</RootNamespace>
    <AssemblyName>PerformanceMonitor.Collectors</AssemblyName>
    <Company>Darling Data, LLC</Company>
    <Copyright>Copyright © 2026 Darling Data, LLC</Copyright>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <WarningsAsErrors>CS4014</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- #4748: the partial-database-failure note text lives in Common, beside the health band that reads it back. -->
    <ProjectReference Include="..\PerformanceMonitor.Common\PerformanceMonitor.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- #4053 c3: the RDS plan ingestor calls PgPlanCaptureCollector.PlanRowsFromCsvEntries, which is internal
         because it is sound only over csv-parser entries (see its remarks). -->
    <InternalsVisibleTo Include="PerformanceMonitor.Darling.Service" />
    <!-- #4058 r3: PgLogEntryProvenanceTests exercises RaisedByPlpgsql/ReportedByOther directly. -->
    <InternalsVisibleTo Include="Darling.Tests" />
    <!-- #4496: Lite's RemoteCollectorService.DefinitionRunner calls JobHistoryCollector.ToMicroseconds
         to normalise the stored-side natural key the same way Darling does. -->
    <InternalsVisibleTo Include="PerformanceMonitorLite" />
    <InternalsVisibleTo Include="Lite.Tests" />
  </ItemGroup>
</Project>
