<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CompactionRepro</RootNamespace>
    <AssemblyName>CompactionRepro</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- The DuckDB the repro runs on: 1.5.3 by default (its original), -p:ReproDuckDbVersion=1.5.6.1 for the one Lite ships. -->
    <ReproDuckDbVersion Condition="'$(ReproDuckDbVersion)' == ''">1.5.3</ReproDuckDbVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DuckDB.NET.Data" VersionOverride="$(ReproDuckDbVersion)" />
    <PackageReference Include="DuckDB.NET.Bindings.Full" VersionOverride="$(ReproDuckDbVersion)" />
  </ItemGroup>

  <!-- Link the real production compaction code so the reproducer exercises the
       exact merge path ArchiveService runs. Do NOT re-copy this logic here —
       the whole point of #933's repro rework is that the repro stops drifting
       from production. -->
  <ItemGroup>
    <Compile Include="..\..\Lite\Services\ParquetCompaction.cs" Link="ParquetCompaction.cs" />
  </ItemGroup>
</Project>
