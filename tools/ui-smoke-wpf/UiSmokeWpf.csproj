<Project Sdk="Microsoft.NET.Sdk">
  <!-- #5745: the WPF smoke check. Starts the real Lite exe on a seeded data folder and walks it with FlaUI (UI Automation).
       Kept out of Lite.Tests and Darling.Tests on purpose (no test shard runs it; the wpf-smoke workflow does), and out of
       PerformanceMonitor.sln. The lock file is covered by a locked-mode restore in build.yml
       (LockedModeRestoreCoverageTests). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>UiSmokeWpf</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- NU1701: CredentialManagement and SkiaSharp.Views.WPF (reached through Lite) have no .NET 10 build. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The seed comes from the same scenarios the analysis tests use (TestDataSeeder), compiled in rather than copied. -->
    <ProjectReference Include="..\..\Lite\PerformanceMonitorLite.csproj" />
    <Compile Include="..\..\Lite.Tests\TestDataSeeder.cs" Link="TestDataSeeder.cs" />
  </ItemGroup>
</Project>
