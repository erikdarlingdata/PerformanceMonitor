<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- #2347: xunit.v3 under Microsoft.Testing.Platform builds the suite as its own executable. -->
    <OutputType>Exe</OutputType>
    <!-- xUnit1051 (use TestContext.Current.CancellationToken): a per-call-site style nag across
         hundreds of short-lived test calls; suppressed like CS4014 rather than threading the
         ambient token through every call. -->
    <NoWarn>CA1849;CA2007;CA1508;CA1822;CA1805;CA1510;CA1816;CA1861;CA1845;CA2201;CS4014;NU1701;CA1001;CA1848;CA1852;CA1305;CA1860;CA1707;CA1507;CA1806;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- #3134: LocalDataService.OpenWriteConnectionAsync bounds its write-lock wait so a WPF dispatcher
         cannot freeze behind an archival. There is no dispatcher in this host, and the lock on
         DuckDbInitializer is process-wide - so a store test waits behind every other class in the suite,
         including the test methods that take the exclusive lock deliberately and hold it for seconds
         while they assert on timing. A budget sized for a dispatcher, expiring inside a hold taken by a
         neighbour, is a failure with no user behind it; so this host states a budget orders of magnitude
         larger and the acquisition waits the hold out. Short of forever on purpose - a wedged lock still
         fails, with the same message, rather than hanging the suite. The shipped app declares nothing
         here and keeps LocalDataService.DefaultWriteLockBudget. -->
    <RuntimeHostConfigurationOption Include="PerformanceMonitorLite.WriteLockBudgetSeconds" Value="120" />
    <!-- #5596: WPF builds one WeakEventTable per STA thread that touches a WeakEventManager, and each table
         registers a ProcessExit handler. At exit that handler runs on the main thread, and when the table's
         own thread is gone it asks the dead dispatcher to purge the table with a 300 ms timeout nobody ever
         answers: about 0.3 seconds per STA test thread, spent after the run has returned. About fifty test files
         start their own STA thread, so the exit stage grew past the 11 seconds xUnit v3 gives a process after the
         run returns, and the runner printed "Foreground threads were left running" with exit code 1 and 0 failed
         tests. This WPF switch (WindowsBase, BaseAppContextSwitches) makes the handler purge the table directly.
         WpfExitSwitchTests pins that the switch is set, and that the runtime still knows its name. -->
    <RuntimeHostConfigurationOption Include="Switch.MS.Internal.DoNotInvokeInWeakEventTableShutdownListener" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared C# source walk (#2913), compiled into this assembly rather than copied into it. Lite.Tests
         cannot ProjectReference Darling.Tests - both are xunit executables and CI would discover the Darling
         suite twice - and a second COPY is the exact thing #2913 removed: five pins each carried their own
         walk, they drifted, and only one of them had grown the newline stop that bounds a mis-read literal.
         One file, one authority, no parity pin needed because there is nothing to keep in parity. It brings
         its Darling.Tests namespace with it, which is why the two adopters here carry a `using Darling.Tests`.
         Its own coverage stays in Darling.Tests/CSharpSourceWalkerTests.cs - the implementation Lite compiles
         is byte-identical to the one those tests exercise. -->
    <Compile Include="..\Darling\Darling.Tests\CSharpSourceWalker.cs" Link="CSharpSourceWalker.cs" />
    <!-- The in-process MCP server and client (a real call through the shared call-tool guard and the SDK's
         binder), linked for the same reason: one harness, so the two SKUs' whole-number pins run the same path. -->
    <Compile Include="..\Darling\Darling.Tests\McpInProcessHost.cs" Link="McpInProcessHost.cs" />
    <!-- The per-type argument table and its test-only probe tool, shared for the same reason: both SKUs run one
         table of values through the same real call path. -->
    <Compile Include="..\Darling\Darling.Tests\McpArgumentTypeRows.cs" Link="McpArgumentTypeRows.cs" />
    <!-- #4348: the statement-filter canary plan and its needles, shared so both SKUs' plan tools are held to the same text. -->
    <Compile Include="..\Darling\Darling.Tests\StatementScrubCanary.cs" Link="StatementScrubCanary.cs" />
    <!-- #5459: the guard-stage scanner, so both suites tag their guard classes by one detector. -->
    <Compile Include="..\Darling\Darling.Tests\GuardStageScanner.cs" Link="GuardStageScanner.cs" />
    <!-- #5602 (was #5559's WpfStaGate): the one shared STA thread every WPF test body runs on, and the gate that keeps one body in at a time. -->
    <Compile Include="..\Darling\Darling.Tests\StaTestThread.cs" Link="StaTestThread.cs" />
    <!-- #5602: the timing scanner, so both suites keep a clock-starting class in the one `timing` collection by one detector. -->
    <Compile Include="..\Darling\Darling.Tests\TimingTestScanner.cs" Link="TimingTestScanner.cs" />
    <!-- #5596: the test that proves this process runs with the WPF exit switch on (the switch itself is declared above), so both suites check their own process. -->
    <Compile Include="..\Darling\Darling.Tests\WpfExitSwitchTests.cs" Link="WpfExitSwitchTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lite\PerformanceMonitorLite.csproj" />
    <ProjectReference Include="..\PerformanceMonitor.Notifications\PerformanceMonitor.Notifications.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- system_health event samples (one per feeder event; shapes per sp_HealthParser xpath) for the
         System Events reader round-trip tests. Mirrors Darling.Tests' Fixtures\SystemHealth set. -->
    <None Include="Fixtures\SystemHealth\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Lite's MCP host source, copied beside the test binary (it lives outside this project directory, so the
         default Compile glob never sees it) so HostHeaderGuardTests can pin that the #1648 DNS-rebinding
         middleware is installed FIRST, ahead of MapMcp. Mirrors Darling.Tests' guard on its two hosts — the
         defect was a wiring omission in both apps, and only the wiring can regress. -->
    <None Include="..\Lite\Mcp\McpHostService.cs" Link="Fixtures\McpHostService.cs" CopyToOutputDirectory="PreserveNewest" />
    <!-- The three services that build DuckDB COPY/read_parquet path literals, so DataImportPathEscapingTests
         can pin that none of them interpolates a path without EscapeSqlPath. DataImportService was the one
         that had drifted from its siblings, and a forgotten call is only visible in the source. -->
    <None Include="..\Lite\Services\DataImportService.cs" Link="Fixtures\DataImportService.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Lite\Services\ArchiveService.cs" Link="Fixtures\ArchiveService.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Lite\Services\ParquetCompaction.cs" Link="Fixtures\ParquetCompaction.cs" CopyToOutputDirectory="PreserveNewest" />

    <!-- #2418: the settings.json reference and the two files that read settings.json, so
         SettingsSampleTests can derive the key list from the shipped loaders rather than a copy of
         it. A hand-maintained key list here would be a third thing to keep in sync, and would rot
         exactly the way the sample it guards did. -->
    <None Include="..\Lite\config\settings.sample.json" Link="Fixtures\settings.sample.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Lite\App.xaml.cs" Link="Fixtures\App.xaml.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Lite\Mcp\McpSettings.cs" Link="Fixtures\McpSettings.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
