<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4215.2"><BatchSequence><Batch><Statements><StmtSimple StatementText="CREATE procedure rpt.OrderTotalsByDate&#xd;&#xa;    @TenantId int,&#xd;&#xa;    @FromDate datetime,&#xd;&#xa;    @ToDate datetime,&#xd;&#xa;    @SelectedLocationIds ListOfInt READONLY&#xd;&#xa;as&#xd;&#xa;SET NOCOUNT ON&#xd;&#xa;&#xd;&#xa;/*&#xd;&#xa;TICKET-1: from OrderTotalsByDateOld, with two changes and nothing else.&#xd;&#xa;&#xd;&#xa;  1. GetSoldItemsV1 -&gt; GetSoldItemsV2.&#xd;&#xa;  2. Receiving temp table renamed #items -&gt; #inventory_shared, so V5&apos;s guard&#xd;&#xa;     clause inserts into it directly instead of marshaling the rowset through&#xd;&#xa;     an INSERT...EXEC worktable. @LocId is NULL (multi-location report).&#xd;&#xa;&#xd;&#xa;Output is row- and column-identical to OrderTotalsByDateOld.&#xd;&#xa;*/&#xd;&#xa;&#xd;&#xa;" StatementId="1" StatementCompId="2" StatementType="SET ON/OFF" RetrievedFromCache="true"></StmtSimple><StmtSimple StatementText="DECLARE @tzLoc INT&#xd;&#xa;&#xd;&#xa;    SELECT @tzLoc = MIN(n) FROM @SelectedLocationIds" StatementId="2" StatementCompId="3" StatementType="SELECT" RetrievedFromCache="true" StatementSubTreeCost="0.0032842" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x9F52FA938E1C6C35" QueryPlanHash="0xFD1ABB424011422E" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="true" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan NonParallelPlanReason="MaxDOPSetToOne" CachedPlanSize="16" CompileTime="0" CompileCPU="0" CompileMemory="360"><MemoryGrantInfo SerialRequiredMemory="0" SerialDesiredMemory="0" GrantedMemory="0" MaxUsedMemory="0"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="2860492" EstimatedPagesCached="715123" EstimatedAvailableDegreeOfParallelism="1" MaxCompileMemory="91714544"></OptimizerHardwareDependentProperties><TraceFlags IsCompileTime="1"><TraceFlag Value="3226" Scope="Global"></TraceFlag></TraceFlags><RelOp NodeId="0" PhysicalOp="Stream Aggregate" LogicalOp="Aggregate" EstimateRows="1" EstimateIO="0" EstimateCPU="1.1e-06" AvgRowSize="11" EstimatedTotalSubtreeCost="0.0032842" Parallel="0" EstimateRebinds="0" EstimateRewinds="0" EstimatedExecutionMode="Row"><OutputList><ColumnReference Column="Expr1003"></ColumnReference></OutputList><StreamAggregate><DefinedValues><DefinedValue><ColumnReference Column="Expr1003"></ColumnReference><ScalarOperator ScalarString="MIN([n])"><Aggregate Distinct="0" AggType="MIN"><ScalarOperator><Identifier><ColumnReference Column="n"></ColumnReference></Identifier></ScalarOperator></Aggregate></ScalarOperator></DefinedValue></DefinedValues><RelOp NodeId="1" PhysicalOp="Table Scan" LogicalOp="Table Scan" EstimateRows="1" EstimatedRowsRead="1" EstimateIO="0.003125" EstimateCPU="0.0001581" AvgRowSize="11" EstimatedTotalSubtreeCost="0.0032831" TableCardinality="1" Parallel="0" EstimateRebinds="0" EstimateRewinds="0" EstimatedExecutionMode="Row"><OutputList><ColumnReference Column="n"></ColumnReference></OutputList><TableScan Ordered="0" ForcedIndex="0" ForceScan="0" NoExpandHint="0" Storage="RowStore"><DefinedValues><DefinedValue><ColumnReference Column="n"></ColumnReference></DefinedValue></DefinedValues><Object Table="[@SelectedLocationIds]" Storage="RowStore"></Object></TableScan></RelOp></StreamAggregate></RelOp></QueryPlan></StmtSimple><StmtSimple StatementText="&#xd;&#xa;&#xd;&#xa;SET @FromDate = dbo.getTimeZoneAdjustedParameterDate(@tzLoc, @FromDate)" StatementId="3" StatementCompId="4" StatementType="ASSIGN" RetrievedFromCache="true"></StmtSimple><StmtSimple StatementText="&#xd;&#xa;SET @ToDate = dbo.getTimeZoneAdjustedParameterDate(@tzLoc, @ToDate + 1)" StatementId="4" StatementCompId="5" StatementType="ASSIGN" RetrievedFromCache="true"></StmtSimple><StmtSimple StatementText="&#xd;&#xa;&#xd;&#xa;DROP TABLE IF EXISTS #inventory_shared" StatementId="5" StatementCompId="6" StatementType="DROP OBJECT" RetrievedFromCache="true"></StmtSimple><StmtSimple StatementText="&#xd;&#xa;CREATE TABLE #inventory_shared&#xd;&#xa;(&#xd;&#xa;    CouponItem BIT,&#xd;&#xa;    Category VARCHAR(100),&#xd;&#xa;    RegulatedInventory BIT,&#xd;&#xa;    ItemTotal DECIMAL(18,2),&#xd;&#xa;    ItemPrice DECIMAL(18,2),&#xd;&#xa;    ItemDiscount DECIMAL(18,2),&#xd;&#xa;    LoyaltyAsDiscountAmount DECIMAL(18,2),&#xd;&#xa;    itemTotalTax DECIMAL(18,2),&#xd;&#xa;    productID INT,&#xd;&#xa;    UnitId INT,&#xd;&#xa;    ProductWeight DECIMAL(18,5),&#xd;&#xa;    TotalWeight DECIMAL(18,5),&#xd;&#xa;    Cost DECIMAL(18,5),&#xd;&#xa;    quantity DECIMAL(18,4),&#xd;&#xa;    ShipmentID INT,&#xd;&#xa;    ItemAllocationId INT,&#xd;&#xa;    PackageId INT,&#xd;&#xa;    VendorId INT,&#xd;&#xa;    isReturn BIT,&#xd;&#xa;&#x9;ItemReturnAmount decimal(18, 2),&#xd;&#xa;    SoldDate DATETIME,&#xd;&#xa;    ShipmentDeliveredLocal DATETIME,&#xd;&#xa;    ShipmentBy INT,&#xd;&#xa;    PurchasedBy INT,&#xd;&#xa;    customerTypeID INT,&#xd;&#xa;    RegulatedItems INT,&#xd;&#xa;    RegulatedSales DECIMAL(18,2),&#xd;&#xa;    RegulatedPrice DECIMAL(18,2),&#xd;&#xa;    RegulatedDiscount DECIMAL(18,2),&#xd;&#xa;    RegulatedLoyaltyDiscount DECIMAL(18,2),&#xd;&#xa;    NonRegulatedItems INT,&#xd;&#xa;    NonRegulatedSales DECIMAL(18,2),&#xd;&#xa;    NonRegulatedPrice DECIMAL(18,2),&#xd;&#xa;    NonRegulatedDiscount DECIMAL(18,2),&#xd;&#xa;    NonRegulatedLoyaltyDiscount DECIMAL(18,2),&#xd;&#xa;    tenantId INT,&#xd;&#xa;    locId INT,&#xd;&#xa;    ShipmentStatusId INT,&#xd;&#xa;    ResponsibleForSaleUserId INT,&#xd;&#xa;    OrderTypeId INT,&#xd;&#xa;    OrderSource VARCHAR(100),&#xd;&#xa;    ExternalDeliveryId INT,&#xd;&#xa;    TerminalID INT,&#xd;&#xa;    ProductTypeId INT,&#xd;&#xa;    StrainId INT,&#xd;&#xa;    BrandId INT,&#xd;&#xa;    RegulatoryCategoryId INT,&#xd;&#xa;    ProducerId INT,&#xd;&#xa;    Products_Description NVARCHAR(255),&#xd;&#xa;    Products_ProductNo NVARCHAR(255),&#xd;&#xa;    ProductCategory VARCHAR(50),&#xd;&#xa;    MasterCategory VARCHAR(100),&#xd;&#xa;    PrescriptionNumber INT&#xd;&#xa;)" StatementId="6" StatementCompId="7" StatementType="CREATE TABLE" RetrievedFromCache="true"></StmtSimple><StmtSimple StatementText="&#xd;&#xa;&#xd;&#xa;EXEC rpt.GetSoldItemsV2 @tenantid,&#xd;&#xa;    NULL,&#xd;&#xa;    @FromDate,&#xd;&#xa;    @ToDate,&#xd;&#xa;    @SelectedLocationIds" StatementId="7" StatementCompId="8" StatementType="EXECUTE PROC" RetrievedFromCache="true"></StmtSimple><StmtSimple StatementText="&#xd;&#xa;&#xd;&#xa;CREATE CLUSTERED INDEX IX ON #inventory_shared(ItemAllocationId)" StatementId="8" StatementCompId="9" StatementType="CREATE INDEX" RetrievedFromCache="true"></StmtSimple><StmtSimple StatementText=";&#xd;&#xa;CREATE INDEX IX_shipment ON #inventory_shared(shipmentID)" StatementId="9" StatementCompId="10" StatementType="CREATE INDEX" RetrievedFromCache="true"></StmtSimple><StmtSimple StatementText=";&#xd;&#xa;&#xd;&#xa;SELECT&#xd;&#xa;    tenantl.TenantLocations_name                                  AS &apos;Location Name&apos;,&#xd;&#xa;    i.ShipmentDeliveredLocal                                AS &apos;Order Date&apos;,&#xd;&#xa;    i.ShipmentID                                            AS &apos;Order ID&apos;,&#xd;&#xa;    ISNULL(acct.Accounts_Name, &apos;&apos;)                             AS &apos;Customer Name&apos;,&#xd;&#xa;    ISNULL(acct.StateIdNo, &apos;&apos;)                            AS &apos;Customer Card ID&apos;,&#xd;&#xa;    ISNULL(i.Products_ProductNo, &apos;&apos;)                    AS &apos;Product SKU&apos;,&#xd;&#xa;    ISNULL(i.ProductCategory, &apos;&apos;)                           AS &apos;Category&apos;,&#xd;&#xa;    ISNULL(i.Products_Description, &apos;&apos;)                  AS &apos;Product Name&apos;,&#xd;&#xa;    ISNULL(i.PrescriptionNumber, &apos;&apos;)                        AS &apos;Prescription ID&apos;,&#xd;&#xa;    ISNULL(i.TotalWeight, 0)                                AS &apos;Total Weight Sold&apos;,&#xd;&#xa;    ISNULL(i.ItemPrice, 0)                                  AS &apos;Gross Sales&apos;,&#xd;&#xa;    ISNULL(i.ItemDiscount, 0)                               AS &apos;Discounted Amount&apos;,&#xd;&#xa;    ISNULL(i.LoyaltyAsDiscountAmount, 0)                    AS &apos;Loyalty as Discount&apos;,&#xd;&#xa;    ISNULL(i.ItemTotal, 0)                                  AS &apos;Net Sales&apos;,&#xd;&#xa;    ISNULL(tau.FullName, &apos;&apos;)                                AS &apos;Cashier Name&apos;,&#xd;&#xa;    ISNULL(rfs.FullName, &apos;&apos;)                                AS &apos;Responsible for Sale&apos;,&#xd;&#xa;    ISNULL(i.Cost, 0)                                       AS &apos;Inventory Cost&apos;,&#xd;&#xa;    ISNULL(i.ItemTotal, 0) - ISNULL(i.Cost, 0)              AS &apos;Inventory Profit&apos;,&#xd;&#xa;    CASE WHEN i.isReturn = 0&#xd;&#xa;        THEN NULL&#xd;&#xa;        ELSE i.ShipmentDeliveredLocal&#xd;&#xa;        END                                                 AS &apos;Return Date&apos;,&#xd;&#xa;    CASE WHEN i.OrderSource IS NULL&#xd;&#xa;         THEN &apos;Walk In&apos;&#xd;&#xa;         ELSE i.OrderSource&#xd;&#xa;         END                                                AS &apos;Order Source&apos;,&#xd;&#xa;    CASE WHEN o.OrderType IS NULL&#xd;&#xa;        THEN &apos;In Store&apos;&#xd;&#xa;        ELSE o.OrderType&#xd;&#xa;        END                                                 AS &apos;Order Type&apos;&#xd;&#xa;FROM #inventory_shared i&#xd;&#xa;INNER JOIN dbo.tbl_Users tau&#xd;&#xa;    ON tau.Id = i.ShipmentBy&#xd;&#xa;LEFT JOIN tbl_Users rfs&#xd;&#xa;    ON rfs.Id = i.ResponsibleForSaleUserId&#xd;&#xa;INNER JOIN tbl_TenantLocations tenantl&#xd;&#xa;    ON tenantl.Id = i.LocId&#xd;&#xa;INNER JOIN tbl_Accounts acct&#xd;&#xa;    ON acct.Id = i.PurchasedBy&#xd;&#xa;LEFT JOIN OrderTypes o&#xd;&#xa;    ON o.Id = i.OrderTypeId&#xd;&#xa;ORDER BY&#xd;&#xa;    tenantl.TenantLocations_name,&#xd;&#xa;    i.ShipmentDeliveredLocal" StatementId="10" StatementCompId="11" StatementType="SELECT" RetrievedFromCache="true" StatementSubTreeCost="0.922598" StatementEstRows="518" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xC328A4ADCB04F6E0" QueryPlanHash="0x726A6BF6619CB442" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="160" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="true" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan NonParallelPlanReason="MaxDOPSetToOne" CachedPlanSize="272" CompileTime="15" CompileCPU="15" CompileMemory="2216"><MemoryGrantInfo SerialRequiredMemory="2712" SerialDesiredMemory="8112" GrantedMemory="0" MaxUsedMemory="0"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="2860492" EstimatedPagesCached="715123" EstimatedAvailableDegreeOfParallelism="1" MaxCompileMemory="91714544"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-09-26T08:59:06.71" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000017_BF7B68EF]" Table="[#inventory_shared___________________________________________________________________________________________________00000073384B]" Schema="[dbo]" Database="[tempdb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-09-23T02:35:27.44" ModificationCount="0" SamplingPercent="100" Statistics="[PK_tbl_TenantLocations]" Table="[tbl_TenantLocations]" Schema="[dbo]" Database="[SampleDb]"></StatisticsInfo><StatisticsInfo LastUpdate="2025-06-06T02:09:35.49" ModificationCount="0" SamplingPercent="100" Statistics="[PK__OrderTyp__3214EC07C543F081]" Table="[OrderTypes]" Schema="[dbo]" Database="[SampleDb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-09-26T08:59:06.71" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000025_BF7B68EF]" Table="[#inventory_shared___________________________________________________________________________________________________00000073384B]" Schema="[dbo]" Database="[tempdb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-09-25T02:58:51.57" ModificationCount="0" SamplingPercent="100" Statistics="[PK_tbl_Users]" Table="[tbl_Users]" Schema="[dbo]" Database="[SampleDb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-09-26T02:43:31.66" ModificationCount="21" SamplingPercent="2.12602" Statistics="[PK_tbl_Accounts]" Table="[tbl_Accounts]" Schema="[dbo]" Database="[SampleDb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-09-26T08:59:06.71" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000018_BF7B68EF]" Table="[#inventory_shared___________________________________________________________________________________________________00000073384B]" Schema="[dbo]" Database="[tempdb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-09-26T08:59:06.70" ModificationCount="0" SamplingPercent="100" Statistics="[IX_shipment]" Table="[#inventory_shared___________________________________________________________________________________________________00000073384B]" Schema="[dbo]" Database="[tempdb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-09-26T08:59:06.71" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000027_BF7B68EF]" Table="[#inventory_shared___________________________________________________________________________________________________00000073384B]" Schema="[dbo]" Database="[tempdb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-09-26T08:59:06.71" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000028_BF7B68EF]" Table="[#inventory_shared_________________________________________________________________________