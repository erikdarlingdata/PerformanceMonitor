<Project Sdk="Microsoft.NET.Sdk">

  <!-- A tiny console app the `run` tests start as the export child: it records its arguments, sleeps, allocates memory, prints and exits as told. Never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>darling-testchild</AssemblyName>
    <RootNamespace>PerformanceMonitor.Exporter.TestChild</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
