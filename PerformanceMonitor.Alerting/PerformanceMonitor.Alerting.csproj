<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>PerformanceMonitor.Alerting</RootNamespace>
    <AssemblyName>PerformanceMonitor.Alerting</AssemblyName>
    <Company>Darling Data, LLC</Company>
    <Copyright>Copyright © 2026 Darling Data, LLC</Copyright>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PerformanceMonitor.Notifications\PerformanceMonitor.Notifications.csproj" />
    <!-- The shared deadlock-graph walk (DeadlockGraphProcessParser / DeadlockProcessInfo) the alert body's
         per-process facts come from, already the one walk behind both apps' deadlock grids. Common has no
         project references of its own, so this adds a leaf and no cycle, and every app that consumes this
         project already references Common directly. -->
    <ProjectReference Include="..\PerformanceMonitor.Common\PerformanceMonitor.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- #5320: AlertStatementFilter.MarkJudged is internal (marking without judging must not be callable from
         product code outside the engine); the two test projects pin it directly. -->
    <InternalsVisibleTo Include="Darling.Tests" />
    <InternalsVisibleTo Include="Lite.Tests" />
  </ItemGroup>
</Project>
