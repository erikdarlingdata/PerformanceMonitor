<UserControl x:Class="PerformanceMonitorLite.Controls.CorrelatedTimelineLanesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:ui="clr-namespace:PerformanceMonitor.Ui;assembly=PerformanceMonitor.Ui">

    <!-- #7478: five lanes keep a minimum height each, as the Viewer's do (#6652); the control scrolls when they do not fit. -->
    <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="LanesGrid" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <!-- 5 lanes, equal height. #8224: a lane has no legend, title or Y unit and only the last has X labels, so its floor is
                 the shared plot-area floor (ui:ChartLayout.MinPlotAreaHeight, 120 px) plus its 4 px of margins and 6 px of tick
                 marks: 130 px, so a lane at its minimum still keeps the floor. The five fit a 1280x800 window and scroll below that. -->
            <RowDefinition Height="*" MinHeight="130"/>
            <RowDefinition Height="*" MinHeight="130"/>
            <RowDefinition Height="*" MinHeight="130"/>
            <RowDefinition Height="*" MinHeight="130"/>
            <!-- #8162: the last lane also holds its X labels, so it takes a little more of the height and a floor 25 px taller. -->
            <RowDefinition Height="1.15*" MinHeight="155"/>
        </Grid.RowDefinitions>

        <!-- Lane 1: CPU -->
        <Grid Grid.Row="0" Margin="0,0,0,2">
            <ScottPlot:WpfPlot x:Name="CpuChart"/>
            <TextBlock x:Name="CpuCaption" Text="CPU %" Style="{DynamicResource PanelSubtitleText}"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="56,3,0,0" IsHitTestVisible="False"/>
            <!-- Release walk V12d: said when Compare found nothing in the comparison window, so a missing dashed line is explained. -->
            <TextBlock x:Name="ComparisonEmptyBanner" Visibility="Collapsed" IsHitTestVisible="False"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,12,0"
                       Padding="8,1" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource ForegroundBrush}"
                       Background="#22FFAA00"/>
        </Grid>

        <!-- Lane 2: Wait Stats -->
        <Grid Grid.Row="1" Margin="0,2,0,2">
            <ScottPlot:WpfPlot x:Name="WaitStatsChart"/>
            <TextBlock x:Name="WaitStatsCaption" Text="Wait ms/sec" Style="{DynamicResource PanelSubtitleText}"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="56,3,0,0" IsHitTestVisible="False"/>
        </Grid>

        <!-- Lane 3: Blocking -->
        <Grid Grid.Row="2" Margin="0,2,0,2">
            <Grid.RowDefinitions>
                <!-- The "Showing since" note: Auto, so a hidden note gives the whole chart back to the chart. -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" x:Name="BlockingLaneDataStartBanner" Visibility="Collapsed"
                       Padding="8,1" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource ForegroundBrush}"
                       Background="#22FFAA00"/>
            <ScottPlot:WpfPlot Grid.Row="1" x:Name="BlockingChart"/>
            <TextBlock x:Name="BlockingCaption" Grid.Row="1" Text="Blocking &amp; Deadlocking events" Style="{DynamicResource PanelSubtitleText}"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="56,3,0,0" IsHitTestVisible="False"/>
        </Grid>

        <!-- Lane 4: Buffer Pool -->
        <Grid Grid.Row="3" Margin="0,2,0,2">
            <ScottPlot:WpfPlot x:Name="MemoryChart"/>
            <TextBlock x:Name="MemoryCaption" Text="Buffer Pool MB" Style="{DynamicResource PanelSubtitleText}"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="56,3,0,0" IsHitTestVisible="False"/>
        </Grid>

        <!-- Lane 5: File I/O -->
        <Grid Grid.Row="4" Margin="0,2,0,0">
            <ScottPlot:WpfPlot x:Name="FileIoChart"/>
            <TextBlock x:Name="FileIoCaption" Text="I/O Latency ms" Style="{DynamicResource PanelSubtitleText}"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="56,3,0,0" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
