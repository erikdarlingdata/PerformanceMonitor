            <!-- Configuration Changes Tab (Tier-1 parity) — the Lite port of the Darling viewer's Configuration
                 Changes tab, appended as the new LAST top-level tab (index 19, after System Events — nothing
                 renumbered, so switch case 19 equals this 0-based XAML index). Three sub-tab GRIDS show
                 server-config / database-config / trace-flag DRIFT over the selected window, COMPUTED by diffing
                 the store's APPEND-ONLY config snapshots via the shared PerformanceMonitor.Common.ConfigChangeDiff
                 (LocalDataService.ConfigChanges.cs). Dashboard enrichment Lite does not collect is OMITTED (not
                 fabricated): server-config Setting Description, database-config Setting Type. requires_restart is
                 KEPT (derivable: is_dynamic = 0 AND configured != in-use). Config is captured on connect/restart,
                 so a change appears only when at least two captures bracket it in the window. -->
            <TabItem Header="Configuration Changes">
                <TabControl x:Name="ConfigChangesSubTabControl" Background="Transparent" BorderThickness="0"
                            ItemContainerStyle="{DynamicResource SubTabItemStyle}">

                    <!-- Server Config Changes Sub-Tab (sys.configurations snapshot diff) -->
                    <TabItem Header="Server Config Changes">
                        <Grid Margin="8">
