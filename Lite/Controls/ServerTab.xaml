                    </TabControl>
                </Grid>
            </TabItem>

            <!-- System Events Tab (system_health parity) — the Lite port of the Darling viewer's System
                 Events tab. Corruption + Contention are the SYSTEM-component counter charts (one feed, no
                 significance filter); the rest are parse-on-read grids over v_system_health_events (shredded
                 by the Common SystemHealthParser, gated by the shared SystemHealthSignificance) plus the
                 Default Trace lane. Appended as the LAST top-level tab (index 18); loads via
                 RefreshVisibleTabAsync case 18, sub-tab switches reload via MainTabControl_SelectionChanged. -->
            <TabItem Header="System Events">
                <TabControl x:Name="SystemEventsSubTabControl" Background="Transparent" BorderThickness="0"
                            ItemContainerStyle="{DynamicResource SubTabItemStyle}">

                    <!-- Corruption Events Sub-Tab (sp_server_diagnostics SYSTEM component counter charts) -->
                    <TabItem Header="Corruption Events">
                        <Grid Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,8">
                                <TextBlock Text="Corruption Events (bad pages, dump requests, access violations)" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}"/>
                                <Button Content="Refresh" Click="SystemEventsRefresh_Click" Margin="12,0,0,0" Padding="12,4" MinWidth="70"/>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Margin="2"><ScottPlot:WpfPlot x:Name="BadPagesChart"/></Border>
                                <Border Grid.Row="0" Grid.Column="1" Margin="2"><ScottPlot:WpfPlot x:Name="DumpRequestsChart"/></Border>
                                <Border Grid.Row="1" Grid.Column="0" Margin="2"><ScottPlot:WpfPlot x:Name="AccessViolationsChart"/></Border>
                                <Border Grid.Row="1" Grid.Column="1" Margin="2"><ScottPlot:WpfPlot x:Name="WriteAccessViolationsChart"/></Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Contention Events Sub-Tab (sp_server_diagnostics SYSTEM component counter charts) -->
                    <TabItem Header="Contention Events">
                        <Grid Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,8">
                                <TextBlock Text="Contention Events (non-yielding tasks, latches, spinlocks, CPU)" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}"/>
                                <Button Content="Refresh" Click="SystemEventsRefresh_Click" Margin="12,0,0,0" Padding="12,4" MinWidth="70"/>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Margin="2"><ScottPlot:WpfPlot x:Name="NonYieldingTasksChart"/></Border>
                                <Border Grid.Row="0" Grid.Column="1" Margin="2"><ScottPlot:WpfPlot x:Name="LatchWarningsChart"/></Border>
                                <Border Grid.Row="1" Grid.Column="0" Margin="2"><ScottPlot:WpfPlot x:Name="SickSpinlocksChart"/></Border>
                                <Border Grid.Row="1" Grid.Column="1" Margin="2"><ScottPlot:WpfPlot x:Name="CpuComparisonChart"/></Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Scheduler Issues Sub-Tab -->
                    <TabItem Header="Scheduler Issues">
                        <Grid Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,8">
                                <TextBlock Text="Scheduler Issues" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}"/>
