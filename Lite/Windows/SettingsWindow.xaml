<Window x:Class="PerformanceMonitorLite.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PerformanceMonitor.Ui;assembly=PerformanceMonitor.Ui"
        Title="Settings"
        Height="750" Width="750"
        MinHeight="500" MinWidth="600"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/PerformanceMonitorLite;component/EDD.ico"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ContextMenu x:Key="DataGridContextMenu">
                <MenuItem Header="Copy _Cell" Click="CopyCell_Click"/>
                <MenuItem Header="Copy _Row" Click="CopyRow_Click"/>
                <MenuItem Header="Copy _All Rows" Click="CopyAllRows_Click"/>
                <Separator/>
                <MenuItem Header="_Export to CSV..." Click="ExportToCsv_Click"/>
            </ContextMenu>
        </ResourceDictionary>
    </Window.Resources>
    <!-- #5846: three rows. The title sits above the tabs and the Save/Close footer below them, so both stay in view
         on every tab; each tab scrolls inside itself, never the window, so the footer is never pushed off a short
         work area (Lite click-through review). The tabs follow the Darling Viewer's task grouping; every control kept
         its name, binding and handler. No scope line: every Lite setting belongs to this computer. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="16,16,16,8">
            <TextBlock Text="Settings" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
            <TextBlock Text="Configure data collection schedules and application settings"
                       FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" x:Name="SettingsTabs" Margin="16,0,16,0">
            <TabItem x:Name="CollectionTab" Header="Collection">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,8,0">
                        <!-- Collection Control -->
                        <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Data Collection" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock x:Name="CollectionStatusText" Text="Status: Active" FontSize="12"
                                               Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <!-- The mnemonic sits on "Co_llection" rather than the verb so Alt+L works in both
                                     states: the Click handler swaps this Content to "Resume Co_llection", and a key
                                     that moved with the state would be a worse affordance than no key. -->
                                <Button Grid.Column="1" x:Name="PauseResumeButton" Content="Pause Co_llection"
                                        Click="PauseResumeButton_Click" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- #2167: a COLLECTION control, so it lives beside Pause Collection rather than under
                                 Automated Analysis where it first landed (review catch) — the analysis engine has
                                 nothing to do with Query Store history. Mirrors where Darling puts it, next to plan
                                 capture in its collection group. -->
                            <CheckBox x:Name="QueryStoreBackfillCheckBox" Content="Fill Query Store history gaps in the background"
                                      Margin="0,10,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="Catches up Query Store history the live path never sees: a newly added server's recent tail, gaps left by an outage, and a freshly restored database's imported catalog. Runs in bounded background slices. Turn it off when a heavy catch-up is costing a monitored server more than the history is worth — live collection is unaffected, and re-enabling resumes exactly where it left off."
                                       FontSize="11" FontStyle="Italic" Foreground="{DynamicResource ForegroundMutedBrush}"
                                       Margin="20,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Collector Schedules (Per-Server) -->
                        <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Collector Schedules" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="1" Text="Each server can have its own collection schedule, or inherit the default."
                                           FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,8"/>

                                <DataGrid Grid.Row="2" x:Name="ServerScheduleGrid"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          SelectionMode="Single"
                                          Background="Transparent" BorderThickness="0"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          MinHeight="80" MaxHeight="200"
                                          ContextMenu="{StaticResource DataGridContextMenu}"
                                          MouseDoubleClick="ServerScheduleGrid_DoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="*"/>
                                        <DataGridTextColumn Binding="{Binding Preset}" Width="110">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Preset"
                                                           ToolTip="Which preset (Aggressive, Balanced, Low-Impact) the schedule this server runs on matches. Custom means at least one collector interval differs from every preset."/>
                                            </DataGridTextColumn.Header>
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="ToolTip" Value="{Binding PresetDetail}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding Status}" Width="110">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Status"
                                                           ToolTip="Uses default: the server follows the default schedule (Edit Default). Own schedule: the server has its own collector schedule. The Preset column describes whichever schedule applies."/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="E_dit Selected..." x:Name="EditServerScheduleButton" Click="EditServerSchedule_Click" Margin="0,0,8,0"/>
                                    <Button Content="Edit De_fault..." x:Name="EditDefaultScheduleButton" Click="EditDefaultSchedule_Click" Margin="0,0,16,0"/>
                                    <TextBlock Text="Default preset:" Foreground="{DynamicResource ForegroundBrush}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="DefaultPresetText" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <Button Content="A_pply Default to All" Click="ApplyDefaultToAll_Click"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="AlertRulesTab" Header="Alert rules">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,8,0">
                        <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <WrapPanel Orientation="Horizontal">
                                    <TextBlock Text="Alert Rules" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                                    <Button x:Name="RestoreAlertDefaultsButton" Content="_Restore Defaults" Margin="12,0,0,0"
                                            FontSize="11" VerticalAlignment="Center" Click="RestoreAlertDefaultsButton_Click"/>
                                </WrapPanel>
                                <CheckBox x:Name="AlertsEnabledCheckBox" Content="Enable notifications" Margin="0,8,0,0"
                                          Foreground="{DynamicResource ForegroundBrush}" Checked="AlertsEnabledCheckBox_Changed" Unchecked="AlertsEnabledCheckBox_Changed"/>
                                <CheckBox x:Name="NotifyConnectionCheckBox" Content="Connection lost / restored" Margin="20,6,0,0"
                                          Foreground="{DynamicResource ForegroundBrush}"/>
                                <CheckBox x:Name="NotifyConnectionDownAtStartupCheckBox" Content="Alert if a server is already down when monitoring starts" Margin="36,4,0,0"
                                          Foreground="{DynamicResource ForegroundBrush}"
                                          ToolTip="Off = the classic behavior: the first sighting of a server is a silent baseline, even when it is down."/>
                                <WrapPanel Orientation="Horizontal" Margin="36,4,0,0"
                                            ToolTip="0 = off (one alert per occurrence). Covers a server that is unreachable, AG Sync Fell Behind, and the other alerts for a lasting problem. Each repeat uses that alert's own metric name, so webhook automation keyed on it re-triggers.">
                                    <TextBlock x:Name="ConnectionRefireMinutesLabel" TextWrapping="Wrap" Text="Re-alert while a problem lasts every" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=ConnectionRefireMinutesLabel}" x:Name="ConnectionRefireMinutesBox" Width="45" Text="0" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="min (0 = off)" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </WrapPanel>
                                <CheckBox x:Name="NotifyAgHealthCheckBox" Content="Availability Group health" Margin="20,6,0,0"
                                          Foreground="{DynamicResource ForegroundBrush}"
                                          ToolTip="Failover, replica disconnected / reconnected, sync fell behind, and data movement suspended. Servers with no Availability Groups are unaffected."/>
                                <WrapPanel Orientation="Horizontal" Margin="36,4,0,0"
                                            ToolTip="0 = off. How far a secondary may fall behind the primary before alerting.">
                                    <TextBlock x:Name="AgLagAlertSecondsLabel" TextWrapping="Wrap" Text="Alert when a secondary is behind by" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AgLagAlertSecondsLabel}" x:Name="AgLagAlertSecondsBox" Width="55" Text="300" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="sec (0 = off)" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="36,4,0,0"
                                            ToolTip="0 = off. A healthy redo queue size is workload-specific, and a legitimate catch-up after a suspend will spike it, so this ships off - set it once you know your own baseline.">
                                    <TextBlock TextWrapping="Wrap" Text="...or its redo queue reaches" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.Name="Alert when redo queue reaches, KB" x:Name="AgRedoQueueAlertKbBox" Width="95" Text="0" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="KB (0 = off)" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="36,4,0,0"
                                            ToolTip="0 = off (one alert per outage). Re-alerts use the same 'AG Replica Disconnected' metric name, so webhook automation keyed on it re-triggers.">
                                    <TextBlock x:Name="AgDisconnectRefireMinutesLabel" TextWrapping="Wrap" Text="Re-alert while a replica is still disconnected every" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AgDisconnectRefireMinutesLabel}" x:Name="AgDisconnectRefireMinutesBox" Width="45" Text="0" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="min (0 = off)" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <CheckBox x:Name="AlertCpuCheckBox" Content="CPU above" VerticalAlignment="Center"
                                              Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AlertCpuCheckBox}" x:Name="AlertCpuThresholdBox" Width="45" Text="80" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="%" VerticalAlignment="Center" Margin="2,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock x:Name="AlertCpuModeLabel" Text="measured as" VerticalAlignment="Center" Margin="8,0,4,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <ComboBox AutomationProperties.LabeledBy="{Binding ElementName=AlertCpuModeLabel}" x:Name="AlertCpuModeBox" MinWidth="260" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Total non-idle CPU (SQL + other processes)" Tag="Total"/>
                                        <ComboBoxItem Content="SQL Server only (scheduler %)" Tag="SqlOnly"/>
                                    </ComboBox>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <CheckBox x:Name="AlertBlockingCheckBox" Content="Blocking events &#x2265;" VerticalAlignment="Center"
                                              Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AlertBlockingCheckBox}" x:Name="AlertBlockingThresholdBox" Width="45" Text="3" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </WrapPanel>
                                <TextBlock TextWrapping="Wrap" Margin="44,2,0,0" Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Text="Pages when this many blocking events land in the last hour and the longest wait among them is 15 seconds or more (the 15 is fixed). Each blocked session counts as one event, at its longest wait."/>
                                <WrapPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <TextBlock x:Name="AlertBlockingWaitSecondsLabel" TextWrapping="Wrap" Text="Long blocking wait &#x2265;" VerticalAlignment="Center" Margin="24,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AlertBlockingWaitSecondsLabel}" x:Name="AlertBlockingWaitSecondsBox" Width="45" Text="60" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="seconds (0 = off)" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                </WrapPanel>
                                <TextBlock TextWrapping="Wrap" Margin="44,2,0,0" Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Text="One blocked session that waits this long pages at once, whatever the count above. It is also the bar for the total blocked wait across the latest blocking snapshot (the Blocking Wait Time alert). 0 turns both off."/>
                                <WrapPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <CheckBox x:Name="AlertDeadlockCheckBox" Content="Deadlocks &#x2265;" VerticalAlignment="Center"
                                              Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AlertDeadlockCheckBox}" x:Name="AlertDeadlockThresholdBox" Width="45" Text="1" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <!-- #3539 A4: the alert grades wait ACCUMULATED over a rolling ten-minute window against fixed,
                                         fleet-calibrated bars shared with the PostgreSQL edition (PoisonWaitEvaluator). The ms box was the
                                         retired per-wait-average bar; its box is gone from the window (nothing reads it), and the saved
                                         value is left as it is on save. The preview line below the section states the live bars. -->
                                    <CheckBox x:Name="AlertPoisonWaitCheckBox" Content="Poison waits (THREADPOOL, etc.) — accumulated wait over a 10-minute window" VerticalAlignment="Center"
                                              Foreground="{DynamicResource ForegroundBrush}"
                                              ToolTip="The Poison Wait alert fires when a poison wait type accumulates 600 s of wait inside 10 minutes (WARNING) or 6,000 s (CRITICAL)."/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <!-- #5641: Runnable Queue grades the AVERAGE runnable tasks per scheduler over the collections of the last 5 minutes
                                         (at least 3; otherwise the newest 3 if all fall in the last 10 minutes (or in 4 times the gap between cpu_scheduler_stats collections when that is longer, so the Low-Impact preset's 5-minute collection still evaluates)). The two bars are whole numbers; Critical never below Warning. -->
                                    <CheckBox x:Name="AlertRunnableQueueCheckBox" Content="Runnable queue (runnable tasks per scheduler, windowed average) — Warning at" VerticalAlignment="Center"
                                              Foreground="{DynamicResource ForegroundBrush}"
                                              ToolTip="The Runnable Queue alert averages runnable tasks per scheduler over the collections in the last 5 minutes when there are at least 3, otherwise over the newest 3 if all fall in the last 10 minutes (or in 4 times the gap between cpu_scheduler_stats collections when that is longer, so the Low-Impact preset's 5-minute collection still evaluates). It fires WARNING at the first bar and CRITICAL at the second; a Warning that worsens to Critical is delivered at once."/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AlertRunnableQueueCheckBox}" x:Name="AlertRunnableQueueWarningBox" Width="45" Text="8" Margin="6,0,0,0" VerticalAlignment="Center"
                                             ToolTip="Warning bar: average runnable tasks per scheduler (the last 5 minutes' collections when there are at least 3, otherwise the newest 3 inside 10 minutes). At least 1. Default 8."/>
                                    <TextBlock Text="Critical at" VerticalAlignment="Center" Margin="6,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.Name="Runnable queue, critical at" x:Name="AlertRunnableQueueCriticalBox" Width="45" Text="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                             ToolTip="Critical bar: average runnable tasks per scheduler (same window as the Warning bar). Never below the Warning bar. Default 16."/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <!-- #5640: the Client Timeouts alert grades client timeouts and cancels (the sqlserver.attention event: a client cancelled a query
                                         or its timeout expired) per minute over the covered span of the attention collector's last runs (about 3 minutes). ON by default since #5736:
                                         the bars are relative to each server's own normal rate (#5736). The two bars are the floors; the two multiples scale the server's baseline. All whole numbers; Critical never below Warning. -->
                                    <CheckBox x:Name="AlertClientTimeoutsCheckBox" Content="Client timeouts and cancels per minute — Warning at" VerticalAlignment="Center"
                                              Foreground="{DynamicResource ForegroundBrush}"
                                              ToolTip="The Client Timeouts alert counts client timeouts and cancels per minute (the sqlserver.attention event: a client cancelled a query or its timeout expired) over the attention collector's last runs (about 3 minutes). The two bars are floors: the Warning bar is the higher of the first floor and the Warning multiple times the server's own baseline (the p99.9 of its 3-minute average rate over the last 7 days), and the Critical bar the same with the second floor and the Critical multiple. A server with under a day of capture uses the floors. A Warning that worsens to Critical is delivered at once. On by default."/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AlertClientTimeoutsCheckBox}" x:Name="AlertClientTimeoutsWarningBox" Width="45" Text="10" Margin="6,0,0,0" VerticalAlignment="Center"
                                             ToolTip="Warning floor: client timeouts and cancels (attentions) per minute over the covered span. At least 1. Default 10. The bar is the higher of this floor and the Warning multiple times the server's own baseline."/>
                                    <TextBlock Text="Critical at" VerticalAlignment="Center" Margin="6,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.Name="Client timeouts, critical at" x:Name="AlertClientTimeoutsCriticalBox" Width="45" Text="60" Margin="6,0,0,0" VerticalAlignment="Center"
                                             ToolTip="Critical floor: client timeouts and cancels (attentions) per minute (same span as the Warning floor). Never below the Warning floor. Default 60. The bar is the higher of this floor and the Critical multiple times the server's own baseline."/>
                                    <TextBlock Text="(floors), or" VerticalAlignment="Center" Margin="6,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.Name="Client timeouts, warning multiple" x:Name="AlertClientTimeoutsWarningMultipleBox" Width="35" Text="3" Margin="6,0,0,0" VerticalAlignment="Center"
                                             ToolTip="Warning multiple: the Warning bar is at least this many times the server's own baseline (the p99.9 of its 3-minute average rate over the last 7 days). At least 1. Default 3. A server with under a day of capture (or under 720 minutes with a successful run) has no baseline and uses the floors."/>
                                    <TextBlock Text="x /" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.Name="Client timeouts, critical multiple" x:Name="AlertClientTimeoutsCriticalMultipleBox" Width="35" Text="10" Margin="6,0,0,0" VerticalAlignment="Center"
                                             ToolTip="Critical multiple: the Critical bar is at least this many times the server's own baseline. Never below the Warning multiple. Default 10."/>
                                    <TextBlock Text="x the server's own baseline" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <CheckBox x:Name="AlertLongRunningQueryCheckBox" Content="Long-running queries over" VerticalAlignment="Center"
                                              Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AlertLongRunningQueryCheckBox}" x:Name="AlertLongRunningQueryThresholdBox" Width="45" Text="30" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="minutes," VerticalAlignment="Center" Margin="2,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="return up to" VerticalAlignment="Center" Margin="6,0,6,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.Name="Long-running queries, maximum results" x:Name="AlertLongRunningQueryMaxResultsBox" Width="45" Text="5" VerticalAlignment="Center"/>
                                    <TextBlock Text="results" VerticalAlignment="Center" Margin="2,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </WrapPanel>
                                <!-- Long Running Query Filters -->
                                <TextBlock Text="Long Running Query Filters" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource ForegroundBrush}" Margin="20,10,0,4"/>
                                <!-- Underscores in these wait/proc names are doubled: WPF reads a single _ as an
                                     access-key marker, which both swallows the character and claims an Alt key. -->
                                <CheckBox x:Name="LrqExcludeSpServerDiagnosticsCheckBox"
                                          Content="Exclude SP__SERVER__DIAGNOSTICS"
                                          Foreground="{DynamicResource ForegroundBrush}" Margin="20,0,0,4"/>
                                <CheckBox x:Name="LrqExcludeWaitForCheckBox"
                                          Content="Exclude WAITFOR / BROKER__RECEIVE__WAITFOR"
                                          Foreground="{DynamicResource ForegroundBrush}" Margin="20,0,0,4"/>
                                <CheckBox x:Name="LrqExcludeBackupsCheckBox"
                                          Content="Exclude backup waits (BACKUPTHREAD, BACKUPIO)"
                                          Foreground="{DynamicResource ForegroundBrush}" Margin="20,0,0,4"/>
                                <CheckBox x:Name="LrqExcludeMiscWaitsCheckBox"
                                          Content="Exclude miscellaneous waits (XE__LIVE__TARGET__TVF)"
                                          Foreground="{DynamicResource ForegroundBrush}" Margin="20,0,0,4"/>
                                <CheckBox x:Name="LrqExcludeCdcCheckBox"
                                          Content="Exclude CDC capture jobs (sp__MScdc__capture__job, sp__cdc__scan)"
                                          Foreground="{DynamicResource ForegroundBrush}" Margin="20,0,0,0"/>
                                <!-- #3653 (A5, Q5): the opt-out knob for permanent background requests. Excluded sessions are
                                     not evaluated at all (not read, not counted, not fingerprinted) — unlike a mute rule, which
                                     silences a fire already decided. The two boxes open SEEDED with the production read's
                                     defaults (the job-step program prefix; the two NT AUTHORITY logins); emptying a box
                                     clears that default for good, and "Reset to defaults" puts the seeds back. -->
                                <TextBlock Text="Exclude sessions whose program name STARTS WITH (comma-separated, case-insensitive; no wildcards):"
                                           Foreground="{DynamicResource ForegroundBrush}" Margin="20,6,0,4" FontSize="12"/>
                                <TextBox AutomationProperties.Name="Excluded program name prefixes" x:Name="AlertLrqExcludedProgramNamePrefixesBox" Margin="20,0,0,4"/>
                                <TextBlock Text="Exclude sessions whose login IS (comma-separated, case-insensitive, whole name):"
                                           Foreground="{DynamicResource ForegroundBrush}" Margin="20,0,0,4" FontSize="12"/>
                                <TextBox AutomationProperties.Name="Excluded logins" x:Name="AlertLrqExcludedLoginsBox" Margin="20,0,0,4"/>
                                <TextBlock Text="Defaults from a 7-day read of one large production store: SQL Agent job steps (program prefix 'SQLAgent - TSQL JobStep', ~460 sessions/week, 35–62 min medians) and the NT AUTHORITY\SYSTEM / NT AUTHORITY\NETWORK SERVICE logins (the multi-day CDC-shaped background). The application's admin login is NOT a default: it runs the job wave but also real ad-hoc long-runners, and the job-step prefix already covers its share. Named humans are never excluded — they are what the alert is for. An excluded session is never evaluated (the opposite of a mute); the alert card counts how many each list removed. Empty a box to disable that default."
                                           FontSize="11" FontStyle="Italic" Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Margin="20,0,0,0" TextWrapping="Wrap"/>
                                <WrapPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <CheckBox x:Name="AlertTempDbSpaceCheckBox" Content="tempdb space usage over" VerticalAlignment="Center"
                                              Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AlertTempDbSpaceCheckBox}" x:Name="AlertTempDbSpaceThresholdBox" Width="45" Text="80" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="%" VerticalAlignment="Center" Margin="2,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <CheckBox x:Name="AlertLowDiskCheckBox" Content="Volume free space under" VerticalAlignment="Center"
                                              Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AlertLowDiskCheckBox}" x:Name="AlertLowDiskThresholdPercentBox" Width="45" Text="10" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="% or" VerticalAlignment="Center" Margin="2,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.Name="Volume free space under, GB" x:Name="AlertLowDiskThresholdGbBox" Width="45" Text="5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock TextWrapping="Wrap" Text="GB free (Azure SQL DB excluded)" VerticalAlignment="Center" Margin="2,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <CheckBox x:Name="AlertPvsCheckBox" Content="Version store (PVS) over" VerticalAlignment="Center"
                                              Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AlertPvsCheckBox}" x:Name="AlertPvsThresholdPercentBox" Width="45" Text="40" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock TextWrapping="Wrap" Text="% of database and at least" VerticalAlignment="Center" Margin="2,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.Name="Version store minimum size, GB" x:Name="AlertPvsFloorGbBox" Width="45" Text="1" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="GB (ADR databases only)" VerticalAlignment="Center" Margin="2,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </WrapPanel>
                                <!-- A WrapPanel, not a StackPanel: this row is wider than the window, so its tail wrapped off the right edge. -->
                                <WrapPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <CheckBox x:Name="AlertFileGrowthCheckBox" Content="Database file growing over" VerticalAlignment="Center"
                                              Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AlertFileGrowthCheckBox}" x:Name="AlertFileGrowthRiseMbBox" Width="60" Text="10240" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="MB/hr averaged over" VerticalAlignment="Center" Margin="2,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.Name="File growth averaging window, minutes" x:Name="AlertFileGrowthLookbackMinutesBox" Width="45" Text="60" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="min, or is over" VerticalAlignment="Center" Margin="2,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.Name="File growth volume fill, percent" x:Name="AlertFileGrowthVolumePercentBox" Width="45" Text="60" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock TextWrapping="Wrap" Text="% of its volume (0 disables either gate)" VerticalAlignment="Center" Margin="2,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <CheckBox x:Name="AlertLongRunningJobCheckBox" Content="Agent jobs running over" VerticalAlignment="Center"
                                              Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AlertLongRunningJobCheckBox}" x:Name="AlertLongRunningJobMultiplierBox" Width="35" Text="3" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="x historical average" VerticalAlignment="Center" Margin="2,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <CheckBox x:Name="AlertFailedJobCheckBox" Content="Agent job failed in the last" VerticalAlignment="Center"
                                              Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AlertFailedJobCheckBox}" x:Name="AlertFailedJobLookbackBox" Width="45" Text="60" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="minutes" VerticalAlignment="Center" Margin="2,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <CheckBox x:Name="AlertDatabaseStateCheckBox" Content="Database state changed from its expected (baseline) state"
                                              VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <Button x:Name="ConfigureDatabaseStatesButton" Content="Configure…" Margin="8,0,0,0" Padding="8,2"
                                            VerticalAlignment="Center" Click="ConfigureDatabaseStatesButton_Click"/>
                                </WrapPanel>
                                <!-- Global Alert Filters -->
                                <TextBlock Text="Global Alert Filters" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource ForegroundBrush}" Margin="20,14,0,4"/>
                                <TextBlock x:Name="AlertExcludedDatabasesLabel" Text="Exclude databases from alerts (one name per line):"
                                           Foreground="{DynamicResource ForegroundBrush}" Margin="20,0,0,4" FontSize="12"/>
                                <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AlertExcludedDatabasesLabel}" x:Name="AlertExcludedDatabasesBox" Margin="20,0,0,4" AcceptsReturn="True" TextWrapping="NoWrap" Height="60" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                                <TextBlock Text="e.g. DBAtools, msdb and tempdb on three lines; a name may hold a comma — applies to blocking, deadlock, and long-running query alerts"
                                           FontSize="11" FontStyle="Italic" Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Margin="20,0,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="AlertExcludedVolumesLabel" Text="Exclude volumes from the Volume Free Space alert (one per line):"
                                           Foreground="{DynamicResource ForegroundBrush}" Margin="20,10,0,4" FontSize="12"/>
                                <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AlertExcludedVolumesLabel}" x:Name="AlertExcludedVolumesBox" Margin="20,0,0,4" AcceptsReturn="True" TextWrapping="NoWrap" Height="60" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                                <TextBlock Text="e.g. S:\, T:\ and /mnt/scratch on three lines (a comma-separated paste also works) — the whole mount point, any case, a trailing \ or / is ignored; applies to every server"
                                           FontSize="11" FontStyle="Italic" Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Margin="20,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="DeliveryTab" Header="Delivery">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,8,0">
                        <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Alert Delivery" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                <WrapPanel Orientation="Horizontal" Margin="20,10,0,0">
                                    <TextBlock x:Name="AlertCooldownLabel" TextWrapping="Wrap" Text="Tray notification cooldown:" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AlertCooldownLabel}" x:Name="AlertCooldownBox" Width="40" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="minutes" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <TextBlock x:Name="EmailCooldownLabel" Text="Email alert cooldown:" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=EmailCooldownLabel}" x:Name="EmailCooldownBox" Width="40" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="minutes" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </WrapPanel>
                                <!-- #1141: deadlock/blocking notification delivery mode + per-event cap -->
                                <WrapPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <TextBlock x:Name="AlertDeliveryModeLabel" TextWrapping="Wrap" Text="Deadlock/blocking delivery:" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <ComboBox AutomationProperties.LabeledBy="{Binding ElementName=AlertDeliveryModeLabel}" x:Name="AlertDeliveryModeBox" Width="260" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Summary — one card per cycle" Tag="Summary"/>
                                        <ComboBoxItem Content="Per-event — one notification per incident" Tag="PerEvent"/>
                                    </ComboBox>
                                    <TextBlock Text="max" VerticalAlignment="Center" Margin="8,0,4,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.Name="Per-event notifications per cycle, maximum" x:Name="AlertPerEventMaxBox" Width="40" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="/cycle" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </WrapPanel>
                                <TextBlock x:Name="AlertPreviewText" FontSize="11" FontStyle="Italic"
                                           Foreground="{DynamicResource ForegroundMutedBrush}" TextWrapping="Wrap" Margin="20,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Email Alerts (Optional) -->
                        <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Email Alerts (Optional)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Text="Send email notifications alongside system tray alerts. Requires an SMTP server."
                                           FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <CheckBox x:Name="SmtpEnabledCheckBox" Content="Enable email alerts" Margin="0,8,0,0"
                                          Foreground="{DynamicResource ForegroundBrush}" Checked="SmtpEnabledCheckBox_Changed" Unchecked="SmtpEnabledCheckBox_Changed"/>
                                <Grid Margin="20,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="SmtpServerLabel" Grid.Row="0" Grid.Column="0" Text="SMTP Server:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,4"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=SmtpServerLabel}" Grid.Row="0" Grid.Column="1" x:Name="SmtpServerBox" Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Port:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,4"/>
                                    <WrapPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBox AutomationProperties.Name="SMTP port" x:Name="SmtpPortBox" Width="70" Text="587"/>
                                        <CheckBox x:Name="SmtpSslCheckBox" Content="Use SSL/TLS" VerticalAlignment="Center" Margin="16,0,0,0"
                                                  Foreground="{DynamicResource ForegroundBrush}" IsChecked="True"/>
                                    </WrapPanel>

                                    <TextBlock x:Name="SmtpUsernameLabel" Grid.Row="2" Grid.Column="0" Text="Username:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,4"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=SmtpUsernameLabel}" Grid.Row="2" Grid.Column="1" x:Name="SmtpUsernameBox" Margin="0,0,0,4"/>

                                    <TextBlock x:Name="SmtpPasswordLabel" Grid.Row="3" Grid.Column="0" Text="Password:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,4"/>
                                    <PasswordBox AutomationProperties.LabeledBy="{Binding ElementName=SmtpPasswordLabel}" Grid.Row="3" Grid.Column="1" x:Name="SmtpPasswordBox" Margin="0,0,0,4"/>

                                    <TextBlock x:Name="SmtpFromLabel" Grid.Row="4" Grid.Column="0" Text="From Address:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,4"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=SmtpFromLabel}" Grid.Row="4" Grid.Column="1" x:Name="SmtpFromBox" Margin="0,0,0,4"/>

                                    <TextBlock x:Name="SmtpRecipientsLabel" Grid.Row="5" Grid.Column="0" Text="Recipients:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,4"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=SmtpRecipientsLabel}" Grid.Row="5" Grid.Column="1" x:Name="SmtpRecipientsBox" Margin="0,0,0,4"
                                             ToolTip="Comma-separated email addresses"/>

                                    <WrapPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button x:Name="TestEmailButton" Content="Send Test _Email" Click="TestEmailButton_Click"/>
                                        <Button x:Name="ValidateSmtpButton" Content="_Validate Settings" Margin="8,0,0,0"
                                                Click="ValidateSmtpButton_Click"/>
                                        <TextBlock x:Name="SmtpStatusText" FontSize="11" FontStyle="Italic"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </WrapPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Webhooks (Teams / Slack) -->
                        <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Microsoft Teams -->
                                <TextBlock Text="Microsoft Teams Notifications" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Text="Send alert notifications to a Teams channel via incoming webhook. Color-coded accent bars indicate alert severity."
                                           FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <CheckBox x:Name="TeamsWebhookEnabledCheckBox" Content="Enable Teams notifications" Margin="0,8,0,0"
                                          Foreground="{DynamicResource ForegroundBrush}" Checked="TeamsWebhookEnabledCheckBox_Changed" Unchecked="TeamsWebhookEnabledCheckBox_Changed"/>
                                <Grid Margin="20,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Webhook URL:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,4"/>
                                    <TextBox AutomationProperties.Name="Teams webhook URL" Grid.Row="0" Grid.Column="1" x:Name="TeamsWebhookUrlBox" Margin="0,0,0,4"
                                             ToolTip="Paste your Teams Incoming Webhook or Power Automate Workflows URL here"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Proxy Address:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,4"/>
                                    <TextBox AutomationProperties.Name="Teams proxy address" Grid.Row="1" Grid.Column="1" x:Name="TeamsProxyAddressBox" Margin="0,0,0,4"
                                             ToolTip="Optional HTTP proxy (e.g. http://proxy.corp:8080). Leave blank for direct connection."/>

                                    <WrapPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                                        <!-- Named per channel: the Teams, Slack and generic-webhook buttons all read
                                             "Send Test Notification" before, which are three identical labels visible at
                                             once on one scrolling page and so could not carry distinct access keys. -->
                                        <Button x:Name="TestTeamsButton" Content="Send Test to _Teams" Click="TestTeamsButton_Click"/>
                                        <TextBlock x:Name="TeamsStatusText" FontSize="11" FontStyle="Italic"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </WrapPanel>
                                </Grid>
                                <TextBlock Margin="20,8,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ForegroundMutedBrush}">
                                    <Run Text="Setup: Create an Incoming Webhook connector or a Power Automate Workflows webhook for your Teams channel. "/>
                                    <Hyperlink NavigateUri="https://learn.microsoft.com/en-us/microsoftteams/platform/webhooks-and-connectors/how-to/add-incoming-webhook"
                                               RequestNavigate="Hyperlink_RequestNavigate">
                                        Teams Webhooks Documentation
                                    </Hyperlink>
                                </TextBlock>

                                <!-- Slack -->
                                <TextBlock Text="Slack Notifications" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}" Margin="0,20,0,0"/>
                                <TextBlock Text="Send alert notifications to a Slack channel via incoming webhook. Color-coded sidebar indicates alert severity."
                                           FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <CheckBox x:Name="SlackWebhookEnabledCheckBox" Content="Enable Slack notifications" Margin="0,8,0,0"
                                          Foreground="{DynamicResource ForegroundBrush}" Checked="SlackWebhookEnabledCheckBox_Changed" Unchecked="SlackWebhookEnabledCheckBox_Changed"/>
                                <Grid Margin="20,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Webhook URL:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,4"/>
                                    <TextBox AutomationProperties.Name="Slack webhook URL" Grid.Row="0" Grid.Column="1" x:Name="SlackWebhookUrlBox" Margin="0,0,0,4"
                                             ToolTip="Paste your Slack Incoming Webhook URL here"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Proxy Address:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,4"/>
                                    <TextBox AutomationProperties.Name="Slack proxy address" Grid.Row="1" Grid.Column="1" x:Name="SlackProxyAddressBox" Margin="0,0,0,4"
                                             ToolTip="Optional HTTP proxy (e.g. http://proxy.corp:8080). Leave blank for direct connection."/>

                                    <WrapPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button x:Name="TestSlackButton" Content="Send Test to Slac_k" Click="TestSlackButton_Click"/>
                                        <TextBlock x:Name="SlackStatusText" FontSize="11" FontStyle="Italic"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </WrapPanel>
                                </Grid>
                                <TextBlock Margin="20,8,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ForegroundMutedBrush}">
                                    <Run Text="Setup: Create an Incoming Webhook app in your Slack workspace settings. "/>
                                    <Hyperlink NavigateUri="https://api.slack.com/messaging/webhooks"
                                               RequestNavigate="Hyperlink_RequestNavigate">
                                        Slack Webhooks Documentation
                                    </Hyperlink>
                                </TextBlock>

                                <!-- Generic webhook -->
                                <TextBlock Text="Generic Webhook (HTTP POST)" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}" Margin="0,20,0,0"/>
                                <TextBlock Text="POST alerts as JSON to any endpoint — PagerDuty, Opsgenie, n8n, or a GitHub repository_dispatch that re-runs a workflow. Use this to trigger automation when an alert fires (for example, re-adding your IP to an Azure SQL firewall rule after a connection is lost)."
                                           FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <CheckBox x:Name="GenericWebhookEnabledCheckBox" Content="Enable generic webhook" Margin="0,8,0,0"
                                          Foreground="{DynamicResource ForegroundBrush}" Checked="GenericWebhookEnabledCheckBox_Changed" Unchecked="GenericWebhookEnabledCheckBox_Changed"/>
                                <Grid Margin="20,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="URL:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,4"/>
                                    <TextBox AutomationProperties.Name="Generic webhook URL" Grid.Row="0" Grid.Column="1" x:Name="GenericWebhookUrlBox" Margin="0,0,0,4"
                                             ToolTip="The endpoint to POST to, e.g. https://api.github.com/repos/OWNER/REPO/dispatches"/>

                                    <TextBlock x:Name="GenericWebhookHeadersLabel" Grid.Row="1" Grid.Column="0" Text="Headers (JSON):" VerticalAlignment="Top"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,4,8,4"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=GenericWebhookHeadersLabel}" Grid.Row="1" Grid.Column="1" x:Name="GenericWebhookHeadersBox" Margin="0,0,0,4"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" VerticalScrollBarVisibility="Auto"
                                             ToolTip="A JSON object of request headers. Stored in Windows Credential Manager — it carries your token."/>

                                    <TextBlock x:Name="GenericWebhookBodyLabel" Grid.Row="2" Grid.Column="0" Text="Body (JSON):" VerticalAlignment="Top"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,4,8,4"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=GenericWebhookBodyLabel}" Grid.Row="2" Grid.Column="1" x:Name="GenericWebhookBodyBox" Margin="0,0,0,4"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" VerticalScrollBarVisibility="Auto"
                                             FontFamily="Consolas"
                                             ToolTip="The JSON body to POST. Leave blank to use the built-in default. Placeholders are substituted and JSON-escaped."/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Proxy Address:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,4"/>
                                    <TextBox AutomationProperties.Name="Generic webhook proxy address" Grid.Row="3" Grid.Column="1" x:Name="GenericWebhookProxyAddressBox" Margin="0,0,0,4"
                                             ToolTip="Optional HTTP proxy (e.g. http://proxy.corp:8080). Leave blank for direct connection."/>

                                    <WrapPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button x:Name="TestGenericButton" Content="Send Test to _Webhook" Click="TestGenericButton_Click"/>
                                        <TextBlock x:Name="GenericStatusText" FontSize="11" FontStyle="Italic"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </WrapPanel>
                                </Grid>
                                <!-- #6012: the signing key of the generic URL (Standard Webhooks headers). The key is shown once, here, and never again. -->
                                <StackPanel Margin="20,8,0,0">
                                    <TextBlock Text="Signing key" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock x:Name="GenericSigningStatusText" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,4"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button x:Name="GenericSigningGenerateButton" Content="Generate key" Click="GenericSigningGenerate_Click"
                                                ToolTip="Makes a key and signs every post to this URL with it (webhook-id, webhook-timestamp and webhook-signature headers). The key is shown once."/>
                                        <Button x:Name="GenericSigningRemoveButton" Content="Remove key" Margin="8,0,0,0" Click="GenericSigningRemove_Click"
                                                ToolTip="Stops signing posts to this URL."/>
                                    </WrapPanel>
                                    <TextBlock x:Name="GenericSigningShownOnceText" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,2" Visibility="Collapsed"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox x:Name="GenericSigningNewKeyBox" IsReadOnly="True" Visibility="Collapsed" FontFamily="Consolas"
                                             AutomationProperties.Name="New signing key"/>
                                </StackPanel>
                                <TextBlock Margin="20,8,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ForegroundMutedBrush}">
                                    <Run Text="Placeholders (each is JSON-escaped when substituted): "/>
                                    <Run FontFamily="Consolas" Text="{}{{metric}} {{server}} {{value}} {{threshold}} {{severity}} {{context}} {{detail}} {{timestamp}} {{status}}"/>
                                </TextBlock>
                                <TextBlock Margin="20,4,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ForegroundMutedBrush}">
                                    <Run Text="Automation placeholders — the first two substitute RAW JSON values (use them unquoted, e.g. &quot;context&quot;: {{context_json}}): "/>
                                    <Run FontFamily="Consolas" Text="{}{{context_json}} {{incidents_json}} {{dedup_key}} {{resource_name}} {{database}} {{triage_url}}"/>
                                </TextBlock>
                                <TextBlock Margin="20,4,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ForegroundMutedBrush}">
                                    <Run FontFamily="Consolas" Text="{}{{investigation_json}}"/>
                                    <Run Text=" : the investigation request an alert opened or joined, when an agent route covers the alert; empty when it opened none."/>
                                </TextBlock>
                                <TextBlock Margin="20,6,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ForegroundMutedBrush}">
                                    <Run FontWeight="SemiBold" Text="Example — re-run a GitHub Actions workflow when an alert fires:"/>
                                    <LineBreak/>
                                    <Run FontFamily="Consolas" Text="URL: https://api.github.com/repos/OWNER/REPO/dispatches"/>
                                    <LineBreak/>
                                    <Run FontFamily="Consolas" Text="{}Headers: {&quot;Authorization&quot;: &quot;Bearer ghp_YOUR_TOKEN&quot;, &quot;Accept&quot;: &quot;application/vnd.github+json&quot;}"/>
                                    <LineBreak/>
                                    <Run FontFamily="Consolas" Text="{}Body: {&quot;event_type&quot;: &quot;sql-monitor-alert&quot;, &quot;client_payload&quot;: {&quot;metric&quot;: &quot;{{metric}}&quot;, &quot;server&quot;: &quot;{{server}}&quot;}}"/>
                                    <LineBreak/>
                                    <Run Text="The repository's workflow triggers on "/>
                                    <Run FontFamily="Consolas" Text="repository_dispatch"/>
                                    <Run Text=". The token needs Contents: write on that repository."/>
                                </TextBlock>

                                <!-- PagerDuty -->
                                <TextBlock Text="PagerDuty Notifications" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}" Margin="0,20,0,0"/>
                                <TextBlock Text="Send alert notifications to PagerDuty via the Events API v2. Alerts trigger a PagerDuty incident; repeated alerts for the same condition correlate into the same incident."
                                           FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <CheckBox x:Name="PagerDutyWebhookEnabledCheckBox" Content="Enable PagerDuty notifications" Margin="0,8,0,0"
                                          Foreground="{DynamicResource ForegroundBrush}" Checked="PagerDutyWebhookEnabledCheckBox_Changed" Unchecked="PagerDutyWebhookEnabledCheckBox_Changed"/>
                                <Grid Margin="20,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="PagerDutyRoutingKeyLabel" Grid.Row="0" Grid.Column="0" Text="Routing Key:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,4"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=PagerDutyRoutingKeyLabel}" Grid.Row="0" Grid.Column="1" x:Name="PagerDutyRoutingKeyBox" Margin="0,0,0,4"
                                             ToolTip="The 32-character Integration Key from a PagerDuty Events API v2 integration. Stored in Windows Credential Manager."/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                    <CheckBox Grid.Row="1" Grid.Column="1" x:Name="PagerDutyEuRegionCheckBox" Content="Use EU data center (events.eu.pagerduty.com)"
                                              Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                    <CheckBox Grid.Row="2" Grid.Column="1" x:Name="PagerDutyAutoResolveCheckBox" Content="Auto-resolve the incident when the alert's condition clears"
                                              Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4"
                                              ToolTip="Sends a PagerDuty 'resolve' event when an edge-type alert's condition clears (a server comes back, a replica reconnects), closing the incident the firing edge's trigger opened. Off by default: the closing edge is sent as an info-level alert and the incident stays open. Replica cooldowns: when PagerDuty is set up for the alert, Teams, Slack and the generic webhook keep one cooldown per replica, so each replica gets its own outage and recovery notices. Email stays per server."/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Proxy Address:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,4"/>
                                    <TextBox AutomationProperties.Name="PagerDuty proxy address" Grid.Row="3" Grid.Column="1" x:Name="PagerDutyProxyAddressBox" Margin="0,0,0,4"
                                             ToolTip="Optional. HTTP proxy for reaching PagerDuty (e.g. http://proxy.corp.local:8080). Leave blank to connect directly."/>

                                    <WrapPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button x:Name="TestPagerDutyButton" Content="Send Test Notification" Click="TestPagerDutyButton_Click"/>
                                        <TextBlock x:Name="PagerDutyStatusText" FontSize="11" FontStyle="Italic"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </WrapPanel>
                                </Grid>
                                <TextBlock Margin="20,8,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ForegroundMutedBrush}">
                                    <Run Text="Setup: Create a service in PagerDuty, add an Events API v2 integration, and copy its Integration Key. "/>
                                    <Hyperlink NavigateUri="https://support.pagerduty.com/docs/services-and-integrations"
                                               RequestNavigate="Hyperlink_RequestNavigate">
                                        PagerDuty Integrations Documentation
                                    </Hyperlink>
                                </TextBlock>

                                <!-- Notification routes (#5750): scoped destinations layered over the app-wide ones above -->
                                <TextBlock Text="Notification Routes" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}" Margin="0,20,0,0"/>
                                <TextBlock Text="Send one server's or one tag's alerts to their own Teams, Slack, generic webhook, PagerDuty or email destinations. A route replaces the destinations above for the channels it fills in; everything else keeps using them."
                                           FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <Button x:Name="ManageNotificationRoutesButton" Content="Manage Notification _Routes..."
                                        Click="ManageNotificationRoutesButton_Click" HorizontalAlignment="Left"
                                        Padding="12,4" Margin="0,8,0,0"/>

                                <!-- Agent notes (#5903): a note an agent proposes waits here for a person to approve or reject it -->
                                <TextBlock Text="Agent Notes" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}" Margin="0,20,0,0"/>
                                <TextBlock Text="An agent can propose a note with its investigation report. Approve a note for later briefs to carry it, or reject it to keep it out."
                                           FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <Button x:Name="ReviewAgentNotesButton" Content="Review Agent _Notes..."
                                        Click="ReviewAgentNotesButton_Click" HorizontalAlignment="Left"
                                        Padding="12,4" Margin="0,8,0,0"/>

                                <!-- Severity Color Reference -->
                                <TextBlock Text="Alert Severity Colors" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource ForegroundBrush}" Margin="0,16,0,4"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,2">
                                    <Run Foreground="#DC2626" FontWeight="Bold" Text="&#x25A0; Red" /> — Critical (Deadlocks, Poison Waits, Runnable Queue and Client Timeouts at the Critical bar, Server Unreachable)
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,2">
                                    <Run Foreground="#D97706" FontWeight="Bold" Text="&#x25A0; Orange" /> — Alert / Warning (Blocking, Long-Running Queries, Runnable Queue, Client Timeouts, tempdb, Jobs)
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,2">
                                    <Run Foreground="#F59E0B" FontWeight="Bold" Text="&#x25A0; Yellow" /> — Warning (High CPU)
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,2">
                                    <Run Foreground="#16A34A" FontWeight="Bold" Text="&#x25A0; Green" /> — Resolved (Server Restored)
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ForegroundMutedBrush}">
                                    <Run Foreground="{DynamicResource InfoBrush}" FontWeight="Bold" Text="&#x25A0; Blue" /> — Info
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="MutingTriageTab" Header="Muting &amp; triage">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,8,0">
                        <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Mute Rules -->
                                <TextBlock Text="Alert Muting" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource ForegroundBrush}" Margin="20,14,0,4"/>
                                <WrapPanel Orientation="Horizontal" Margin="20,0,0,4">
                                    <TextBlock x:Name="MuteRuleDefaultExpirationLabel" TextWrapping="Wrap" Text="Default expiration for new mute rules:" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <ComboBox AutomationProperties.LabeledBy="{Binding ElementName=MuteRuleDefaultExpirationLabel}" x:Name="MuteRuleDefaultExpirationCombo" Width="130" VerticalAlignment="Center">
                                        <ComboBoxItem Content="1 hour"/>
                                        <ComboBoxItem Content="24 hours"/>
                                        <ComboBoxItem Content="7 days"/>
                                        <ComboBoxItem Content="Never"/>
                                    </ComboBox>
                                </WrapPanel>
                                <Button x:Name="ManageMuteRulesButton" Content="_Manage Mute Rules..."
                                        Click="ManageMuteRulesButton_Click" HorizontalAlignment="Left"
                                        Padding="12,4" Margin="20,4,0,4"/>
                                <TextBlock Text="Create rules to suppress specific recurring alerts while still logging them."
                                           FontSize="11" FontStyle="Italic" Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Margin="20,0,0,0" TextWrapping="Wrap"/>
                                <CheckBox x:Name="LogAlertDismissalsCheckBox" Content="Log alert dismiss and mute actions"
                                          Margin="20,8,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="AnalysisTab" Header="Analysis">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,8,0">
                        <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Automated Analysis -->
                                <TextBlock Text="Automated Analysis" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource ForegroundBrush}" Margin="20,14,0,4"/>
                                <TextBlock Text="Periodically run the triage engine and record findings in the Alerts tab. Notifications below are optional — analysis runs and stores findings even with notifications off."
                                           FontSize="11" FontStyle="Italic" Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Margin="20,0,0,4" TextWrapping="Wrap"/>
                                <CheckBox x:Name="AnalysisEnabledCheckBox" Content="Enable automated analysis"
                                          Margin="20,4,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
                                <CheckBox x:Name="AnalysisNotificationsCheckBox" Content="Send scheduled analysis notifications"
                                          Margin="20,4,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
                                <WrapPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <TextBlock x:Name="AnalysisIntervalLabel" Text="Run analysis every" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AnalysisIntervalLabel}" x:Name="AnalysisIntervalBox" Width="45" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="minutes" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <TextBlock x:Name="AnalysisNotifySeverityLabel" TextWrapping="Wrap" Text="Notify on finding severity at or above" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AnalysisNotifySeverityLabel}" x:Name="AnalysisNotifySeverityBox" Width="45" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="(0.0 - 2.0)" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                </WrapPanel>
                                <!-- #2393: analysis_notify_cooldown_minutes has been read (and clamped) by App.LoadAlertSettings
                                     since the key existed, and the Darling viewer has offered it since #2107; Lite simply never
                                     drew the box, so the one knob that quiets chatty analysis notifications was hand-edit-only. -->
                                <WrapPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <TextBlock x:Name="AnalysisNotifyCooldownLabel" TextWrapping="Wrap" Text="Re-notify an unchanged finding after" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AnalysisNotifyCooldownLabel}" x:Name="AnalysisNotifyCooldownBox" Width="55" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="minutes (30 - 10080)" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                </WrapPanel>
                                <!-- #3712: confidence chooses the channel. Checked (the default) keeps a LONE-FACT finding — one fact in
                                     its chain, no matched co-fire check — off email, the webhooks and the tray; it is still recorded in
                                     the Alerts tab (status Digest) and shown in Recommendations with a not-paged marker. Unchecked
                                     restores pre-#3712 delivery of every finding at or above the severity floor. A corroborated
                                     finding is delivered either way. -->
                                <CheckBox x:Name="AnalysisUncorroboratedDigestCheckBox"
                                          Content="Only notify on corroborated findings (a lone uncorroborated fact is recorded, not delivered)"
                                          Margin="20,6,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Text="Requires SMTP or a webhook configured below for delivery; findings are recorded in the Alerts tab either way."
                                           FontSize="11" FontStyle="Italic" Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Margin="20,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="AccessTab" Header="Access">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,8,0">
                        <!-- MCP Server Settings -->
                        <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="MCP Server (LLM Tool Access)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Text="Allows LLM clients (Claude Code, etc.) to query monitoring data via the Model Context Protocol."
                                           FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox x:Name="McpEnabledCheckBox" Content="Enable MCP server" VerticalAlignment="Center"
                                              Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="Port:" VerticalAlignment="Center" Margin="20,0,6,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.Name="MCP server port" x:Name="McpPortTextBox" Width="70" Text="5151" VerticalAlignment="Center"/>
                                    <Button Content="_Auto" ToolTip="Find an available port"
                                            Margin="6,0,0,0" Padding="8,2"
                                            VerticalAlignment="Center"
                                            Click="AutoPortButton_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="McpStatusText" FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,6,0,0"/>
                                <WrapPanel x:Name="McpTokenPanel" Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Token:" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBox AutomationProperties.Name="MCP token" x:Name="McpTokenTextBox" Width="320" IsReadOnly="True"
                                             VerticalAlignment="Center">
                                        <TextBox.CommandBindings>
                                            <CommandBinding Command="ApplicationCommands.Copy" Executed="McpTokenTextBox_Copy"/>
                                        </TextBox.CommandBindings>
                                    </TextBox>
                                    <Button x:Name="CopyMcpTokenButton" Content="Copy _Token" Margin="6,0,0,0" Padding="8,2"
                                            VerticalAlignment="Center" Click="CopyMcpTokenButton_Click"/>
                                    <Button x:Name="NewMcpTokenButton" Content="New token" Margin="6,0,0,0" Padding="8,2"
                                            VerticalAlignment="Center" Click="NewMcpTokenButton_Click"
                                            ToolTip="Make a new token. The old one stops working at once, and your MCP client needs the new config."/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button x:Name="CopyMcpCommandButton" Content="Cop_y MCP config" Click="CopyMcpCommandButton_Click"/>
                                    <TextBlock TextWrapping="Wrap" Text="Works with Claude Code. Other LLMs may apply, but why would you?"
                                               FontSize="11" FontStyle="Italic" Foreground="{DynamicResource ForegroundMutedBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="ApplicationTab" Header="Application">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,8,0">
                        <!-- Dashboard Defaults -->
                        <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Dashboard Defaults" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Default time range:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,0"/>
                                    <!-- #5562: the shared picker. A typed or picked fixed range is not a default; it is not saved. -->
                                    <ui:TimeRangePicker x:Name="DefaultTimeRangePicker" VerticalAlignment="Center"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock x:Name="ConnectionTimeoutLabel" Text="Connection timeout:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,0"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=ConnectionTimeoutLabel}" x:Name="ConnectionTimeoutBox" Width="50" Text="5" VerticalAlignment="Center"/>
                                    <TextBlock TextWrapping="Wrap" Text="seconds (5–60, increase for VPN/remote connections)"
                                               FontSize="11" FontStyle="Italic" Foreground="{DynamicResource ForegroundMutedBrush}"
                                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock x:Name="DuckDbMemoryLimitLabel" Text="DuckDB memory limit:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,0"/>
                                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=DuckDbMemoryLimitLabel}" x:Name="DuckDbMemoryLimitBox" Width="50" Text="2" VerticalAlignment="Center"/>
                                    <TextBlock TextWrapping="Wrap" x:Name="DuckDbMemoryLimitHint" Text="GB (default 2). Raise it if a tab reports DuckDB out of memory. Takes effect after Lite restarts."
                                               FontSize="11" FontStyle="Italic" Foreground="{DynamicResource ForegroundMutedBrush}"
                                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock x:Name="CsvSeparatorLabel" Text="CSV separator:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,0"/>
                                    <ComboBox AutomationProperties.LabeledBy="{Binding ElementName=CsvSeparatorLabel}" x:Name="CsvSeparatorCombo" Width="140" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Comma (,)" Tag=","/>
                                        <ComboBoxItem Content="Semicolon (;)" Tag=";"/>
                                        <ComboBoxItem Content="Tab" Tag="&#x9;"/>
                                    </ComboBox>
                                    <TextBlock TextWrapping="Wrap" Text="auto-detected from locale"
                                               FontSize="11" FontStyle="Italic" Foreground="{DynamicResource ForegroundMutedBrush}"
                                               VerticalAlignment="Center" Margin="6,0,0,0" x:Name="CsvSeparatorHint"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock x:Name="TimeDisplayModeLabel" Text="Show timestamps in:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,0"/>
                                    <ComboBox AutomationProperties.LabeledBy="{Binding ElementName=TimeDisplayModeLabel}" x:Name="TimeDisplayModeCombo" Width="140" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Server Time" Tag="ServerTime"/>
                                        <ComboBoxItem Content="Local Time" Tag="LocalTime"/>
                                        <ComboBoxItem Content="UTC" Tag="UTC"/>
                                    </ComboBox>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock x:Name="ColorThemeLabel" Text="Color theme:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,0"/>
                                    <ComboBox AutomationProperties.LabeledBy="{Binding ElementName=ColorThemeLabel}" x:Name="ColorThemeCombo" Width="140" VerticalAlignment="Center"
                                              SelectionChanged="ColorThemeCombo_SelectionChanged">
                                        <ComboBoxItem Content="Dark" Tag="Dark"/>
                                        <ComboBoxItem Content="Light" Tag="Light"/>
                                        <ComboBoxItem Content="Cool Breeze" Tag="CoolBreeze"/>
                                    </ComboBox>
                                </WrapPanel>
                                <!-- #3577: the operator's own colors for the theme the combo shows. The shared panel
                                     (PerformanceMonitor.Ui.ThemeColorsPanel, one copy for Lite and the Darling viewer)
                                     follows the combo's live preview through ThemeManager.ThemeChanged, so it always edits
                                     the theme on screen. Collapsed by default: it is twelve rows, and most visits to this
                                     window are for something else. Its Apply writes theme-overrides.json and re-applies at
                                     once, independent of this window's Save - the theme combo is the setting this window
                                     saves; the colors are a file the panel owns. -->
                                <Expander Header="Colors" IsExpanded="False" Margin="0,10,0,0">
                                    <ui:ThemeColorsPanel Margin="0,8,0,0"/>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Application" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                <CheckBox x:Name="MinimizeToTrayCheckBox" Content="Minimize to system tray" Margin="0,8,0,0"
                                          Foreground="{DynamicResource ForegroundBrush}"/>
                                <!-- #2413: five seconds after every launch Lite called github.com looking for a new
                                     version, on by default, and the only way to refuse was to hand-edit a key that
                                     appeared in no window and no sample file. It sits beside Minimize to tray, ABOVE the
                                     Enable notifications master switch, because it is application behavior and not
                                     alerting. Turning alerts off must not gray this out or claim it depends on them. -->
                                <CheckBox x:Name="CheckForUpdatesOnStartupCheckBox" Content="Check GitHub for a new version at startup" Margin="0,8,0,0"
                                          Foreground="{DynamicResource ForegroundBrush}"
                                          ToolTip="Off = Lite never contacts github.com on its own. The sidebar's About button still checks when you open it, and installs in place from there."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

    <!-- Buttons -->
    <WrapPanel x:Name="FooterButtons" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12,16,16">
        <Button Content="_Save" Click="SaveButton_Click" Style="{DynamicResource AccentButton}" Margin="0,0,8,0"/>
        <Button Content="_Close" Click="CloseButton_Click" IsCancel="True"/>
    </WrapPanel>
    </Grid>
</Window>
