<Window x:Class="PerformanceMonitorLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PerformanceMonitorLite.Controls"
        xmlns:local="clr-namespace:PerformanceMonitorLite"
        xmlns:ui="clr-namespace:PerformanceMonitor.Ui;assembly=PerformanceMonitor.Ui"
        Title="Performance Monitor Lite"
        Height="700" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="EDD.ico"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

            <!-- Sidebar fleet-tree (#2020 2b-i-b): depth→indent + header/server row templates + selector -->
            <local:FleetDepthToIndentConverter x:Key="FleetDepthToIndent"/>

            <!-- Server row: the sidebar card, now indented under whichever group header precedes it. -->
            <DataTemplate x:Key="FleetServerRowTemplate">
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,6"
                        Background="{DynamicResource BackgroundLightBrush}"
                        Margin="{Binding Depth, Converter={StaticResource FleetDepthToIndent}}"
                        ContextMenuOpening="ServerRow_ContextMenuOpening">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="_Connect" Click="ServerContextMenu_Connect_Click">
                                <MenuItem.Icon><TextBlock Text="&#x1F517;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="_Disconnect" Click="ServerContextMenu_Disconnect_Click">
                                <MenuItem.Icon><TextBlock Text="&#x274C;"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="_Toggle Favorite" Click="ServerContextMenu_ToggleFavorite_Click">
                                <MenuItem.Icon><TextBlock Text="&#x2B50;"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <!-- Populated on open by ServerRow_ContextMenuOpening: one checkable item per tag. -->
                            <MenuItem Header="Assign Tags" Tag="AssignTags">
                                <MenuItem.Icon><TextBlock Text="&#x1F3F7;"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="_Edit..." Click="ServerContextMenu_Edit_Click">
                                <MenuItem.Icon><TextBlock Text="&#x270F;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="_Remove" Click="ServerContextMenu_Remove_Click">
                                <MenuItem.Icon><TextBlock Text="&#x1F5D1;"/></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Status dot (the CONNECTION check, not collection freshness — this label said
                             "collection freshness" until #2458, copied from the Darling viewer where it is
                             true; here IsOnline comes from ServerManager.GetConnectionStatus and the dot's
                             own tooltip now says so) + the muted-bell silence indicator (#2031: a silenced
                             server must not look healthy-quiet). -->
                        <StackPanel Grid.Column="0" Grid.RowSpan="2"
                                    Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- #2458: the dot renders the same ServerCardStatus the Overview card does, and
                                 carries the same first line the card's tooltip opens on. It was a coloured
                                 circle deriving its own copy of the four-word ladder, so the sidebar and the
                                 card could disagree about one server; and it is the thing a reader points at
                                 first, which is #2422's complaint one surface over. The tooltip also says what
                                 the dot is NOT about: #2457 kept collection freshness on its own banded row on
                                 the card, and this row has no such band. -->
                            <Ellipse Width="10" Height="10"
                                     Margin="0,0,8,0"
                                     ToolTip="{Binding Server.Connection.DotTooltip}"
                                     VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource ForegroundMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Server.Connection.DotStatus}" Value="Online">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Server.Connection.DotStatus}" Value="Offline">
                                                <Setter Property="Fill" Value="{DynamicResource ErrorBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Server.Connection.DotStatus}" Value="Warning">
                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <!-- A greyed vector bell with a slash (never an emoji), shown only while a
                                 whole-server alert silence is active. -->
                            <Viewbox Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"
                                     ToolTip="Alerts silenced for this server">
                                <Viewbox.Style>
                                    <Style TargetType="Viewbox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Server.Connection.IsSilenced}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Viewbox.Style>
                                <Grid Width="24" Height="24">
                                    <Path Fill="{DynamicResource ForegroundMutedBrush}"
                                          Data="M12,2 C10.9,2 10,2.9 10,4 L10,4.29 C7.12,5.14 5,7.83 5,11 L5,17 L3,19 L3,20 L21,20 L21,19 L19,17 L19,11 C19,7.83 16.88,5.14 14,4.29 L14,4 C14,2.9 13.1,2 12,2 Z M10,21 A2,2 0 0,0 14,21 Z"/>
                                    <Line X1="3" Y1="3" X2="21" Y2="21"
                                          Stroke="{DynamicResource ForegroundMutedBrush}" StrokeThickness="2.4"/>
                                </Grid>
                            </Viewbox>
                        </StackPanel>

                        <!-- Server Name -->
                        <TextBlock Grid.Column="1" Grid.Row="0"
                                   Text="{Binding Server.Connection.DisplayNameWithIntent}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"/>

                        <!-- Server Details -->
                        <TextBlock Grid.Column="1" Grid.Row="1"
                                   Text="{Binding Server.Connection.ServerNameDisplay}"
                                   FontSize="11"
                                   Foreground="{DynamicResource ForegroundMutedBrush}"/>

                        <!-- Favorite Star -->
                        <TextBlock Grid.Column="2" Grid.RowSpan="2"
                                   Text="★" FontSize="16"
                                   VerticalAlignment="Center"
                                   Foreground="#FFD700"
                                   Margin="4,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Server.Connection.IsFavorite}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- Group header: a tag, or the Favorites / Untagged pseudo-group. Click toggles expand/collapse. -->
            <DataTemplate x:Key="FleetHeaderRowTemplate">
                <Border Background="Transparent" Padding="0,1"
                        Margin="{Binding Depth, Converter={StaticResource FleetDepthToIndent}}"
                        ContextMenuOpening="TagHeader_ContextMenuOpening">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="New Tag..." Click="TagHeaderContextMenu_NewTag_Click">
                                <MenuItem.Icon><TextBlock Text="&#x2795;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="New Child Tag..." Tag="TagOnly" Click="TagHeaderContextMenu_NewChildTag_Click">
                                <MenuItem.Icon><TextBlock Text="&#x1F4C1;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Rename..." Tag="TagOnly" Click="TagHeaderContextMenu_Rename_Click">
                                <MenuItem.Icon><TextBlock Text="&#x270F;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Delete Tag" Tag="TagOnly" Click="TagHeaderContextMenu_Delete_Click">
                                <MenuItem.Icon><TextBlock Text="&#x1F5D1;"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Manage Tags..." Click="ManageTagsButton_Click">
                                <MenuItem.Icon><TextBlock Text="&#x1F3F7;"/></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <!-- Chevron: ▸ collapsed, ▾ expanded, blank when no children -->
                        <TextBlock Width="14" FontSize="9" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundMutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#x25B8;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <Setter Property="Text" Value="&#x25BE;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasChildren}" Value="False">
                                            <Setter Property="Text" Value=""/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                        <!-- "(n)" count badge, hidden when ServerCount == 0 -->
                        <TextBlock Text="{Binding ServerCount, StringFormat='({0})'}"
                                   FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundMutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ServerCount}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <local:FleetRowTemplateSelector x:Key="FleetRowSelector"
                                            ServerTemplate="{StaticResource FleetServerRowTemplate}"
                                            HeaderTemplate="{StaticResource FleetHeaderRowTemplate}"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid SizeChanged="RootGrid_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="280" MinWidth="40"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar - Server List -->
        <Border Grid.Column="0"
                Background="{DynamicResource BackgroundDarkBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Header -->
                <Border Grid.Row="0" Background="{DynamicResource BackgroundLightBrush}" Padding="12,10,12,8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="SidebarTitle" Text="SQL Servers" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock x:Name="SidebarSubtitle" Text="Double-click or press Enter to open a server tab" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="SidebarToggleButton" Content="«" Click="ToggleSidebar_Click"
                                    ToolTip="Toggle sidebar" VerticalAlignment="Top"
                                    Width="24" Height="24" Padding="0" FontSize="14"/>
                        </Grid>
                        <Grid x:Name="ServerSearchRow" Margin="0,8,0,0">
                            <TextBox x:Name="ServerSearchBox"
                                     AutomationProperties.Name="Search servers"
                                     TextChanged="ServerSearchBox_TextChanged"
                                     ToolTip="Filter the list by server name or tag"/>
                            <TextBlock Text="Search servers or tags…"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ServerSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Server List -->
                <!-- #2020 2b-i-b: a ListBox rendering the FleetView projection (group headers + servers)
                     via the template selector, replacing the flat ListView of ServerConnection rows. -->
                <ui:InvokableListBox Grid.Row="1" x:Name="ServerListView" ItemInvoked="ServerListView_ItemInvoked" AutomationProperties.AutomationId="ServerPicker"
                         SelectionMode="Single"
                         SelectionChanged="ServerListView_SelectionChanged"
                         MouseDoubleClick="ServerListView_MouseDoubleClick"
                         KeyDown="ServerListView_KeyDown"
                         Margin="8"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemTemplateSelector="{StaticResource FleetRowSelector}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName, Mode=OneTime}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ui:InvokableListBox>

                <!-- Sidebar Footer -->
                <Border Grid.Row="2" Padding="8,8" Background="{DynamicResource BackgroundLightBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <controls:SidebarFooter x:Name="Sidebar"
                                            AddServerClick="AddServerButton_Click"
                                            ManageServersClick="ManageServersButton_Click"
                                            InvestigationsClick="InvestigationsButton_Click"
                                            SettingsClick="SettingsButton_Click"
                                            AddMultipleServersClick="AddMultipleServersButton_Click"
                                            ManageTagsClick="ManageTagsButton_Click"
                                            ManageQueryTagsClick="ManageQueryTagsButton_Click"
                                            OpenPlanViewerClick="OpenPlanViewerButton_Click"
                                            ImportDataClick="ImportDataButton_Click"
                                            ImportSettingsClick="ImportSettingsButton_Click"
                                            ViewLogClick="ViewLogButton_Click"
                                            OpenLogFolderClick="OpenLogFolderButton_Click"
                                            AboutClick="AboutButton_Click"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header row removed — space reclaimed for content -->

            <!-- Content Area - Empty State or Server Tabs -->
            <Grid Grid.Row="1">
                <!-- Empty State -->
                <Border x:Name="EmptyStatePanel" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="No Servers Connected" FontSize="24" FontWeight="Light" Foreground="{DynamicResource ForegroundMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Add your first server to start collecting performance data" FontSize="14" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,8,0,24" HorizontalAlignment="Center"/>
                        <Button Content="+ Add Your First Server" Click="AddServerButton_Click" Padding="24,12" FontSize="14"/>
                    </StackPanel>
                </Border>

                <!-- Server Tab Control (hidden until servers are connected) -->
                <TabControl x:Name="ServerTabControl" Visibility="Collapsed" Background="Transparent" BorderThickness="0">
                    <TabItem Header="Overview" x:Name="OverviewTab">
                        <DockPanel LastChildFill="True">
                        <StackPanel x:Name="OverviewSortToolbar" DockPanel.Dock="Top" Orientation="Horizontal"
                                    Margin="14,10,14,0" Visibility="Collapsed">
                            <TextBlock Text="Sort:" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,8,0"/>
                            <ComboBox x:Name="OverviewSortCombo" Width="120" VerticalAlignment="Center"
                                      SelectionChanged="OverviewSortCombo_SelectionChanged">
                                <ComboBoxItem Content="CPU %" Tag="Cpu"/>
                                <ComboBoxItem Content="Name" Tag="Name"/>
                            </ComboBox>
                            <!-- Live name filter over the Overview cards; composes with the sort above. The
                                 hit-test-invisible watermark shows the placeholder while the box is empty. -->
                            <TextBlock Text="Search:" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundMutedBrush}" Margin="16,0,8,0"/>
                            <Grid Width="180" VerticalAlignment="Center">
                                <TextBox x:Name="OverviewSearchBox" TextChanged="OverviewSearchBox_TextChanged"
                                         ToolTip="Filter the Overview by server name or tag"/>
                                <TextBlock Text="server name / tag…" IsHitTestVisible="False"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=OverviewSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <!-- #5352: says so when the search above matched no card, instead of leaving a blank
                                 grid. The sentence is ServerOverviewFilter.NoMatchText, shared with the viewer. -->
                            <TextBlock x:Name="OverviewNoMatchText" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource ForegroundMutedBrush}" Visibility="Collapsed"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                            <ui:InvokableItemsControl x:Name="OverviewItemsControl" ItemInvoked="OverviewItemsControl_ItemInvoked">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:ServerOverviewCard MouseLeftButtonDown="OverviewCard_MouseLeftButtonDown"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ui:InvokableItemsControl>
                        </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Alert History" x:Name="AlertsTab">
                        <controls:AlertsHistoryTab x:Name="AlertsHistoryContent"/>
                    </TabItem>
                    <TabItem Header="Job History" x:Name="JobHistoryTabItem">
                        <controls:JobHistoryTab x:Name="JobHistoryContent"/>
                    </TabItem>
                    <!-- Availability Groups (#991): collapsed until a load finds AG rows. Always On is opt-in,
                         so most installs would otherwise carry a permanently empty tab. -->
                    <TabItem Header="Availability Groups" x:Name="AvailabilityGroupsTabItem" Visibility="Collapsed">
                        <controls:AvailabilityGroupsTab x:Name="AvailabilityGroupsContent"/>
                    </TabItem>
                    <TabItem Header="FinOps" x:Name="FinOpsTab">
                        <controls:FinOpsTab x:Name="FinOpsContent"/>
                    </TabItem>
                    <TabItem Header="Recommendations" x:Name="RecommendationsTab">
                        <controls:RecommendationsTab x:Name="RecommendationsContent"/>
                    </TabItem>
                    <TabItem x:Name="MainWindowPlanViewerTab" Visibility="Collapsed">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <!-- #4678: shadow the app-level TextBlock style so the label inherits the TabItem Foreground (AccentForegroundBrush when selected). -->
                                <StackPanel.Resources><Style TargetType="TextBlock"/></StackPanel.Resources>
                                <TextBlock Text="Plan Viewer" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <Button Style="{DynamicResource TabCloseButton}"
                                        Click="MainWindowPlanViewerClose_Click"
                                        Margin="4,0,0,0"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid AllowDrop="True" PreviewDrop="MainWindowPlanViewer_Drop"
                              PreviewDragOver="MainWindowPlanViewer_DragOver"
                              Background="Transparent"
                              Focusable="True" KeyDown="MainWindowPlanViewer_KeyDown">
                            <TabControl x:Name="MainWindowPlanTabControl"
                                        Background="Transparent"
                                        BorderThickness="0"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="{DynamicResource BackgroundLightBrush}" Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" x:Name="StatusText" Text="Ready" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <!-- Lite's own database after a fatal error: why collection stopped, or when it was reopened. -->
                    <TextBlock Grid.Column="1" x:Name="LocalDatabaseStatusText" Text="" Visibility="Collapsed" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="CollectorHealthText" Text="" Foreground="{DynamicResource ForegroundBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" x:Name="DatabaseSizeText" Text="Database: --" Foreground="{DynamicResource ForegroundBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" x:Name="CollectionStatusText" Text="Collection: Stopped" Foreground="{DynamicResource ForegroundBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" x:Name="ServerCountText" Margin="12,0,0,0" Text="Servers: 0" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
