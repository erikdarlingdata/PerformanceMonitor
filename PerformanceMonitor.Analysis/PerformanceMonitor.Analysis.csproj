<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>PerformanceMonitor.Analysis</RootNamespace>
    <AssemblyName>PerformanceMonitor.Analysis</AssemblyName>
    <Company>Darling Data, LLC</Company>
    <Copyright>Copyright © 2026 Darling Data, LLC</Copyright>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- #5758: the statement-identity rule for an unknown query hash (QueryHashIdentity) has one definition, in Common.
         Common references no project, so this edge cannot make a cycle. -->
    <ProjectReference Include="..\PerformanceMonitor.Common\PerformanceMonitor.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PerformanceMonitorLite" />
    <InternalsVisibleTo Include="Lite.Tests" />
    <!-- Darling's PgFactCollector reconstructs blocking chains through the same internal
         BlockingPairRow/BlockingChainReconstructor/BlockingPairRowMerge seam both apps use. -->
    <InternalsVisibleTo Include="PerformanceMonitor.Darling.Analysis" />
    <!-- The Darling viewer's Blocking tab reconstructs the block-chain the same way Lite does: it fetches
         internal BlockingPairRow rows, calls BlockingChainReconstructor, and hands the internal reconstruction
         to BlockingChainViewerProjection.BuildModelForSession, which is internal too. -->
    <InternalsVisibleTo Include="PerformanceMonitor.Darling.Viewer" />
    <!-- #3653 A8 slice 1: Darling.Tests pins AnomalyThresholds.NAwarePeakCutoff / InverseNormalCdf directly,
         both internal, before trusting AnomalyGate on top of them. -->
    <InternalsVisibleTo Include="Darling.Tests" />
  </ItemGroup>
</Project>
