<Project>
  <!--
    #9261: the one build the pull-request CI build job runs for both test projects (pr.yml, "Build the test projects").
    Darling.Tests and Lite.Tests share several libraries, so two separate dotnet build processes would each build those
    libraries and could write the same files at once (MSB3026, MSB3027). One MSBuild process builds each project once and
    runs the two test projects' own chains side by side. The projects build exactly as they do alone: this file passes no
    property and sets no output path, and it has no SDK, so no props file of the repository applies to it. The
    configuration and the other options come from the command line (the Release configuration and no restore) and reach each project as global
    properties.
  -->
  <ItemGroup>
    <TestProject Include="$(MSBuildThisFileDirectory)..\Darling\Darling.Tests\Darling.Tests.csproj" />
    <TestProject Include="$(MSBuildThisFileDirectory)..\Lite.Tests\Lite.Tests.csproj" />
  </ItemGroup>

  <Target Name="Build">
    <MSBuild Projects="@(TestProject)" Targets="Build" BuildInParallel="true" />
  </Target>
</Project>
